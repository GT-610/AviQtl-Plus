import { Button, CheckBox, ComboBox, GroupBox, LineEdit, ProgressIndicator, RadioGroup, ScrollView, Slider, SpinBox, TextEdit } from "std-widgets.slint";

export struct ProjectTabData {
    name: string,
    dirty: bool,
}

export struct RecoveryEntryData {
    id: string,
    name: string,
    saved-at: string,
    original-project-url: string,
    valid: bool,
    error: string,
}

export struct SceneTabData {
    id: int,
    name: string,
    selected: bool,
    root: bool,
}

export struct TimelineClipData {
    id: int,
    label: string,
    start: int,
    duration: int,
    layer: int,
    selected: bool,
    primary: bool,
}

export struct LayerData {
    index: int,
    visible: bool,
    locked: bool,
    selected: bool,
}

export struct TimelineViewportData {
    pixels-per-frame: float,
    viewport-x: float,
    viewport-y: float,
}

export struct ObjectEffectData {
    index: int,
    id: string,
    name: string,
    enabled: bool,
    selected: bool,
    removable: bool,
}

export struct EffectCatalogItemData {
    id: string,
    name: string,
    categories: string,
}

export struct ObjectSettingRowData {
    row-kind: string,
    source-kind: string,
    effect-index: int,
    param-name: string,
    label: string,
    effect-enabled: bool,
    selected: bool,
    removable: bool,
    interactive: bool,
    checked: bool,
    keyframed: bool,
    number-value: float,
    minimum: float,
    maximum: float,
    step: float,
    text-value: string,
    unit: string,
    option-labels: [string],
    selected-option: int,
}

component CommitLineEdit inherits LineEdit {
    in property <string> source-text;
    callback commit(string);
    text: root.source-text;
    accepted(value) => {
        if value != root.source-text {
            root.commit(value);
        }
        self.text = root.source-text;
        self.clear-focus();
    }
    changed has-focus => {
        if !self.has-focus && self.text != root.source-text {
            root.commit(self.text);
        }
    }
    changed source-text => {
        if !self.has-focus && self.text != root.source-text {
            self.text = root.source-text;
        }
    }
}

component CommitTextEdit inherits TextEdit {
    in property <string> source-text;
    callback commit(string);
    text: root.source-text;
    changed has-focus => {
        if !self.has-focus && self.text != root.source-text {
            root.commit(self.text);
        }
    }
    changed source-text => {
        if !self.has-focus && self.text != root.source-text {
            self.text = root.source-text;
        }
    }
}

component EffectSidebarEntry inherits Rectangle {
    in property <ObjectEffectData> effect;
    callback activate(int, bool, bool);
    callback context-activate(int);
    callback remove(int);
    callback reorder(int, float);
    callback save-preset(int, string);
    callback load-preset(int, string);
    callback delete-preset(int, string);
    callback query-presets(int) -> [string];
    in-out property <[string]> preset-names;
    private property <bool> drag-active: false;
    private property <bool> drag-threshold-crossed: false;
    private property <length> drag-y: 0px;
    height: 34px;
    background: root.effect.selected ? #405f8b : effect-touch.has-hover ? #343a45 : transparent;
    border-width: root.effect.selected ? 1px : 0px;
    border-color: #759bd2;

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 5px;
        spacing: 6px;
        Text {
            text: "☷";
            color: #9ea4ae;
            vertical-alignment: center;
        }
        Text {
            text: root.effect.enabled ? "●" : "○";
            color: root.effect.enabled ? #8fcf94 : #8b8f98;
            vertical-alignment: center;
        }
        Text {
            text: root.effect.name;
            color: #f1f2f4;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
    effect-menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: "削除";
                enabled: root.effect.removable;
                activated => { root.remove(root.effect.index); }
            }
            MenuSeparator { }
            MenuItem {
                title: "プリセットを保存...";
                activated => { root.save-preset(root.effect.index, root.effect.name); }
            }
            Menu {
                title: "プリセットを読み込み";
                enabled: root.preset-names.length > 0;
                for preset in root.preset-names : MenuItem {
                    title: preset;
                    activated => { root.load-preset(root.effect.index, preset); }
                }
            }
            Menu {
                title: "プリセットを削除";
                enabled: root.preset-names.length > 0;
                for preset in root.preset-names : MenuItem {
                    title: preset;
                    activated => { root.delete-preset(root.effect.index, preset); }
                }
            }
        }
        effect-touch := TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.activate(
                        root.effect.index,
                        event.modifiers.control || event.modifiers.meta,
                        event.modifiers.shift
                    );
                }
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    root.context-activate(root.effect.index);
                    root.preset-names = root.query-presets(root.effect.index);
                    effect-menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
        }
    }
    drag-touch := TouchArea {
        width: 27px;
        mouse-cursor: move;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag-active = true;
                root.drag-threshold-crossed = false;
                root.drag-y = 0px;
            }
            if event.kind == PointerEventKind.move && root.drag-active {
                root.drag-y = self.mouse-y - self.pressed-y;
                if abs(root.drag-y) >= 3px {
                    root.drag-threshold-crossed = true;
                }
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.drag-active {
                if root.drag-threshold-crossed {
                    root.reorder(root.effect.index, root.drag-y / 1px);
                }
                root.drag-active = false;
                root.drag-threshold-crossed = false;
                root.drag-y = 0px;
            }
            if event.kind == PointerEventKind.cancel {
                root.drag-active = false;
                root.drag-threshold-crossed = false;
                root.drag-y = 0px;
            }
        }
    }
}

component ObjectSettingRow inherits Rectangle {
    in property <ObjectSettingRowData> row-data;
    callback activate-effect(int);
    callback set-effect-enabled(int, bool);
    callback remove-effect(int);
    callback set-text(int, string, string);
    callback set-number(int, string, float);
    callback set-bool(int, string, bool);
    callback set-option(int, string, int);
    height: root.row-data.row-kind == "effect" ? 42px
        : root.row-data.row-kind == "header" ? 36px
        : root.row-data.row-kind == "text" ? 90px
        : 44px;
    background: root.row-data.row-kind == "effect"
        ? (root.row-data.selected ? #304a6d : #2d323b)
        : transparent;
    border-width: root.row-data.row-kind == "effect" ? 1px : 0px;
    border-color: root.row-data.selected ? #7099d1 : #4b515d;

    if root.row-data.row-kind == "effect" : Rectangle {
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 6px;
            spacing: 7px;
            CheckBox {
                checked: root.row-data.effect-enabled;
                accessible-label: root.row-data.label + "を有効にする";
                toggled => { root.set-effect-enabled(root.row-data.effect-index, self.checked); }
            }
            Text {
                text: root.row-data.label;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Button {
                text: "削除";
                visible: root.row-data.removable;
                enabled: root.row-data.removable;
                clicked => { root.remove-effect(root.row-data.effect-index); }
            }
        }
        TouchArea {
            x: 32px;
            width: max(parent.width - 90px, 1px);
            mouse-cursor: pointer;
            clicked => { root.activate-effect(root.row-data.effect-index); }
        }
    }

    if root.row-data.row-kind == "header" : HorizontalLayout {
        padding-left: 5px;
        padding-top: 7px;
        Text {
            text: root.row-data.label;
            font-weight: 700;
            color: #b9c9df;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; height: 1px; background: #4b515d; }
    }

    if root.row-data.row-kind == "boolean" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        CheckBox {
            text: root.row-data.label;
            checked: root.row-data.checked;
            enabled: root.row-data.interactive;
            toggled => { root.set-bool(root.row-data.effect-index, root.row-data.param-name, self.checked); }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.row-data.keyframed : Text { text: "KF"; color: #d9af5f; vertical-alignment: center; }
    }

    if root.row-data.row-kind == "number" && root.row-data.source-kind == "slider" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        Text { text: root.row-data.label; width: 105px; overflow: elide; vertical-alignment: center; }
        Slider {
            horizontal-stretch: 1;
            value: root.row-data.number-value;
            minimum: root.row-data.minimum;
            maximum: root.row-data.maximum;
            step: root.row-data.step;
            enabled: root.row-data.interactive;
            changed(value) => { root.set-number(root.row-data.effect-index, root.row-data.param-name, value); }
        }
        CommitLineEdit {
            width: 76px;
            source-text: root.row-data.text-value;
            enabled: root.row-data.interactive;
            horizontal-alignment: right;
            commit(value) => { root.set-text(root.row-data.effect-index, root.row-data.param-name, value); }
        }
        Text { text: root.row-data.unit; visible: root.row-data.unit != ""; vertical-alignment: center; }
        if root.row-data.keyframed : Text { text: "KF"; color: #d9af5f; vertical-alignment: center; }
    }

    if root.row-data.row-kind == "number" && root.row-data.source-kind != "slider" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        Text { text: root.row-data.label; width: 135px; overflow: elide; vertical-alignment: center; }
        CommitLineEdit {
            width: 120px;
            source-text: root.row-data.text-value;
            enabled: root.row-data.interactive;
            horizontal-alignment: right;
            commit(value) => { root.set-text(root.row-data.effect-index, root.row-data.param-name, value); }
        }
        Text { text: root.row-data.unit; visible: root.row-data.unit != ""; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        if root.row-data.keyframed : Text { text: "KF"; color: #d9af5f; vertical-alignment: center; }
    }

    if root.row-data.row-kind == "integer" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        Text { text: root.row-data.label; width: 135px; overflow: elide; vertical-alignment: center; }
        CommitLineEdit {
            width: 120px;
            source-text: root.row-data.text-value;
            enabled: root.row-data.interactive;
            horizontal-alignment: right;
            commit(value) => { root.set-text(root.row-data.effect-index, root.row-data.param-name, value); }
        }
        Text { text: root.row-data.unit; visible: root.row-data.unit != ""; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        if root.row-data.keyframed : Text { text: "KF"; color: #d9af5f; vertical-alignment: center; }
    }

    if root.row-data.row-kind == "choice" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        Text { text: root.row-data.label; width: 135px; overflow: elide; vertical-alignment: center; }
        ComboBox {
            width: 220px;
            model: root.row-data.option-labels;
            current-index: root.row-data.selected-option;
            enabled: root.row-data.interactive;
            selected(value) => { root.set-option(root.row-data.effect-index, root.row-data.param-name, self.current-index); }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.row-data.keyframed : Text { text: "KF"; color: #d9af5f; vertical-alignment: center; }
    }

    if root.row-data.row-kind == "text" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        Text { text: root.row-data.label; width: 105px; overflow: elide; vertical-alignment: top; }
        CommitTextEdit {
            horizontal-stretch: 1;
            source-text: root.row-data.text-value;
            enabled: root.row-data.interactive;
            commit(value) => { root.set-text(root.row-data.effect-index, root.row-data.param-name, value); }
        }
        if root.row-data.keyframed : Text { text: "KF"; color: #d9af5f; vertical-alignment: top; }
    }

    if root.row-data.row-kind == "path" || root.row-data.row-kind == "color" || root.row-data.row-kind == "font" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        Text { text: root.row-data.label; width: 105px; overflow: elide; vertical-alignment: center; }
        CommitLineEdit {
            horizontal-stretch: 1;
            source-text: root.row-data.text-value;
            enabled: root.row-data.interactive;
            commit(value) => { root.set-text(root.row-data.effect-index, root.row-data.param-name, value); }
        }
        if root.row-data.keyframed : Text { text: "KF"; color: #d9af5f; vertical-alignment: center; }
    }

    if root.row-data.row-kind == "unsupported" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        Text { text: root.row-data.label; width: 135px; overflow: elide; vertical-alignment: center; }
        Text { text: root.row-data.text-value; color: #9ea4ae; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
    }
}

component SceneTab inherits Rectangle {
    in property <SceneTabData> scene;
    callback activate(int);
    callback close(int);
    callback settings(int);
    preferred-width: 140px;
    min-width: 100px;
    height: 28px;
    background: root.scene.selected ? #4772b3 : scene-touch.has-hover ? #3a3f49 : #292d35;
    border-width: root.scene.selected ? 1px : 0px;
    border-color: #7aa2df;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 4px;
        Text {
            text: root.scene.name;
            color: #f4f5f7;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if !root.scene.root : Button {
            text: "×";
            width: 24px;
            accessible-label: "シーンを閉じる";
            clicked => { root.close(root.scene.id); }
        }
    }
    scene-touch := TouchArea {
        width: root.scene.root ? parent.width : parent.width - 28px;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.activate(root.scene.id);
            }
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.settings(root.scene.id);
            }
        }
    }
}

component LayerHeaderItem inherits Rectangle {
    in property <LayerData> layer;
    callback activate(int);
    callback command(string, int);
    callback scroll-requested(length) -> bool;
    height: 30px;
    background: root.layer.selected ? #3d526f : header-touch.has-hover ? #353a44 : #2a2e36;
    border-width: 0px;

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        spacing: 4px;
        Text {
            text: root.layer.visible ? "●" : "○";
            color: root.layer.visible ? #8fcf94 : #8b8f98;
            vertical-alignment: center;
        }
        Text {
            text: root.layer.index + 1;
            color: #f1f2f4;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.layer.locked ? "L" : "";
            color: #e2ba68;
            vertical-alignment: center;
        }
    }
    layer-menu := ContextMenuArea {
        Menu {
            MenuItem { title: "上にレイヤーを挿入"; activated => { root.command("insert-above", root.layer.index); } }
            MenuItem { title: "下にレイヤーを挿入"; activated => { root.command("insert-below", root.layer.index); } }
            MenuSeparator { }
            MenuItem { title: root.layer.locked ? "レイヤーのロックを解除" : "レイヤーをロック"; activated => { root.command("toggle-lock", root.layer.index); } }
            MenuItem { title: root.layer.visible ? "レイヤーを非表示" : "レイヤーを表示"; activated => { root.command("toggle-visible", root.layer.index); } }
            MenuSeparator { }
            MenuItem { title: "すべてのレイヤーを表示"; activated => { root.command("show-all", root.layer.index); } }
            MenuItem { title: "すべてのレイヤーを非表示"; activated => { root.command("hide-all", root.layer.index); } }
        }
        header-touch := TouchArea {
            mouse-cursor: pointer;
            scroll-event(event) => {
                if root.scroll-requested(event.delta-y) { accept } else { reject }
            }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.activate(root.layer.index);
                }
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    layer-menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: #454a55;
    }
}

component TimelineClipItem inherits Rectangle {
    in property <TimelineClipData> clip-data;
    callback activate(int, bool);
    callback prepare-drag(int, bool);
    callback context-activate(int);
    callback open-settings(int);
    callback command(string, int);
    callback drag-finished(string, int, float, float, bool);
    callback pointer-hovered(float, float, bool);
    callback pointer-left();
    callback scroll-requested(length, length, length, bool, bool, bool) -> bool;
    private property <string> active-drag: "";
    private property <length> drag-x: 0px;
    private property <length> drag-y: 0px;
    private property <bool> threshold-crossed: false;
    private property <bool> drag-additive: false;
    min-width: 8px;
    height: 24px;
    background: transparent;

    clip-visual := Rectangle {
        x: root.active-drag == "move" ? root.drag-x : root.active-drag == "trim-start" ? root.drag-x : 0px;
        y: root.active-drag == "move" ? root.drag-y : 0px;
        width: root.active-drag == "trim-start"
            ? max(root.width - root.drag-x, 8px)
            : root.active-drag == "trim-end"
                ? max(root.width + root.drag-x, 8px)
                : root.width;
        height: root.height;
        border-radius: 2px;
        background: root.clip-data.primary ? #4f86d5 : root.clip-data.selected ? #668dca : clip-touch.has-hover ? #7197cf : #6081b1;
        border-width: root.clip-data.primary ? 2px : root.clip-data.selected ? 1px : 0px;
        border-color: #b9d4ff;
        HorizontalLayout {
            padding-left: 7px;
            padding-right: 7px;
            Text {
                text: root.clip-data.label;
                color: white;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
    clip-menu := ContextMenuArea {
        Menu {
            MenuItem { title: "削除"; activated => { root.command("delete", root.clip-data.id); } }
            MenuItem { title: "分割"; activated => { root.command("split", root.clip-data.id); } }
            MenuItem { title: "複製"; activated => { root.command("duplicate", root.clip-data.id); } }
            MenuSeparator { }
            MenuItem { title: "切り取り"; activated => { root.command("cut", root.clip-data.id); } }
            MenuItem { title: "コピー"; activated => { root.command("copy", root.clip-data.id); } }
            MenuSeparator { }
            MenuItem { title: "上のオブジェクトでクリッピング"; activated => { root.command("clipping", root.clip-data.id); } }
            MenuItem { title: "フィルタ効果を追加"; activated => { root.command("add-effect", root.clip-data.id); } }
        }
        clip-touch := TouchArea {
            x: min(7px, parent.width / 2);
            width: max(parent.width - 14px, 1px);
            mouse-cursor: move;
            scroll-event(event) => {
                if root.scroll-requested(
                    event.delta-x,
                    event.delta-y,
                    root.x + self.mouse-x,
                    event.modifiers.alt,
                    event.modifiers.control,
                    event.modifiers.shift
                ) { accept } else { reject }
            }
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.pointer-hovered(
                        (root.x + self.mouse-x) / 1px,
                        (root.y + self.mouse-y) / 1px,
                        event.modifiers.shift
                    );
                }
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.active-drag = "move";
                    root.drag-x = 0px;
                    root.drag-y = 0px;
                    root.threshold-crossed = false;
                    root.drag-additive = event.modifiers.control || event.modifiers.meta;
                }
                if event.kind == PointerEventKind.move && root.active-drag == "move" {
                    root.drag-x = self.mouse-x - self.pressed-x;
                    root.drag-y = self.mouse-y - self.pressed-y;
                    if !root.threshold-crossed && (abs(root.drag-x) >= 3px || abs(root.drag-y) >= 3px) {
                        root.threshold-crossed = true;
                        root.prepare-drag(root.clip-data.id, root.drag-additive);
                    }
                }
                if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.active-drag == "move" {
                    if root.threshold-crossed {
                        root.drag-finished("move", root.clip-data.id, root.drag-x / 1px, root.drag-y / 1px, event.modifiers.shift);
                    } else {
                        root.activate(root.clip-data.id, root.drag-additive);
                    }
                    root.active-drag = "";
                    root.drag-x = 0px;
                    root.drag-y = 0px;
                    root.threshold-crossed = false;
                    root.drag-additive = false;
                }
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    root.context-activate(root.clip-data.id);
                    clip-menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
                if event.kind == PointerEventKind.cancel {
                    root.active-drag = "";
                    root.drag-x = 0px;
                    root.drag-y = 0px;
                    root.threshold-crossed = false;
                    root.drag-additive = false;
                }
            }
            changed has-hover => { if !self.has-hover { root.pointer-left(); } }
            double-clicked => { root.open-settings(root.clip-data.id); }
        }
    }
    trim-start-touch := TouchArea {
        x: 0px;
        width: min(7px, parent.width / 2);
        mouse-cursor: ew-resize;
        scroll-event(event) => {
            if root.scroll-requested(
                event.delta-x,
                event.delta-y,
                root.x + self.mouse-x,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.shift
            ) { accept } else { reject }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.pointer-hovered(
                    (root.x + self.mouse-x) / 1px,
                    (root.y + self.mouse-y) / 1px,
                    event.modifiers.shift
                );
            }
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.active-drag = "trim-start";
                root.drag-x = 0px;
                root.drag-y = 0px;
                root.threshold-crossed = true;
                root.prepare-drag(root.clip-data.id, event.modifiers.control || event.modifiers.meta);
            }
            if event.kind == PointerEventKind.move && root.active-drag == "trim-start" {
                root.drag-x = self.mouse-x - self.pressed-x;
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.active-drag == "trim-start" {
                root.drag-finished("trim-start", root.clip-data.id, root.drag-x / 1px, 0, event.modifiers.shift);
                root.active-drag = "";
                root.drag-x = 0px;
                root.threshold-crossed = false;
            }
            if event.kind == PointerEventKind.cancel {
                root.active-drag = "";
                root.drag-x = 0px;
                root.threshold-crossed = false;
            }
        }
        changed has-hover => { if !self.has-hover { root.pointer-left(); } }
    }
    trim-end-touch := TouchArea {
        x: parent.width - self.width;
        width: min(7px, parent.width / 2);
        mouse-cursor: ew-resize;
        scroll-event(event) => {
            if root.scroll-requested(
                event.delta-x,
                event.delta-y,
                root.x + self.mouse-x,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.shift
            ) { accept } else { reject }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.pointer-hovered(
                    (root.x + self.mouse-x) / 1px,
                    (root.y + self.mouse-y) / 1px,
                    event.modifiers.shift
                );
            }
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.active-drag = "trim-end";
                root.drag-x = 0px;
                root.drag-y = 0px;
                root.threshold-crossed = true;
                root.prepare-drag(root.clip-data.id, event.modifiers.control || event.modifiers.meta);
            }
            if event.kind == PointerEventKind.move && root.active-drag == "trim-end" {
                root.drag-x = self.mouse-x - self.pressed-x;
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.active-drag == "trim-end" {
                root.drag-finished("trim-end", root.clip-data.id, root.drag-x / 1px, 0, event.modifiers.shift);
                root.active-drag = "";
                root.drag-x = 0px;
                root.threshold-crossed = false;
            }
            if event.kind == PointerEventKind.cancel {
                root.active-drag = "";
                root.drag-x = 0px;
                root.threshold-crossed = false;
            }
        }
        changed has-hover => { if !self.has-hover { root.pointer-left(); } }
    }
}

component ProjectTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activate();
    callback close();
    preferred-width: 150px;
    min-width: 110px;
    height: 28px;
    background: root.selected ? #4772b3 : tab-touch.has-hover ? #3a3f49 : #292d35;
    border-width: root.selected ? 1px : 0px;
    border-color: #7aa2df;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 4px;
        Text {
            text: root.label;
            color: #f4f5f7;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        close-button := Button {
            text: "×";
            width: 24px;
            accessible-label: "プロジェクトを閉じる";
            clicked => { root.close(); }
        }
    }
    tab-touch := TouchArea {
        width: parent.width - close-button.width - 4px;
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }
}

export component ProjectRecoveryWindow inherits Window {
    title: "Recover unsaved projects";
    preferred-width: 660px;
    preferred-height: 440px;
    min-width: 520px;
    min-height: 320px;
    background: #20232a;

    in property <[RecoveryEntryData]> recoveries;
    in-out property <string> error-message: "";
    in-out property <bool> discard-confirmation-visible: false;
    private property <string> pending-discard-id: "";
    private property <string> pending-discard-name: "";
    callback recover-project(string);
    callback discard-recovery(string);
    callback close-window();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "AviQtl found recovery snapshots left by an interrupted session. Recovering opens a new unsaved project and never overwrites the original file.";
            color: #e5e7eb;
            wrap: word-wrap;
        }
        if root.error-message != "" : Text {
            text: root.error-message;
            color: #f2c078;
            font-weight: 700;
            wrap: word-wrap;
        }
        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            viewport-height: recovery-list.preferred-height;

            recovery-list := VerticalLayout {
                width: parent.width;
                spacing: 8px;

                for recovery in root.recoveries : Rectangle {
                    height: 92px;
                    background: #2b2f38;
                    border-width: 1px;
                    border-color: #555b68;
                    border-radius: 4px;

                    HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;

                        VerticalLayout {
                            spacing: 3px;
                            horizontal-stretch: 1;
                            Text {
                                text: recovery.name;
                                color: #f2f3f5;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: recovery.valid ? "Saved " + recovery.saved-at : "Invalid recovery: " + recovery.error;
                                color: recovery.valid ? #b8bdc7 : #f2c078;
                                overflow: elide;
                            }
                            Text {
                                text: recovery.original-project-url;
                                visible: recovery.original-project-url != "";
                                color: #9298a3;
                                font-size: 0.72rem;
                                overflow: elide;
                            }
                        }
                        Button {
                            text: "Recover";
                            enabled: recovery.valid;
                            clicked => {
                                root.error-message = "";
                                root.recover-project(recovery.id);
                            }
                        }
                        Button {
                            text: "Discard";
                            clicked => {
                                root.pending-discard-id = recovery.id;
                                root.pending-discard-name = recovery.name;
                                root.discard-confirmation-visible = true;
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: "Close";
                clicked => { root.close-window(); }
            }
        }
    }

    if root.discard-confirmation-visible : Rectangle {
        z: 1000;
        width: 100%;
        height: 100%;
        background: #00000088;

        TouchArea { }

        Rectangle {
            width: min(parent.width - 32px, 470px);
            height: 160px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #2b2f38;
            border-width: 1px;
            border-color: #555b68;
            border-radius: 6px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: "Discard recovery snapshot";
                    color: #f2f3f5;
                    font-size: 1.15rem;
                    font-weight: 700;
                }
                Text {
                    text: "Discard the recovery snapshot for “" + root.pending-discard-name + "”? This cannot be undone.";
                    color: #d6d9df;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Yes";
                        clicked => {
                            root.discard-recovery(root.pending-discard-id);
                            root.pending-discard-id = "";
                            root.pending-discard-name = "";
                            root.discard-confirmation-visible = false;
                        }
                    }
                    Button {
                        text: "No";
                        clicked => {
                            root.pending-discard-id = "";
                            root.pending-discard-name = "";
                            root.discard-confirmation-visible = false;
                        }
                    }
                }
            }
        }
    }
}

export component ProjectLauncherWindow inherits Window {
    title: "AviQtl Plus - プロジェクトランチャー";
    preferred-width: 700px;
    preferred-height: 500px;
    min-width: 620px;
    min-height: 420px;

    in-out property <string> default-width: "1920";
    in-out property <string> default-height: "1080";
    in-out property <string> default-fps: "60";
    in-out property <string> default-sample-rate: "48000";
    callback create-project(string, string, string, string);
    callback open-project();

    HorizontalLayout {
        padding: 20px;
        spacing: 20px;

        VerticalLayout {
            preferred-width: 300px;
            spacing: 15px;
            Text { text: "新規プロジェクト"; font-size: 1.35rem; font-weight: 700; }
            GroupBox {
                title: "プロジェクト設定";
                GridLayout {
                    padding: 10px;
                    spacing: 10px;
                    Row { Text { text: "幅 (横):"; } width-field := LineEdit { text <=> root.default-width; } }
                    Row { Text { text: "高さ (縦):"; } height-field := LineEdit { text <=> root.default-height; } }
                    Row { Text { text: "フレームレート (FPS):"; } fps-field := LineEdit { text <=> root.default-fps; } }
                    Row { Text { text: "サンプリングレート:"; } sample-rate-field := LineEdit { text <=> root.default-sample-rate; } }
                }
            }
            create-button := Button {
                text: "新規プロジェクトを作成";
                accessible-label: "新規プロジェクトを作成";
                clicked => {
                    root.create-project(width-field.text, height-field.text, fps-field.text, sample-rate-field.text);
                }
            }
            Rectangle { vertical-stretch: 1; }
        }

        VerticalLayout {
            spacing: 15px;
            Text { text: "最近使ったプロジェクト"; font-size: 1.35rem; font-weight: 700; }
            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: #696d75;
                Text {
                    text: "最近使ったプロジェクトはありません";
                    opacity: 0.65;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Button {
                text: "既存プロジェクトを開く...";
                clicked => { root.open-project(); }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "AviQtl Plus - プレビュー";
    preferred-width: 640px;
    preferred-height: 360px;
    min-width: 480px;
    min-height: 300px;
    background: #181a20;
    forward-focus: main-shortcuts;

    in property <[ProjectTabData]> project-tabs;
    in property <int> current-project: -1;
    in property <image> preview-image;
    in-out property <float> playhead: 0;
    in property <float> duration: 3600;
    in property <bool> playing: false;
    in property <string> status-text: "Ready";
    in property <bool> save-confirmation-visible: false;
    in property <string> save-confirmation-project: "";

    callback new-project();
    callback open-project();
    callback save-project();
    callback save-project-as();
    callback export-media();
    callback quit-requested();
    callback undo();
    callback redo();
    callback show-project-settings();
    callback show-system-settings();
    callback show-timeline();
    callback show-object-settings();
    callback show-package-manager();
    callback show-about();
    callback select-project(int);
    callback close-project(int);
    callback confirm-save();
    callback confirm-discard();
    callback confirm-cancel();
    callback seek(float);
    callback previous-frame();
    callback toggle-playback();
    callback next-frame();
    callback keyboard-shortcut(string, bool, bool, bool, bool) -> bool;

    MenuBar {
        Menu {
            title: "ファイル";
            MenuItem { title: "新規プロジェクト"; enabled: !root.save-confirmation-visible; activated => { root.new-project(); } }
            MenuItem { title: "プロジェクトを開く"; enabled: !root.save-confirmation-visible; activated => { root.open-project(); } }
            MenuSeparator { }
            MenuItem { title: "プロジェクトの上書き保存"; enabled: !root.save-confirmation-visible; activated => { root.save-project(); } }
            MenuItem { title: "プロジェクトを名前を付けて保存..."; enabled: !root.save-confirmation-visible; activated => { root.save-project-as(); } }
            MenuSeparator { }
            MenuItem { title: "メディアの書き出し..."; enabled: !root.save-confirmation-visible; activated => { root.export-media(); } }
            MenuSeparator { }
            MenuItem { title: "終了"; enabled: !root.save-confirmation-visible; activated => { root.quit-requested(); } }
        }
        Menu {
            title: "編集";
            MenuItem { title: "元に戻す"; enabled: !root.save-confirmation-visible; activated => { root.undo(); } }
            MenuItem { title: "やり直す"; enabled: !root.save-confirmation-visible; activated => { root.redo(); } }
        }
        Menu {
            title: "設定";
            MenuItem { title: "プロジェクト設定"; enabled: !root.save-confirmation-visible; activated => { root.show-project-settings(); } }
            MenuSeparator { }
            MenuItem { title: "環境設定"; enabled: !root.save-confirmation-visible; activated => { root.show-system-settings(); } }
        }
        Menu {
            title: "表示";
            MenuItem { title: "タイムラインの表示"; enabled: !root.save-confirmation-visible; activated => { root.show-timeline(); } }
            MenuItem { title: "設定ダイアログの表示"; enabled: !root.save-confirmation-visible; activated => { root.show-object-settings(); } }
        }
        Menu {
            title: "ツール";
            MenuItem { title: "パッケージマネージャー"; enabled: !root.save-confirmation-visible; activated => { root.show-package-manager(); } }
            MenuSeparator { }
            MenuItem { title: "バージョン情報"; enabled: !root.save-confirmation-visible; activated => { root.show-about(); } }
        }
    }

    main-shortcuts := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if !root.save-confirmation-visible && root.keyboard-shortcut(
                event.text,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.meta
            ) {
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            spacing: 0px;
            Rectangle {
            height: 28px;
            background: #23262d;
            HorizontalLayout {
                spacing: 0px;
                for tab[index] in root.project-tabs: ProjectTab {
                    label: tab.name + (tab.dirty ? " *" : "");
                    selected: root.current-project == index;
                    activate => { root.select-project(index); }
                    close => { root.close-project(index); }
                }
                Button { text: "+"; width: 38px; clicked => { root.new-project(); } }
                Rectangle { horizontal-stretch: 1; }
            }
        }
            Rectangle {
            vertical-stretch: 1;
            background: #050506;
            Image {
                source: root.preview-image;
                image-fit: contain;
                width: 100%;
                height: 100%;
            }
        }
            Rectangle {
            height: 40px;
            background: #25282f;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                seek-slider := Slider {
                    value: root.playhead;
                    minimum: 0;
                    maximum: root.duration;
                    horizontal-stretch: 1;
                    accessible-label: "シークバー";
                    changed => { root.seek(self.value); }
                }
                Text { text: round(root.playhead) + " / " + round(root.duration); font-family: "Monospace"; vertical-alignment: center; }
                Button { text: "◀"; accessible-label: "1フレーム戻る"; clicked => { root.previous-frame(); } }
                Button { text: root.playing ? "Ⅱ" : "▶"; accessible-label: root.playing ? "一時停止" : "再生"; clicked => { root.toggle-playback(); } }
                Button { text: "▶|"; accessible-label: "1フレーム進む"; clicked => { root.next-frame(); } }
                Text { text: "速度 1.0x"; vertical-alignment: center; }
            }
        }
            Rectangle {
            height: 22px;
            background: #1d2026;
            Text { text: root.status-text; x: 8px; vertical-alignment: center; color: #c7cad1; font-size: 0.82rem; }
            }
        }
    }

    if root.save-confirmation-visible : Rectangle {
        z: 1000;
        width: 100%;
        height: 100%;
        background: #00000088;

        TouchArea { }

        Rectangle {
            width: min(parent.width - 32px, 460px);
            height: 174px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #2b2f38;
            border-width: 1px;
            border-color: #555b68;
            border-radius: 6px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "保存の確認";
                    color: #f2f3f5;
                    font-size: 1.15rem;
                    font-weight: 700;
                }
                Text {
                    text: root.save-confirmation-project + " に保存されていない変更があります。\n続行する前に保存しますか？";
                    color: #d6d9df;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "保存";
                        accessible-label: "保存";
                        clicked => { root.confirm-save(); }
                    }
                    Button {
                        text: "破棄";
                        accessible-label: "破棄";
                        clicked => { root.confirm-discard(); }
                    }
                    Button {
                        text: "キャンセル";
                        accessible-label: "キャンセル";
                        clicked => { root.confirm-cancel(); }
                    }
                }
            }
        }
    }
}

export component TimelineWindow inherits Window {
    title: "タイムライン";
    preferred-width: 1280px;
    preferred-height: 300px;
    min-width: 720px;
    min-height: 220px;
    forward-focus: timeline-shortcuts;
    in-out property <string> action-status: "";
    in property <[SceneTabData]> scene-tabs;
    in property <[TimelineClipData]> clips;
    in property <[LayerData]> layers;
    in property <int> duration: 3600;
    in property <int> playhead: 0;
    in property <int> selected-layer: 0;
    in-out property <float> pixels-per-frame: 1;
    in-out property <bool> skimmer-visible: false;
    in-out property <int> skimmer-frame: 0;
    in-out property <int> skimmer-layer: 0;
    private property <length> shared-viewport-x: 0px;
    private property <length> shared-viewport-y: 0px;
    private property <bool> box-active: false;
    private property <bool> box-dragging: false;
    private property <int> box-start-frame: 0;
    private property <int> box-start-layer: 0;
    private property <int> box-current-frame: 0;
    private property <int> box-current-layer: 0;
    callback timeline-action(string);
    callback show-object-settings();
    callback show-scene-settings();
    callback scene-selected(int);
    callback scene-settings(int);
    callback scene-closed(int);
    callback clip-selected(int, bool);
    callback clip-drag-started(int, bool);
    callback clip-context-selected(int);
    callback clip-command(string, int);
    callback clip-drag-finished(string, int, float, float, bool);
    callback layer-activated(int);
    callback layer-command(string, int);
    callback empty-clicked(int, int);
    callback box-selection-started(int, int, bool);
    callback box-selection-updated(int, int);
    callback box-selection-finished();
    callback box-selection-cancelled();
    callback skimmer-hovered(float, int, bool);
    callback skimmer-left();
    callback keyboard-shortcut(string, bool, bool, bool, bool) -> bool;
    callback timeline-scrolled(float, float, float, float, float, float, float, float, float, float, bool, bool, bool, bool) -> TimelineViewportData;

    function update-skimmer(frame: float, layer: int, ignore-snap: bool) {
        skimmer-leave-timer.running = false;
        root.skimmer-hovered(frame, layer, ignore-snap);
    }

    function schedule-skimmer-left() {
        skimmer-leave-timer.running = false;
        skimmer-leave-timer.running = true;
    }

    function apply-timeline-scroll(
        delta-x: length,
        delta-y: length,
        content-x: length,
        alt: bool,
        control: bool,
        shift: bool,
        ruler-zoom: bool
    ) -> bool {
        let result = root.timeline-scrolled(
            delta-x / 1px,
            delta-y / 1px,
            content-x / 1px,
            root.shared-viewport-x / 1px,
            root.shared-viewport-y / 1px,
            timeline-scroll.visible-width / 1px,
            timeline-scroll.viewport-width / 1px,
            timeline-scroll.visible-height / 1px,
            timeline-scroll.viewport-height / 1px,
            root.duration,
            alt,
            control,
            shift,
            ruler-zoom
        );
        root.pixels-per-frame = result.pixels-per-frame;
        root.shared-viewport-x = result.viewport-x * 1px;
        root.shared-viewport-y = result.viewport-y * 1px;
        return true;
    }

    function scroll-layers(delta-y: length) -> bool {
        let minimum = min(0px, layer-scroll.visible-height - layer-scroll.viewport-height);
        root.shared-viewport-y = max(minimum, min(0px, root.shared-viewport-y + delta-y));
        return true;
    }

    skimmer-leave-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.skimmer-left();
        }
    }

    timeline-shortcuts := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if root.keyboard-shortcut(
                event.text,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.meta
            ) {
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            spacing: 0px;
            Rectangle {
            height: 28px;
            background: #2a2e36;
            HorizontalLayout {
                spacing: 0px;
                for scene in root.scene-tabs: SceneTab {
                    scene: scene;
                    activate(scene-id) => { root.scene-selected(scene-id); }
                    settings(scene-id) => { root.scene-settings(scene-id); }
                    close(scene-id) => { root.scene-closed(scene-id); }
                }
                Button { text: "+"; width: 40px; clicked => { root.show-scene-settings(); } }
                Rectangle { horizontal-stretch: 1; }
            }
        }
            Rectangle {
            height: 32px;
            background: #343943;
            Rectangle { width: 60px; height: 100%; background: #2a2e36; }
            ruler-scroll := ScrollView {
                x: 60px;
                width: parent.width - 60px;
                height: parent.height;
                viewport-width: max(root.duration * root.pixels-per-frame * 1px, self.visible-width);
                viewport-height: self.visible-height;
                viewport-x <=> root.shared-viewport-x;
                for tick in 61: Rectangle {
                    visible: tick * 60 <= root.duration;
                    x: tick * 60 * root.pixels-per-frame * 1px;
                    width: 1px;
                    height: 100%;
                    background: #626874;
                    Text {
                        x: 4px;
                        text: tick * 60;
                        color: #e2e4e8;
                        font-family: "Monospace";
                        font-size: 0.78rem;
                    }
                }
                ruler-wheel := TouchArea {
                    width: 100%;
                    height: 100%;
                    scroll-event(event) => {
                        root.apply-timeline-scroll(
                            event.delta-x,
                            event.delta-y,
                            self.mouse-x,
                            false,
                            false,
                            false,
                            true
                        ) ? accept : reject
                    }
                }
            }
        }
            HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            layer-scroll := ScrollView {
                width: 60px;
                vertical-stretch: 1;
                viewport-width: self.visible-width;
                viewport-height: root.layers.length * 30px;
                viewport-y <=> root.shared-viewport-y;
                for layer in root.layers: LayerHeaderItem {
                    y: layer.index * 30px;
                    width: 60px;
                    layer: layer;
                    activate(layer-index) => { root.layer-activated(layer-index); }
                    command(action, layer-index) => { root.layer-command(action, layer-index); }
                    scroll-requested(delta-y) => { root.scroll-layers(delta-y) }
                }
            }

            timeline-scroll := ScrollView {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                viewport-width: max(root.duration * root.pixels-per-frame * 1px, self.visible-width);
                viewport-height: root.layers.length * 30px;
                viewport-x <=> root.shared-viewport-x;
                viewport-y <=> root.shared-viewport-y;
                mouse-drag-pan-enabled: false;

                timeline-menu := ContextMenuArea {
                    Menu {
                        MenuItem { title: "元に戻す"; activated => { root.timeline-action("undo"); } }
                        MenuItem { title: "やり直す"; activated => { root.timeline-action("redo"); } }
                        MenuSeparator { }
                        MenuItem { title: "貼り付け"; activated => { root.timeline-action("paste"); } }
                        MenuSeparator { }
                        MenuItem { title: "オブジェクトを追加"; activated => { root.timeline-action("add-object"); } }
                        MenuItem { title: "プロジェクト設定"; activated => { root.timeline-action("project-settings"); } }
                    }
                    background-touch := TouchArea {
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.move {
                                root.update-skimmer(
                                    self.mouse-x / (root.pixels-per-frame * 1px),
                                    floor(self.mouse-y / 30px),
                                    event.modifiers.shift
                                );
                            }
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                root.empty-clicked(
                                    floor(self.mouse-x / (root.pixels-per-frame * 1px)),
                                    floor(self.mouse-y / 30px)
                                );
                            }
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                                root.box-active = true;
                                root.box-dragging = false;
                                root.box-start-frame = max(0, floor(self.mouse-x / (root.pixels-per-frame * 1px)));
                                root.box-start-layer = max(0, floor(self.mouse-y / 30px));
                                root.box-current-frame = root.box-start-frame;
                                root.box-current-layer = root.box-start-layer;
                                root.box-selection-started(
                                    root.box-start-frame,
                                    root.box-start-layer,
                                    event.modifiers.control || event.modifiers.meta
                                );
                            }
                            if event.kind == PointerEventKind.move && root.box-active {
                                root.box-current-frame = max(0, floor(self.mouse-x / (root.pixels-per-frame * 1px)));
                                root.box-current-layer = max(0, floor(self.mouse-y / 30px));
                                if abs(self.mouse-x - self.pressed-x) >= 3px || abs(self.mouse-y - self.pressed-y) >= 3px {
                                    root.box-dragging = true;
                                    root.box-selection-updated(root.box-current-frame, root.box-current-layer);
                                }
                            }
                            if event.kind == PointerEventKind.up && event.button == PointerEventButton.right && root.box-active {
                                if root.box-dragging {
                                    root.box-selection-finished();
                                } else {
                                    root.box-selection-cancelled();
                                    timeline-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                }
                                root.box-active = false;
                                root.box-dragging = false;
                            }
                            if event.kind == PointerEventKind.cancel && root.box-active {
                                root.box-selection-cancelled();
                                root.box-active = false;
                                root.box-dragging = false;
                            }
                        }
                        scroll-event(event) => {
                            root.apply-timeline-scroll(
                                event.delta-x,
                                event.delta-y,
                                self.mouse-x,
                                event.modifiers.alt,
                                event.modifiers.control,
                                event.modifiers.shift,
                                false
                            ) ? accept : reject
                        }
                        changed has-hover => { if !self.has-hover { root.schedule-skimmer-left(); } }
                    }
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #1b1e24;
                }
                for row in root.layers.length: Rectangle {
                    y: row * 30px;
                    width: 100%;
                    height: 1px;
                    background: #414650;
                }
                for clip in root.clips: TimelineClipItem {
                    x: clip.start * root.pixels-per-frame * 1px;
                    y: clip.layer * 30px + 3px;
                    width: max(clip.duration * root.pixels-per-frame * 1px, 8px);
                    clip-data: clip;
                    activate(clip-id, additive) => { root.clip-selected(clip-id, additive); }
                    prepare-drag(clip-id, additive) => { root.clip-drag-started(clip-id, additive); }
                    context-activate(clip-id) => { root.clip-context-selected(clip-id); }
                    open-settings(clip-id) => {
                        root.clip-context-selected(clip-id);
                        root.show-object-settings();
                    }
                    command(action, clip-id) => { root.clip-command(action, clip-id); }
                    pointer-hovered(content-x, content-y, ignore-snap) => {
                        root.update-skimmer(
                            content-x / root.pixels-per-frame,
                            floor(content-y / 30),
                            ignore-snap
                        );
                    }
                    pointer-left => { root.schedule-skimmer-left(); }
                    scroll-requested(delta-x, delta-y, content-x, alt, control, shift) => {
                        root.apply-timeline-scroll(
                            delta-x,
                            delta-y,
                            content-x,
                            alt,
                            control,
                            shift,
                            false
                        )
                    }
                    drag-finished(kind, clip-id, delta-x, delta-y, ignore-snap) => {
                        root.clip-drag-finished(kind, clip-id, delta-x, delta-y, ignore-snap);
                    }
                }
                if root.box-active && root.box-dragging : Rectangle {
                    x: min(root.box-start-frame, root.box-current-frame) * root.pixels-per-frame * 1px;
                    y: min(root.box-start-layer, root.box-current-layer) * 30px;
                    width: max(abs(root.box-current-frame - root.box-start-frame) * root.pixels-per-frame * 1px, 1px);
                    height: max((abs(root.box-current-layer - root.box-start-layer) + 1) * 30px, 1px);
                    background: #4b82ca44;
                    border-width: 1px;
                    border-color: #7aafefff;
                }
                if root.skimmer-visible : Rectangle {
                    x: root.skimmer-frame * root.pixels-per-frame * 1px;
                    width: 1px;
                    height: 100%;
                    background: #ff5a3dd9;
                }
                Rectangle {
                    x: root.playhead * root.pixels-per-frame * 1px;
                    width: 2px;
                    height: 100%;
                    background: #e74f61;
                }
            }
        }
            Rectangle { height: 22px; background: #252931; Text { text: root.action-status; x: 8px; vertical-alignment: center; font-size: 0.82rem; } }
        }
    }
}

export component ExportWindow inherits Window {
    title: "メディアの書き出し";
    preferred-width: 620px;
    preferred-height: 580px;
    min-width: 520px;
    min-height: 460px;

    in property <int> project-width: 1920;
    in property <int> project-height: 1080;
    in property <float> project-fps: 60;
    in property <int> timeline-duration: 300;
    in-out property <int> format-index: 0;
    in-out property <int> image-format-index: 0;
    in-out property <string> output-path: "";
    in property <[string]> video-codec-labels;
    in-out property <int> video-codec-index: 0;
    in-out property <bool> software-codec: true;
    in-out property <bool> crf-mode: true;
    in-out property <bool> bitrate-mode: false;
    in-out property <float> crf: 20;
    in-out property <int> bitrate-mbps: 15;
    in-out property <int> preset-index: 2;
    in-out property <int> profile-index: 0;
    in property <[string]> audio-codec-labels;
    in-out property <int> audio-codec-index: 0;
    in-out property <bool> audio-bitrate-enabled: true;
    in-out property <int> audio-bitrate-index: 2;
    in-out property <bool> full-range: true;
    in-out property <int> start-frame: 0;
    in-out property <int> end-frame: 300;
    in property <bool> exporting: false;
    in property <float> export-progress: 0;
    in property <string> progress-label: "0 / 0 フレーム";
    in-out property <bool> cancel-confirmation-visible: false;
    in-out property <bool> result-visible: false;
    in property <bool> result-success: true;
    in property <string> result-message: "";

    pure callback validate-output-path(string) -> bool;
    callback browse-output(bool);
    callback video-codec-selected(int);
    callback audio-codec-selected(int);
    callback start-export();
    callback close-window();
    callback request-cancel();
    callback confirm-cancel();
    callback dismiss-cancel();
    callback dismiss-result();

    ScrollView {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 8px;
                Text { text: "形式:"; vertical-alignment: center; }
                ComboBox {
                    model: ["動画ファイル", "画像シーケンス"];
                    current-index <=> root.format-index;
                }
                if root.format-index == 1 : ComboBox {
                    model: ["PNG", "JPEG"];
                    current-index <=> root.image-format-index;
                }
                LineEdit {
                    text <=> root.output-path;
                    placeholder-text: root.format-index == 1 ? "保存先フォルダ..." : "保存先ファイルパス...";
                    horizontal-stretch: 1;
                }
                Button {
                    text: "参照...";
                    clicked => { root.browse-output(root.format-index == 1); }
                }
            }

            if root.format-index == 0 : GroupBox {
                title: "映像";
                GridLayout {
                    padding: 10px;
                    spacing: 9px;
                    Row {
                        Text { text: "解像度:"; vertical-alignment: center; }
                        Text { text: root.project-width + " × " + root.project-height; font-weight: 700; vertical-alignment: center; }
                    }
                    Row {
                        Text { text: "FPS:"; vertical-alignment: center; }
                        Text { text: root.project-fps.to-fixed(3); font-weight: 700; vertical-alignment: center; }
                    }
                    Row {
                        Text { text: "コーデック:"; vertical-alignment: center; }
                        ComboBox {
                            model: root.video-codec-labels;
                            current-index <=> root.video-codec-index;
                            selected(value) => { root.video-codec-selected(self.current-index); }
                        }
                    }
                    Row {
                        Text { text: "品質モード:"; vertical-alignment: center; }
                        RadioGroup {
                            orientation: Orientation.horizontal;
                            RadioButton { text: "CRF"; checked <=> root.crf-mode; }
                            RadioButton { text: "ビットレート"; checked <=> root.bitrate-mode; }
                        }
                    }
                    if root.crf-mode : Row {
                        Text { text: "CRF:"; vertical-alignment: center; }
                        HorizontalLayout {
                            spacing: 8px;
                            Slider { value <=> root.crf; minimum: 0; maximum: 51; horizontal-stretch: 1; }
                            Text { text: root.crf.round(); preferred-width: 28px; vertical-alignment: center; }
                            Text {
                                text: root.crf <= 17 ? "高品質" : root.crf <= 28 ? "標準" : "低品質";
                                color: root.crf <= 17 ? #76dba4 : root.crf <= 28 ? #d6d9df : #ff9ca8;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if root.bitrate-mode : Row {
                        Text { text: "ビットレート:"; vertical-alignment: center; }
                        HorizontalLayout {
                            SpinBox { value <=> root.bitrate-mbps; minimum: 1; maximum: 500; }
                            Text { text: "Mbps"; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                    if root.software-codec : Row {
                        Text { text: "プリセット:"; vertical-alignment: center; }
                        ComboBox {
                            model: ["最速 (ultrafast)", "高速 (fast)", "標準 (medium)", "高品質 (slow)", "最高品質 (veryslow)"];
                            current-index <=> root.preset-index;
                        }
                    }
                    if root.software-codec : Row {
                        Text { text: "プロファイル:"; vertical-alignment: center; }
                        ComboBox {
                            model: ["自動", "Baseline", "Main", "High"];
                            current-index <=> root.profile-index;
                        }
                    }
                }
            }

            if root.format-index == 0 : GroupBox {
                title: "音声";
                GridLayout {
                    padding: 10px;
                    spacing: 9px;
                    Row {
                        Text { text: "コーデック:"; vertical-alignment: center; }
                        ComboBox {
                            model: root.audio-codec-labels;
                            current-index <=> root.audio-codec-index;
                            selected(value) => { root.audio-codec-selected(self.current-index); }
                        }
                    }
                    Row {
                        Text { text: "ビットレート:"; vertical-alignment: center; }
                        ComboBox {
                            model: ["96 kbps", "128 kbps", "192 kbps", "256 kbps", "320 kbps"];
                            current-index <=> root.audio-bitrate-index;
                            enabled: root.audio-bitrate-enabled;
                        }
                    }
                }
            }

            GroupBox {
                title: "範囲";
                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;
                    CheckBox { text: "タイムライン全体"; checked <=> root.full-range; }
                    Text { text: "開始:"; vertical-alignment: center; }
                    SpinBox {
                        value <=> root.start-frame;
                        minimum: 0;
                        maximum: max(root.end-frame - 1, 0);
                        enabled: !root.full-range;
                    }
                    Text { text: "終了:"; vertical-alignment: center; }
                    SpinBox {
                        value <=> root.end-frame;
                        minimum: root.start-frame + 1;
                        maximum: 999999;
                        enabled: !root.full-range;
                    }
                    Text {
                        text: "(" + (root.full-range ? root.timeline-duration : root.end-frame - root.start-frame)
                            + " フレーム / "
                            + ((root.full-range ? root.timeline-duration : root.end-frame - root.start-frame) / max(root.project-fps, 1)).to-fixed(2)
                            + " 秒)";
                        opacity: 0.65;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: "キャンセル"; clicked => { root.close-window(); } }
                Button {
                    text: "書き出し開始";
                    enabled: root.validate-output-path(root.output-path);
                    clicked => { root.start-export(); }
                }
            }
        }
    }

    if root.exporting : Rectangle {
        z: 1000;
        width: 100%;
        height: 100%;
        background: #000000bf;
        TouchArea { }
        Rectangle {
            width: min(parent.width * 0.7, 430px);
            height: 180px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: transparent;
            VerticalLayout {
                spacing: 16px;
                Text { text: "書き出し中..."; color: white; font-size: 1.05rem; font-weight: 700; horizontal-alignment: center; }
                ProgressIndicator { progress: root.export-progress / 100; }
                Text { text: root.progress-label; color: #ffffffcc; horizontal-alignment: center; }
                HorizontalLayout {
                    alignment: center;
                    Button { text: "キャンセル"; clicked => { root.request-cancel(); } }
                }
            }
        }
    }

    if root.cancel-confirmation-visible : Rectangle {
        z: 1100;
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: 330px;
            height: 170px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #2b2f38;
            border-width: 1px;
            border-color: #555b68;
            border-radius: 6px;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text { text: "書き出しキャンセル"; color: #f2f3f5; font-size: 1.1rem; font-weight: 700; }
                Text { text: "書き出しをキャンセルしますか？\n進捗は失われます。"; color: #d6d9df; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "はい"; clicked => { root.confirm-cancel(); } }
                    Button { text: "いいえ"; clicked => { root.dismiss-cancel(); } }
                }
            }
        }
    }

    if root.result-visible : Rectangle {
        z: 1200;
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 32px, 450px);
            height: 170px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #2b2f38;
            border-width: 1px;
            border-color: #555b68;
            border-radius: 6px;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text { text: root.result-success ? "完了" : "エラー"; color: #f2f3f5; font-size: 1.1rem; font-weight: 700; }
                Text { text: root.result-message; color: #d6d9df; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    Button { text: "OK"; clicked => { root.dismiss-result(); } }
                }
            }
        }
    }
}

export component ProjectSettingsWindow inherits Window {
    title: "プロジェクト設定";
    preferred-width: 450px;
    preferred-height: 240px;
    min-width: 390px;
    min-height: 220px;

    in-out property <int> project-width: 1920;
    in-out property <int> project-height: 1080;
    in-out property <string> project-fps: "60";
    in-out property <int> project-sample-rate: 48000;
    callback apply-settings() -> bool;
    callback close-window();

    VerticalLayout {
        padding: 16px;
        spacing: 14px;
        GridLayout {
            spacing: 10px;
            Row {
                Text { text: "幅:"; vertical-alignment: center; }
                SpinBox { value <=> root.project-width; minimum: 1; maximum: 8000; }
            }
            Row {
                Text { text: "高さ:"; vertical-alignment: center; }
                SpinBox { value <=> root.project-height; minimum: 1; maximum: 8000; }
            }
            Row {
                Text { text: "FPS:"; vertical-alignment: center; }
                LineEdit { text <=> root.project-fps; }
            }
            Row {
                Text { text: "サンプリングレート:"; vertical-alignment: center; }
                SpinBox { value <=> root.project-sample-rate; minimum: 8000; maximum: 192000; step-size: 1000; }
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Button {
                text: "適用";
                clicked => {
                    if root.apply-settings() {
                        root.close-window();
                    }
                }
            }
            Button { text: "キャンセル"; clicked => { root.close-window(); } }
        }
    }
}

export component SceneSettingsWindow inherits Window {
    title: root.creation-mode ? "新規シーン作成" : "シーン設定";
    preferred-width: 450px;
    preferred-height: 550px;
    min-width: 410px;
    min-height: 460px;

    in-out property <bool> creation-mode: false;
    in-out property <int> target-scene-id: -1;
    in-out property <string> scene-name: "";
    in-out property <int> scene-width: 1920;
    in-out property <int> scene-height: 1080;
    in-out property <string> scene-fps: "60";
    in-out property <int> scene-duration: 3600;
    in-out property <int> grid-mode-index: 0;
    in-out property <string> grid-bpm: "120";
    in-out property <string> grid-offset: "0";
    in-out property <string> grid-interval: "10";
    in-out property <string> grid-subdivision: "4";
    in-out property <bool> enable-snap: true;
    in-out property <int> magnetic-snap-range: 10;
    callback apply-settings() -> bool;
    callback close-window();

    ScrollView {
        VerticalLayout {
            padding: 15px;
            spacing: 14px;
            GroupBox {
                title: "基本設定";
                GridLayout {
                    padding: 10px;
                    spacing: 9px;
                    Row {
                        Text { text: "シーン名:"; vertical-alignment: center; }
                        LineEdit { text <=> root.scene-name; }
                    }
                    Row {
                        Text { text: "幅:"; vertical-alignment: center; }
                        SpinBox { value <=> root.scene-width; minimum: 1; maximum: 8000; }
                    }
                    Row {
                        Text { text: "高さ:"; vertical-alignment: center; }
                        SpinBox { value <=> root.scene-height; minimum: 1; maximum: 8000; }
                    }
                    Row {
                        Text { text: "FPS:"; vertical-alignment: center; }
                        LineEdit { text <=> root.scene-fps; }
                    }
                }
            }
            GroupBox {
                title: "編集とスナップ";
                GridLayout {
                    padding: 10px;
                    spacing: 9px;
                    Row {
                        Text { text: "スナップを有効にする:"; vertical-alignment: center; }
                        CheckBox { checked <=> root.enable-snap; }
                    }
                    Row {
                        Text { text: "磁力スナップ範囲:"; vertical-alignment: center; }
                        SpinBox { value <=> root.magnetic-snap-range; minimum: 1; maximum: 100; }
                    }
                    Row {
                        Text { text: "グリッドモード:"; vertical-alignment: center; }
                        ComboBox {
                            model: ["自動 (秒/フレーム)", "BPM (音楽)", "フレーム数固定"];
                            current-index <=> root.grid-mode-index;
                        }
                    }
                }
            }
            if root.grid-mode-index == 1 : GroupBox {
                title: "BPM設定";
                GridLayout {
                    padding: 10px;
                    spacing: 9px;
                    Row { Text { text: "BPM:"; vertical-alignment: center; } LineEdit { text <=> root.grid-bpm; } }
                    Row { Text { text: "拍子 (分割数):"; vertical-alignment: center; } LineEdit { text <=> root.grid-subdivision; } }
                    Row { Text { text: "オフセット (秒):"; vertical-alignment: center; } LineEdit { text <=> root.grid-offset; } }
                }
            }
            if root.grid-mode-index == 2 : GroupBox {
                title: "フレーム設定";
                GridLayout {
                    padding: 10px;
                    spacing: 9px;
                    Row { Text { text: "間隔 (Frames):"; vertical-alignment: center; } LineEdit { text <=> root.grid-interval; } }
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: "キャンセル"; clicked => { root.close-window(); } }
                Button {
                    text: "OK";
                    clicked => {
                        if root.apply-settings() {
                            root.close-window();
                        }
                    }
                }
            }
        }
    }
}

export component SystemSettingsWindow inherits Window {
    title: "環境設定";
    preferred-width: 620px;
    preferred-height: 590px;
    min-width: 520px;
    min-height: 480px;

    in-out property <bool> confirm-unsaved: true;
    in-out property <bool> auto-backup: true;
    in-out property <int> backup-interval: 5;
    in-out property <int> undo-count: 32;
    in-out property <int> default-project-width: 1920;
    in-out property <int> default-project-height: 1080;
    in-out property <string> default-project-fps: "60";
    in-out property <int> default-project-frames: 3600;
    in-out property <int> default-project-sample-rate: 48000;
    callback reload-settings();
    callback apply-settings() -> bool;
    callback close-window();

    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        ScrollView {
            VerticalLayout {
                spacing: 14px;
                GroupBox {
                    title: "一般 / ファイル";
                    VerticalLayout {
                        padding: 10px;
                        spacing: 9px;
                        CheckBox {
                            text: "終了時に未保存のプロジェクトを確認する";
                            checked <=> root.confirm-unsaved;
                        }
                        CheckBox {
                            text: "自動バックアップを有効にする";
                            checked <=> root.auto-backup;
                        }
                        HorizontalLayout {
                            opacity: root.auto-backup ? 1 : 0.5;
                            Text { text: "バックアップ間隔"; vertical-alignment: center; }
                            SpinBox {
                                value <=> root.backup-interval;
                                minimum: 1;
                                maximum: 60;
                                enabled: root.auto-backup;
                            }
                            Text { text: "分"; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            Text { text: "元に戻す回数"; vertical-alignment: center; }
                            SpinBox { value <=> root.undo-count; minimum: 1; maximum: 1000; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
                GroupBox {
                    title: "新規プロジェクト";
                    GridLayout {
                        padding: 10px;
                        spacing: 9px;
                        Row {
                            Text { text: "幅:"; vertical-alignment: center; }
                            SpinBox { value <=> root.default-project-width; minimum: 1; maximum: 16000; }
                        }
                        Row {
                            Text { text: "高さ:"; vertical-alignment: center; }
                            SpinBox { value <=> root.default-project-height; minimum: 1; maximum: 16000; }
                        }
                        Row {
                            Text { text: "FPS:"; vertical-alignment: center; }
                            LineEdit { text <=> root.default-project-fps; }
                        }
                        Row {
                            Text { text: "総フレーム数:"; vertical-alignment: center; }
                            SpinBox { value <=> root.default-project-frames; minimum: 1; maximum: 1000000; step-size: 100; }
                        }
                        Row {
                            Text { text: "サンプリングレート:"; vertical-alignment: center; }
                            SpinBox { value <=> root.default-project-sample-rate; minimum: 8000; maximum: 192000; step-size: 1000; }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        Rectangle {
            height: 52px;
            border-width: 1px;
            border-color: #555b68;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Text {
                    text: "設定は「適用」または「OK」で保存されます";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Button { text: "再読込"; clicked => { root.reload-settings(); } }
                Button { text: "適用"; clicked => { root.apply-settings(); } }
                Button {
                    text: "OK";
                    clicked => {
                        if root.apply-settings() {
                            root.close-window();
                        }
                    }
                }
                Button { text: "閉じる"; clicked => { root.close-window(); } }
            }
        }
    }
}

export component ObjectSettingsWindow inherits Window {
    title: root.has-selection ? "設定ダイアログ - " + root.clip-title : "設定ダイアログ";
    preferred-width: 900px;
    preferred-height: 650px;
    min-width: 680px;
    min-height: 480px;
    in property <bool> has-selection: false;
    in property <string> clip-title: "";
    in property <[ObjectEffectData]> effects;
    in property <[ObjectSettingRowData]> setting-rows;
    in property <[EffectCatalogItemData]> effect-catalog-items;
    in-out property <bool> effect-picker-visible: false;
    in-out property <string> effect-filter: "";
    in-out property <bool> preset-save-visible: false;
    in-out property <int> preset-effect-index: -1;
    in-out property <string> preset-effect-name: "";
    in-out property <string> preset-name: "";
    callback select-effect(int, bool, bool);
    callback context-select-effect(int);
    callback reorder-effect(int, float);
    callback set-effect-enabled(int, bool);
    callback remove-effect(int);
    callback filter-effects(string);
    callback add-effect(string);
    callback save-effect-preset(int, string);
    callback load-effect-preset(int, string);
    callback delete-effect-preset(int, string);
    callback preset-names(int) -> [string];
    callback set-parameter-text(int, string, string);
    callback set-parameter-number(int, string, float);
    callback set-parameter-bool(int, string, bool);
    callback set-parameter-option(int, string, int);

    if !root.has-selection : VerticalLayout {
        alignment: center;
        Text {
            text: "タイムラインでオブジェクトを選択してください";
            color: #aeb3bc;
            horizontal-alignment: center;
        }
    }

    if root.has-selection : HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 250px;
            background: #262a32;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                Text { text: root.clip-title; font-weight: 700; color: #f2f3f5; overflow: elide; }
                Text { text: "オブジェクト / エフェクト"; color: #aeb3bc; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        for effect in root.effects : EffectSidebarEntry {
                            effect: effect;
                            activate(index, control, shift) => { root.select-effect(index, control, shift); }
                            context-activate(index) => { root.context-select-effect(index); }
                            remove(index) => { root.remove-effect(index); }
                            reorder(index, delta-y) => { root.reorder-effect(index, delta-y); }
                            save-preset(index, effect-name) => {
                                root.preset-effect-index = index;
                                root.preset-effect-name = effect-name;
                                root.preset-name = "";
                                root.preset-save-visible = true;
                            }
                            load-preset(index, name) => { root.load-effect-preset(index, name); }
                            delete-preset(index, name) => { root.delete-effect-preset(index, name); }
                            query-presets(index) => { root.preset-names(index) }
                        }
                        if root.effects.length == 0 : Text {
                            text: "設定項目がありません";
                            color: #9ea4ae;
                            wrap: word-wrap;
                        }
                    }
                }
                Button {
                    text: "+ エフェクトを追加";
                    clicked => {
                        root.effect-filter = "";
                        root.filter-effects("");
                        root.effect-picker-visible = true;
                    }
                }
            }
        }
        ScrollView {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                Text {
                    text: "選択オブジェクトの設定";
                    font-size: 1.15rem;
                    font-weight: 700;
                }
                for row in root.setting-rows : ObjectSettingRow {
                    row-data: row;
                    activate-effect(index) => { root.select-effect(index, false, false); }
                    set-effect-enabled(index, enabled) => { root.set-effect-enabled(index, enabled); }
                    remove-effect(index) => { root.remove-effect(index); }
                    set-text(index, param, value) => { root.set-parameter-text(index, param, value); }
                    set-number(index, param, value) => { root.set-parameter-number(index, param, value); }
                    set-bool(index, param, value) => { root.set-parameter-bool(index, param, value); }
                    set-option(index, param, option) => { root.set-parameter-option(index, param, option); }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    if root.effect-picker-visible : Rectangle {
        z: 100;
        background: #99000000;
        TouchArea { clicked => { root.effect-picker-visible = false; } }
        picker-panel := Rectangle {
            width: min(parent.width - 48px, 560px);
            height: min(parent.height - 48px, 520px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #2b3038;
            border-width: 1px;
            border-color: #646b78;
            border-radius: 4px;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text { text: "フィルタ効果を追加"; font-size: 1.15rem; font-weight: 700; }
                LineEdit {
                    text <=> root.effect-filter;
                    placeholder-text: "名前・ID・カテゴリを検索...";
                    edited(value) => { root.filter-effects(value); }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for item in root.effect-catalog-items : Button {
                            text: item.categories == ""
                                ? item.name
                                : item.name + "  [" + item.categories + "]";
                            accessible-description: item.id;
                            clicked => {
                                root.add-effect(item.id);
                                root.effect-picker-visible = false;
                            }
                        }
                        if root.effect-catalog-items.length == 0 : Text {
                            text: "一致するエフェクトがありません";
                            color: #aeb3bc;
                        }
                    }
                }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "閉じる"; clicked => { root.effect-picker-visible = false; } }
                }
            }
        }
    }

    if root.preset-save-visible : Rectangle {
        z: 110;
        background: #99000000;
        TouchArea { clicked => { root.preset-save-visible = false; } }
        Rectangle {
            width: min(parent.width - 48px, 420px);
            height: 190px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #2b3038;
            border-width: 1px;
            border-color: #646b78;
            border-radius: 4px;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Text { text: "プリセットを保存"; font-size: 1.15rem; font-weight: 700; }
                Text { text: root.preset-effect-name; color: #aeb3bc; overflow: elide; }
                LineEdit {
                    text <=> root.preset-name;
                    placeholder-text: "プリセット名を入力...";
                    accepted(value) => {
                        if value != "" {
                            root.save-effect-preset(root.preset-effect-index, value);
                            root.preset-save-visible = false;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "キャンセル"; clicked => { root.preset-save-visible = false; } }
                    Button {
                        text: "保存";
                        enabled: root.preset-name != "";
                        clicked => {
                            root.save-effect-preset(root.preset-effect-index, root.preset-name);
                            root.preset-save-visible = false;
                        }
                    }
                }
            }
        }
    }
}
