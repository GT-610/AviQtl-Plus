export struct ObjectSettingRowData {
    row-kind: string,
    source-kind: string,
    audio-plugin: bool,
    effect-index: int,
    param-name: string,
    label: string,
    effect-enabled: bool,
    header-toggle-visible: bool,
    selected: bool,
    removable: bool,
    interactive: bool,
    checked: bool,
    keyframed: bool,
    range-mode: bool,
    right-interactive: bool,
    start-frame: int,
    end-frame: int,
    current-frame: int,
    clip-duration: int,
    interpolation: string,
    parameter-button-label: string,
    number-value: float,
    end-number-value: float,
    minimum: float,
    maximum: float,
    step: float,
    text-value: string,
    end-text-value: string,
    filter: string,
    color-value: color,
    end-color-value: color,
    unit: string,
    keyframe-markers: [KeyframeMarkerData],
    option-labels: [string],
    selected-option: int,
}

component KeyframeTrack inherits Rectangle {
    in property <ObjectSettingRowData> row-data;
    callback seek(int);
    callback snap(float) -> int;
    callback add(int, string, int);
    callback remove(int, string, int);
    callback move-keyframe(int, string, int, int);
    height: 24px;
    background: transparent;
    private property <length> inset: 12px;

    track-line := Rectangle {
        x: root.inset;
        y: 11px;
        width: max(parent.width - root.inset * 2, 1px);
        height: 2px;
        background: AppTheme.border;
    }
    track-touch := TouchArea {
        x: track-line.x;
        width: track-line.width;
        mouse-cursor: pointer;
        accessible-role: slider;
        accessible-label: root.row-data.label + @tr(" Keyframes");
        accessible-value: "\{root.row-data.current-frame}";
        accessible-value-minimum: 0;
        accessible-value-maximum: root.row-data.clip-duration;
        accessible-value-step: 1;
        accessible-action-increment => { root.seek(min(root.row-data.clip-duration, root.row-data.current-frame + 1)); }
        accessible-action-decrement => { root.seek(max(0, root.row-data.current-frame - 1)); }
        accessible-action-set-value(value) => {
            if value.is-float() {
                root.seek(round(value.to-float()).clamp(0, root.row-data.clip-duration));
            }
        }
        clicked => {
            if root.row-data.clip-duration > 0 {
                root.seek(round(self.mouse-x / self.width * root.row-data.clip-duration));
            }
        }
        double-clicked => {
            if root.row-data.clip-duration > 0 {
                root.add(
                    root.row-data.effect-index,
                    root.row-data.param-name,
                    root.snap(self.mouse-x / self.width * root.row-data.clip-duration)
                );
            }
        }
    }
    for marker in root.row-data.keyframe-markers : Rectangle {
        private property <int> current-frame: marker.frame;
        private property <bool> dragging: false;
        private property <bool> threshold-crossed: false;
        private property <length> pointer-start-x: 0px;
        width: 16px;
        height: 16px;
        x: track-line.x
            + (root.row-data.clip-duration > 0
                ? self.current-frame / root.row-data.clip-duration * track-line.width
                : 0px)
            - self.width / 2;
        y: 4px;
        Rectangle {
            width: 8px;
            height: 8px;
            x: 4px;
            y: 4px;
            background: marker.virtual-end ? AppTheme.muted-foreground : AppTheme.foreground;
            transform-rotation: 45deg;
        }
        marker-touch := TouchArea {
            mouse-cursor: marker.draggable ? move : marker.removable ? pointer : default;
            accessible-role: button;
            accessible-label: @tr("Keyframe {}", marker.frame);
            accessible-description: marker.draggable
                ? @tr("Drag to move the keyframe")
                : marker.removable ? @tr("Keyframe") : @tr("Fixed keyframe");
            accessible-action-default => { root.seek(marker.frame); }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    parent.dragging = marker.draggable;
                    parent.threshold-crossed = false;
                    parent.pointer-start-x = self.absolute-position.x + self.mouse-x;
                }
                if event.kind == PointerEventKind.move && parent.dragging {
                    let delta = self.absolute-position.x + self.mouse-x - parent.pointer-start-x;
                    if abs(delta) >= 3px {
                        parent.threshold-crossed = true;
                    }
                    let raw-frame = marker.frame
                        + delta / max(track-line.width, 1px) * root.row-data.clip-duration;
                    parent.current-frame = root.snap(raw-frame).clamp(
                        marker.minimum-frame,
                        marker.maximum-frame
                    );
                }
                if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                    if parent.dragging && parent.threshold-crossed
                        && parent.current-frame != marker.frame {
                        root.move-keyframe(
                            root.row-data.effect-index,
                            root.row-data.param-name,
                            marker.frame,
                            parent.current-frame
                        );
                    } else {
                        root.seek(parent.current-frame);
                    }
                    parent.dragging = false;
                    parent.threshold-crossed = false;
                }
                if event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right
                    && marker.removable {
                    root.remove(
                        root.row-data.effect-index,
                        root.row-data.param-name,
                        marker.frame
                    );
                }
                if event.kind == PointerEventKind.cancel {
                    parent.current-frame = marker.frame;
                    parent.dragging = false;
                    parent.threshold-crossed = false;
                }
            }
        }
    }
    if root.row-data.clip-duration > 0 : Rectangle {
        x: track-line.x
            + root.row-data.current-frame / root.row-data.clip-duration * track-line.width;
        y: 2px;
        width: 1px;
        height: 20px;
        background: AppTheme.accent;
    }
}

component CommitLineEdit inherits LineEdit {
    in property <string> source-text;
    callback commit(string);
    text: root.source-text;
    accepted(value) => {
        if value != root.source-text {
            root.commit(value);
        }
        self.text = root.source-text;
        self.clear-focus();
    }
    changed has-focus => {
        if !self.has-focus && self.text != root.source-text {
            root.commit(self.text);
        }
    }
    changed source-text => {
        if !self.has-focus && self.text != root.source-text {
            self.text = root.source-text;
        }
    }
}

component CommitTextEdit inherits TextEdit {
    in property <string> source-text;
    callback commit(string);
    text: root.source-text;
    changed has-focus => {
        if !self.has-focus && self.text != root.source-text {
            root.commit(self.text);
        }
    }
    changed source-text => {
        if !self.has-focus && self.text != root.source-text {
            self.text = root.source-text;
        }
    }
}

component EffectSidebarEntry inherits Rectangle {
    in property <ObjectEffectData> effect;
    in property <int> selected-count: 0;
    in property <bool> selected-removable: false;
    callback activate(int, bool, bool);
    callback context-activate(int);
    callback set-enabled(int, bool);
    callback remove-selection(int);
    callback reorder(int, float);
    callback save-preset(int, string);
    callback load-preset(int, string);
    callback delete-preset(int, string);
    callback query-presets(int) -> [string];
    in-out property <[string]> preset-names;
    private property <bool> drag-active: false;
    private property <bool> drag-threshold-crossed: false;
    private property <length> drag-y: 0px;
    height: 34px;
    background: root.effect.selected ? AppTheme.selection-background : effect-touch.has-hover ? AppTheme.hover-background : transparent;
    border-width: root.effect.selected ? 1px : 0px;
    border-color: AppTheme.accent;
    border-radius: AppTheme.control-radius;
    animate background { duration: 120ms; }

    effect-menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: root.selected-count > 1
                    ? @tr("Delete {} selected items", root.selected-count)
                    : @tr("Delete");
                enabled: root.selected-removable;
                activated => { root.remove-selection(root.effect.index); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Save Preset...");
                activated => { root.save-preset(root.effect.index, root.effect.name); }
            }
            Menu {
                title: @tr("Load Preset");
                enabled: root.preset-names.length > 0;
                for preset in root.preset-names : MenuItem {
                    title: preset;
                    activated => { root.load-preset(root.effect.index, preset); }
                }
            }
            Menu {
                title: @tr("Delete Preset");
                enabled: root.preset-names.length > 0;
                for preset in root.preset-names : MenuItem {
                    title: preset;
                    activated => { root.delete-preset(root.effect.index, preset); }
                }
            }
        }
        HorizontalLayout {
            padding-left: 7px;
            padding-right: 5px;
            spacing: 6px;
            Text {
                text: "☷";
                color: AppTheme.muted-foreground;
                vertical-alignment: center;
            }
            CheckBox {
                checked: root.effect.enabled;
                accessible-label: root.effect.name + @tr(": enabled");
                toggled => { root.set-enabled(root.effect.index, self.checked); }
            }
            Text {
                text: root.effect.name;
                color: AppTheme.foreground;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
        effect-touch := TouchArea {
            x: 53px;
            width: max(parent.width - self.x, 1px);
            mouse-cursor: pointer;
            accessible-role: list-item;
            accessible-label: root.effect.name;
            accessible-item-selectable: true;
            accessible-item-selected: root.effect.selected;
            accessible-action-default => { root.activate(root.effect.index, false, false); }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.activate(
                        root.effect.index,
                        event.modifiers.control || event.modifiers.meta,
                        event.modifiers.shift
                    );
                }
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    root.context-activate(root.effect.index);
                    root.preset-names = root.query-presets(root.effect.index);
                    effect-menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
        }
    }
    drag-touch := TouchArea {
        width: 27px;
        mouse-cursor: move;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag-active = true;
                root.drag-threshold-crossed = false;
                root.drag-y = 0px;
            }
            if event.kind == PointerEventKind.move && root.drag-active {
                root.drag-y = self.mouse-y - self.pressed-y;
                if abs(root.drag-y) >= 3px {
                    root.drag-threshold-crossed = true;
                }
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.drag-active {
                if root.drag-threshold-crossed {
                    root.reorder(root.effect.index, root.drag-y / 1px);
                }
                root.drag-active = false;
                root.drag-threshold-crossed = false;
                root.drag-y = 0px;
            }
            if event.kind == PointerEventKind.cancel {
                root.drag-active = false;
                root.drag-threshold-crossed = false;
                root.drag-y = 0px;
            }
        }
    }
}

component ObjectSettingRow inherits Rectangle {
    in property <ObjectSettingRowData> row-data;
    callback activate-effect(bool, int);
    callback set-effect-enabled(bool, int, bool);
    callback remove-effect(bool, int);
    callback set-text(bool, int, string, int, string);
    callback set-number(bool, int, string, int, float);
    callback set-start-number(int, string, int, int, float);
    callback set-bool(bool, int, string, int, bool);
    callback set-option(bool, int, string, int, int);
    callback pick-path(bool, int, string, int, string, string, string);
    callback pick-color(bool, int, string, int, string);
    callback pick-font(bool, int, string, int, string);
    callback seek-keyframe(int);
    callback snap-keyframe(float) -> int;
    callback seed-keyframes(bool, int, string);
    callback add-keyframe(bool, int, string, int);
    callback remove-keyframe(bool, int, string, int);
    callback move-keyframe(bool, int, string, int, int);
    callback open-easing(int, string, int, int);
    height: root.row-data.row-kind == "effect" ? 34px
        : root.row-data.row-kind == "header" ? 28px
        : root.row-data.row-kind == "text" ? 68px
        : root.row-data.row-kind == "keyframes" ? 20px
        : 34px;
    background: root.row-data.row-kind == "effect"
        ? (root.row-data.selected ? AppTheme.selection-background : AppTheme.raised-background)
        : transparent;
    border-width: root.row-data.row-kind == "effect" ? 1px : 0px;
    border-color: root.row-data.selected ? AppTheme.accent : AppTheme.border;

    if root.row-data.row-kind == "effect" : Rectangle {
        Rectangle {
            width: 100%;
            height: 1px;
            background: AppTheme.border;
        }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 6px;
            spacing: 7px;
            Text {
                text: root.row-data.label;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Button {
                height: 26px;
                text: @tr("Delete");
                visible: root.row-data.removable;
                enabled: root.row-data.removable;
                clicked => {
                    root.remove-effect(root.row-data.audio-plugin, root.row-data.effect-index);
                }
            }
        }
        TouchArea {
            x: 8px;
            width: max(parent.width - 82px, 1px);
            mouse-cursor: pointer;
            accessible-role: list-item;
            accessible-label: root.row-data.label;
            accessible-item-selectable: true;
            accessible-item-selected: root.row-data.selected;
            accessible-action-default => {
                root.activate-effect(root.row-data.audio-plugin, root.row-data.effect-index);
            }
            clicked => {
                root.activate-effect(root.row-data.audio-plugin, root.row-data.effect-index);
            }
        }
    }

    if root.row-data.row-kind == "header" : HorizontalLayout {
        padding-left: 5px;
        padding-top: 7px;
        Text {
            text: root.row-data.label;
            font-weight: 700;
            color: AppTheme.muted-foreground;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; height: 1px; background: AppTheme.border; }
    }

    if root.row-data.row-kind == "boolean" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        CheckBox {
            text: root.row-data.label;
            checked: root.row-data.checked;
            enabled: root.row-data.interactive;
            toggled => {
                root.set-bool(
                    root.row-data.audio-plugin,
                    root.row-data.effect-index,
                    root.row-data.param-name,
                    root.row-data.start-frame,
                    self.checked
                );
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.row-data.keyframed : Text { text: "KF"; color: AppTheme.warning; vertical-alignment: center; }
    }

    if root.row-data.row-kind == "number" || root.row-data.row-kind == "integer" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        Slider {
            height: 26px;
            horizontal-stretch: 1;
            value: root.row-data.number-value;
            minimum: root.row-data.minimum;
            maximum: root.row-data.maximum;
            step: root.row-data.step;
            enabled: root.row-data.interactive;
            changed(value) => {
                if root.row-data.audio-plugin {
                    root.set-number(
                        true,
                        root.row-data.effect-index,
                        root.row-data.param-name,
                        root.row-data.start-frame,
                        value
                    );
                } else {
                    root.set-start-number(
                        root.row-data.effect-index,
                        root.row-data.param-name,
                        root.row-data.start-frame,
                        root.row-data.end-frame,
                        value
                    );
                }
            }
        }
        CommitLineEdit {
            width: 76px;
            height: 26px;
            source-text: root.row-data.text-value;
            enabled: root.row-data.interactive;
            horizontal-alignment: right;
            commit(value) => {
                root.set-text(
                    root.row-data.audio-plugin,
                    root.row-data.effect-index,
                    root.row-data.param-name,
                    root.row-data.start-frame,
                    value
                );
            }
        }
        Button {
            visible: !root.row-data.audio-plugin;
            width: 150px;
            height: 26px;
            text: root.row-data.parameter-button-label;
            enabled: root.row-data.interactive;
            clicked => {
                root.open-easing(
                    root.row-data.effect-index,
                    root.row-data.param-name,
                    root.row-data.start-frame,
                    root.row-data.end-frame
                );
            }
        }
        Button {
            visible: root.row-data.audio-plugin;
            height: 26px;
            text: "K";
            enabled: root.row-data.interactive;
            accessible-label: root.row-data.label + @tr(": create keyframes at the start and end");
            clicked => {
                root.seed-keyframes(
                    root.row-data.audio-plugin,
                    root.row-data.effect-index,
                    root.row-data.param-name
                );
            }
        }
        if !root.row-data.audio-plugin : CommitLineEdit {
            width: 76px;
            height: 26px;
            source-text: root.row-data.right-interactive
                ? root.row-data.end-text-value
                : root.row-data.text-value;
            enabled: root.row-data.interactive && root.row-data.right-interactive;
            opacity: root.row-data.right-interactive ? 1 : 0.45;
            horizontal-alignment: right;
            commit(value) => {
                root.set-text(
                    root.row-data.audio-plugin,
                    root.row-data.effect-index,
                    root.row-data.param-name,
                    root.row-data.end-frame,
                    value
                );
            }
        }
        if !root.row-data.audio-plugin : Slider {
            height: 26px;
            horizontal-stretch: 1;
            value: root.row-data.right-interactive
                ? root.row-data.end-number-value
                : root.row-data.number-value;
            minimum: root.row-data.minimum;
            maximum: root.row-data.maximum;
            step: root.row-data.step;
            enabled: root.row-data.interactive && root.row-data.right-interactive;
            opacity: root.row-data.right-interactive ? 1 : 0.45;
            changed(value) => {
                root.set-number(
                    root.row-data.audio-plugin,
                    root.row-data.effect-index,
                    root.row-data.param-name,
                    root.row-data.end-frame,
                    value
                );
            }
        }
        Text { text: root.row-data.unit; visible: root.row-data.unit != ""; vertical-alignment: center; }
        if root.row-data.keyframed : Text { text: "KF"; color: AppTheme.warning; vertical-alignment: center; }
    }

    if root.row-data.row-kind == "choice" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        Text { text: root.row-data.label; width: 135px; overflow: elide; vertical-alignment: center; }
        ComboBox {
            width: 220px;
            height: 26px;
            model: root.row-data.option-labels;
            current-index: root.row-data.selected-option;
            enabled: root.row-data.interactive;
            selected(value) => {
                root.set-option(
                    root.row-data.audio-plugin,
                    root.row-data.effect-index,
                    root.row-data.param-name,
                    root.row-data.start-frame,
                    self.current-index
                );
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.row-data.keyframed : Text { text: "KF"; color: AppTheme.warning; vertical-alignment: center; }
    }

    if root.row-data.row-kind == "text" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        Text { text: root.row-data.label; width: 105px; overflow: elide; vertical-alignment: top; }
        CommitTextEdit {
            height: 62px;
            horizontal-stretch: 1;
            source-text: root.row-data.text-value;
            enabled: root.row-data.interactive;
            commit(value) => {
                root.set-text(
                    root.row-data.audio-plugin,
                    root.row-data.effect-index,
                    root.row-data.param-name,
                    root.row-data.start-frame,
                    value
                );
            }
        }
        if root.row-data.keyframed : Text { text: "KF"; color: AppTheme.warning; vertical-alignment: top; }
    }

    if root.row-data.row-kind == "path" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        Text { text: root.row-data.label; width: 105px; overflow: elide; vertical-alignment: center; }
        CommitLineEdit {
            height: 26px;
            horizontal-stretch: 1;
            source-text: root.row-data.text-value;
            enabled: root.row-data.interactive;
            commit(value) => {
                root.set-text(
                    root.row-data.audio-plugin,
                    root.row-data.effect-index,
                    root.row-data.param-name,
                    root.row-data.start-frame,
                    value
                );
            }
        }
        Button {
            height: 26px;
            text: "...";
            enabled: root.row-data.interactive;
            accessible-label: root.row-data.label + @tr(": select");
            clicked => {
                root.pick-path(
                    root.row-data.audio-plugin,
                    root.row-data.effect-index,
                    root.row-data.param-name,
                    root.row-data.start-frame,
                    root.row-data.text-value,
                    root.row-data.filter,
                    root.row-data.label
                );
            }
        }
    }

    if root.row-data.row-kind == "font" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        Text { text: root.row-data.label; width: 105px; overflow: elide; vertical-alignment: center; }
        Button {
            horizontal-stretch: 1;
            height: 26px;
            text: root.row-data.text-value == "" ? @tr("Default") : root.row-data.text-value;
            enabled: root.row-data.interactive;
            accessible-label: root.row-data.label + ": " + self.text;
            clicked => {
                root.pick-font(
                    root.row-data.audio-plugin,
                    root.row-data.effect-index,
                    root.row-data.param-name,
                    root.row-data.start-frame,
                    root.row-data.text-value
                );
            }
        }
        Text {
            text: "Aa";
            width: 36px;
            font-family: root.row-data.text-value;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.row-data.row-kind == "color" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        Text { text: root.row-data.label; width: 105px; overflow: elide; vertical-alignment: center; }
        Rectangle {
            width: 52px;
            height: 26px;
            background: root.row-data.color-value;
            border-width: 1px;
            border-color: start-color-touch.has-hover ? AppTheme.accent : AppTheme.border;
            border-radius: 3px;
            start-color-touch := TouchArea {
                enabled: root.row-data.interactive;
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: root.row-data.label + @tr(": select start color");
                accessible-action-default => {
                    root.pick-color(
                        root.row-data.audio-plugin,
                        root.row-data.effect-index,
                        root.row-data.param-name,
                        root.row-data.start-frame,
                        root.row-data.text-value
                    );
                }
                clicked => {
                    root.pick-color(
                        root.row-data.audio-plugin,
                        root.row-data.effect-index,
                        root.row-data.param-name,
                        root.row-data.start-frame,
                        root.row-data.text-value
                    );
                }
            }
        }
        CommitLineEdit {
            width: 82px;
            height: 26px;
            source-text: root.row-data.text-value;
            enabled: root.row-data.interactive;
            horizontal-alignment: center;
            commit(value) => {
                root.set-text(
                    root.row-data.audio-plugin,
                    root.row-data.effect-index,
                    root.row-data.param-name,
                    root.row-data.start-frame,
                    value
                );
            }
        }
        Button {
            visible: !root.row-data.audio-plugin;
            height: 26px;
            text: root.row-data.keyframed ? root.row-data.interpolation : @tr("Interpolation");
            enabled: root.row-data.interactive;
            clicked => {
                root.open-easing(
                    root.row-data.effect-index,
                    root.row-data.param-name,
                    root.row-data.start-frame,
                    root.row-data.end-frame
                );
            }
        }
        if root.row-data.range-mode : Text { text: "→"; vertical-alignment: center; }
        if root.row-data.range-mode : CommitLineEdit {
            width: 82px;
            height: 26px;
            source-text: root.row-data.end-text-value;
            enabled: root.row-data.interactive
                && root.row-data.interpolation != ""
                && root.row-data.interpolation != "constant";
            commit(value) => {
                root.set-text(
                    root.row-data.audio-plugin,
                    root.row-data.effect-index,
                    root.row-data.param-name,
                    root.row-data.end-frame,
                    value
                );
            }
        }
        if root.row-data.range-mode : Rectangle {
            width: 52px;
            height: 26px;
            background: root.row-data.end-color-value;
            opacity: root.row-data.interactive
                && root.row-data.interpolation != ""
                && root.row-data.interpolation != "constant" ? 1 : 0.45;
            border-width: 1px;
            border-color: end-color-touch.has-hover ? AppTheme.accent : AppTheme.border;
            border-radius: 3px;
            end-color-touch := TouchArea {
                enabled: root.row-data.interactive
                    && root.row-data.interpolation != ""
                    && root.row-data.interpolation != "constant";
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: root.row-data.label + @tr(": select end color");
                accessible-action-default => {
                    root.pick-color(
                        root.row-data.audio-plugin,
                        root.row-data.effect-index,
                        root.row-data.param-name,
                        root.row-data.end-frame,
                        root.row-data.end-text-value
                    );
                }
                clicked => {
                    root.pick-color(
                        root.row-data.audio-plugin,
                        root.row-data.effect-index,
                        root.row-data.param-name,
                        root.row-data.end-frame,
                        root.row-data.end-text-value
                    );
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.row-data.keyframed : Text { text: "KF"; color: AppTheme.warning; vertical-alignment: center; }
    }

    if root.row-data.row-kind == "keyframes" : KeyframeTrack {
        row-data: root.row-data;
        seek(frame) => { root.seek-keyframe(frame); }
        snap(frame) => { root.snap-keyframe(frame) }
        add(index, param, frame) => {
            root.add-keyframe(root.row-data.audio-plugin, index, param, frame);
        }
        remove(index, param, frame) => {
            root.remove-keyframe(root.row-data.audio-plugin, index, param, frame);
        }
        move-keyframe(index, param, old-frame, new-frame) => {
            root.move-keyframe(root.row-data.audio-plugin, index, param, old-frame, new-frame);
        }
    }

    if root.row-data.row-kind == "unsupported" : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 7px;
        Text { text: root.row-data.label; width: 135px; overflow: elide; vertical-alignment: center; }
        Text { text: root.row-data.text-value; color: AppTheme.muted-foreground; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
    }
}

component TabCloseButton inherits Rectangle {
    in property <string> accessible-name;
    callback clicked();
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background: close-touch.has-hover ? AppTheme.hover-background : transparent;
    animate background { duration: 150ms; }

    Text {
        text: "×";
        color: close-touch.has-hover ? AppTheme.foreground : AppTheme.muted-foreground;
        font-size: 1rem;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    close-touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.accessible-name;
        accessible-action-default => { root.clicked(); }
        clicked => { root.clicked(); }
    }
}

component TabAddButton inherits Rectangle {
    in property <string> accessible-name;
    callback clicked();
    width: 40px;
    height: 100%;
    background: add-touch.has-hover ? AppTheme.hover-background : transparent;
    animate background { duration: 150ms; }

    Text {
        text: "+";
        color: add-touch.has-hover ? AppTheme.accent : AppTheme.foreground;
        font-size: 1.15rem;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    add-touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.accessible-name;
        accessible-action-default => { root.clicked(); }
        clicked => { root.clicked(); }
    }
}

component TransportButton inherits Rectangle {
    in property <string> icon;
    in property <string> accessible-name;
    in property <string> help-text;
    in property <bool> active: false;
    private property <brush> icon-color: transport-touch.has-hover || root.active ? AppTheme.accent : AppTheme.foreground;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: AppTheme.control-radius;
    background: root.active
        ? AppTheme.selection-background
        : transport-touch.has-hover
            ? AppTheme.hover-background
            : transparent;
    animate background { duration: 120ms; }

    if root.icon == "previous" : Path {
        x: 8px;
        y: 8px;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 11 3 L 5 8 L 11 13";
        stroke: root.icon-color;
        stroke-width: 2px;
    }
    if root.icon == "play" : Path {
        x: 8px;
        y: 8px;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 5 3 L 13 8 L 5 13 Z";
        fill: root.icon-color;
    }
    if root.icon == "pause" : Path {
        x: 8px;
        y: 8px;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 4 3 L 7 3 L 7 13 L 4 13 Z M 9 3 L 12 3 L 12 13 L 9 13 Z";
        fill: root.icon-color;
    }
    if root.icon == "next" : Path {
        x: 8px;
        y: 8px;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 5 3 L 11 8 L 5 13";
        stroke: root.icon-color;
        stroke-width: 2px;
    }
    transport-touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.accessible-name;
        accessible-description: root.help-text;
        accessible-action-default => { root.clicked(); }
        clicked => { root.clicked(); }
    }
}

component SceneTab inherits Rectangle {
    in property <SceneTabData> scene;
    callback activate(int);
    callback close(int);
    callback settings(int);
    preferred-width: 100px;
    min-width: 100px;
    max-width: 220px;
    horizontal-stretch: 0;
    height: 28px;
    background: root.scene.selected ? AppTheme.panel-background : scene-touch.has-hover ? AppTheme.hover-background : transparent;
    border-width: root.scene.selected ? 1px : 0px;
    border-color: AppTheme.subtle-border;
    border-radius: AppTheme.control-radius;
    animate background { duration: 150ms; }

    HorizontalLayout {
        padding-left: AppTheme.spacing-md;
        padding-right: AppTheme.spacing-xs;
        spacing: AppTheme.spacing-xs;
        Text {
            text: root.scene.name;
            color: AppTheme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if !root.scene.root : TabCloseButton {
            accessible-name: @tr("Close scene");
            clicked => { root.close(root.scene.id); }
        }
    }
    scene-touch := TouchArea {
        width: root.scene.root ? parent.width : parent.width - 28px;
        mouse-cursor: pointer;
        accessible-role: tab;
        accessible-label: root.scene.name;
        accessible-item-selectable: true;
        accessible-item-selected: root.scene.selected;
        accessible-action-default => { root.activate(root.scene.id); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.activate(root.scene.id);
            }
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.settings(root.scene.id);
            }
        }
    }
}

component LayerHeaderItem inherits Rectangle {
    in property <LayerData> layer;
    callback activate(int);
    callback command(string, int);
    callback scroll-requested(length) -> bool;
    height: 30px;
    background: root.layer.selected ? AppTheme.selection-background : header-touch.has-hover ? AppTheme.hover-background : AppTheme.panel-background;
    border-width: 0px;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        spacing: 4px;
        Text {
            text: root.layer.visible ? "●" : "○";
            color: root.layer.visible ? AppTheme.success : AppTheme.muted-foreground;
            vertical-alignment: center;
        }
        Text {
            text: root.layer.index + 1;
            color: AppTheme.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.layer.locked ? "L" : "";
            color: AppTheme.warning;
            vertical-alignment: center;
        }
    }
    layer-menu := ContextMenuArea {
        Menu {
            MenuItem { title: @tr("Insert Layer Above (1 row)"); activated => { root.command("insert-above", root.layer.index); } }
            MenuItem { title: @tr("Insert Layer Below (1 row)"); activated => { root.command("insert-below", root.layer.index); } }
            MenuItem { title: @tr("Insert multiple layers..."); activated => { root.command("insert-many", root.layer.index); } }
            MenuSeparator { }
            MenuItem { title: @tr("Move layer contents down by 1"); activated => { root.command("shift-down", root.layer.index); } }
            MenuItem { title: @tr("Move layer contents up by 1"); activated => { root.command("shift-up", root.layer.index); } }
            MenuItem { title: @tr("Move layers by range..."); activated => { root.command("shift-range", root.layer.index); } }
            MenuSeparator { }
            MenuItem { title: root.layer.visible ? @tr("Hide this layer") : @tr("Show this layer"); activated => { root.command("toggle-visible", root.layer.index); } }
            MenuItem { title: root.layer.locked ? @tr("Unlock this layer") : @tr("Lock this layer"); activated => { root.command("toggle-lock", root.layer.index); } }
            MenuSeparator { }
            MenuItem { title: @tr("Show all layers"); activated => { root.command("show-all", root.layer.index); } }
            MenuItem { title: @tr("Hide all layers"); activated => { root.command("hide-all", root.layer.index); } }
        }
        header-touch := TouchArea {
            mouse-cursor: pointer;
            accessible-role: list-item;
            accessible-label: @tr("Layer {}", root.layer.index + 1);
            accessible-description: root.layer.visible
                ? (root.layer.locked ? @tr("Visible, locked") : @tr("Visible, unlocked"))
                : (root.layer.locked ? @tr("Hidden, locked") : @tr("Hidden, unlocked"));
            accessible-item-selectable: true;
            accessible-item-selected: root.layer.selected;
            accessible-action-default => { root.activate(root.layer.index); }
            scroll-event(event) => {
                if root.scroll-requested(event.delta-y) { accept } else { reject }
            }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.activate(root.layer.index);
                }
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    layer-menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: AppTheme.subtle-border;
    }
}

component TimelineContextRow inherits Rectangle {
    in property <string> title;
    in property <bool> enabled: true;
    callback activated();
    height: 30px;
    border-radius: AppTheme.control-radius;
    background: !root.enabled ? transparent : row-touch.has-hover ? AppTheme.hover-background : transparent;
    animate background { duration: 120ms; }

    Text {
        x: 9px;
        width: parent.width - 18px;
        text: root.title;
        color: root.enabled ? AppTheme.foreground : AppTheme.muted-foreground;
        overflow: elide;
        vertical-alignment: center;
    }
    row-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.title;
        accessible-action-default => { root.activated(); }
        clicked => { root.activated(); }
    }
}

component TimelineClipItem inherits Rectangle {
    in property <TimelineClipData> clip-data;
    in property <float> pixels-per-frame: 1;
    in property <length> track-height: 30px;
    in property <length> resize-handle-width: 10px;
    callback activate(int, bool);
    callback prepare-drag(int, bool);
    callback context-activate(int, float, float);
    callback open-settings(int);
    callback command(string, int, int, int);
    callback seek-audio-frame(int, int);
    callback drag-finished(string, int, float, float, bool);
    callback pointer-hovered(float, float, bool);
    callback pointer-left();
    callback scroll-requested(length, length, length, bool, bool, bool) -> bool;
    private property <string> active-drag: "";
    private property <length> drag-x: 0px;
    private property <length> drag-y: 0px;
    private property <bool> threshold-crossed: false;
    private property <bool> drag-additive: false;
    min-width: 8px;
    height: 24px;
    background: transparent;

    function frame-delta(delta: length) -> length {
        let frame-width = max(root.pixels-per-frame * 1px, 0.05px);
        return round(delta / frame-width) * frame-width;
    }

    function layer-delta(delta: length) -> length {
        return round(delta / max(root.track-height, 1px)) * max(root.track-height, 1px);
    }

    clip-visual := Rectangle {
        x: root.active-drag == "move" ? root.drag-x : root.active-drag == "trim-start" ? root.drag-x : 0px;
        y: root.active-drag == "move" ? root.drag-y : 0px;
        width: root.active-drag == "trim-start"
            ? max(root.width - root.drag-x, 8px)
            : root.active-drag == "trim-end"
                ? max(root.width + root.drag-x, 8px)
                : root.width;
        height: root.height;
        border-radius: AppTheme.control-radius;
        background: root.clip-data.primary ? AppTheme.clip-selected : root.clip-data.selected ? AppTheme.clip-selected : clip-touch.has-hover ? AppTheme.clip-hover : AppTheme.clip;
        border-width: root.clip-data.primary ? 2px : root.clip-data.selected ? 1px : 0px;
        border-color: AppTheme.accent-foreground;
        animate background { duration: 120ms; }
        HorizontalLayout {
            padding-left: 7px;
            padding-right: 7px;
            Text {
                text: root.clip-data.label;
                color: white;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
    clip-touch := TouchArea {
            x: min(root.resize-handle-width, parent.width / 2);
            width: max(parent.width - 2 * root.resize-handle-width, 1px);
            mouse-cursor: move;
            accessible-role: list-item;
            accessible-label: root.clip-data.label;
            accessible-description: @tr("Clip: {}, layer {}, starts at frame {} for {} frames",
                root.clip-data.label,
                root.clip-data.layer + 1,
                root.clip-data.start,
                root.clip-data.duration
            );
            accessible-item-selectable: true;
            accessible-item-selected: root.clip-data.selected;
            accessible-action-default => { root.activate(root.clip-data.id, false); }
            scroll-event(event) => {
                if root.scroll-requested(
                    event.delta-x,
                    event.delta-y,
                    root.x + self.mouse-x,
                    event.modifiers.alt,
                    event.modifiers.control,
                    event.modifiers.shift
                ) { accept } else { reject }
            }
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.pointer-hovered(
                        (root.x + self.mouse-x) / 1px,
                        (root.y + self.mouse-y) / 1px,
                        event.modifiers.shift
                    );
                }
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.active-drag = "move";
                    root.drag-x = 0px;
                    root.drag-y = 0px;
                    root.threshold-crossed = false;
                    root.drag-additive = event.modifiers.control || event.modifiers.meta;
                    if root.clip-data.audio {
                        root.seek-audio-frame(root.clip-data.id, round((root.x + self.mouse-x) / (1px * root.pixels-per-frame)));
                    }
                }
                if event.kind == PointerEventKind.move && root.active-drag == "move" {
                    root.drag-x = root.frame-delta(self.mouse-x - self.pressed-x);
                    root.drag-y = root.layer-delta(self.mouse-y - self.pressed-y);
                    if !root.threshold-crossed && (abs(root.drag-x) >= 3px || abs(root.drag-y) >= 3px) {
                        root.threshold-crossed = true;
                        root.prepare-drag(root.clip-data.id, root.drag-additive);
                    }
                }
                if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.active-drag == "move" {
                    if root.threshold-crossed {
                        root.drag-finished("move", root.clip-data.id, root.drag-x / 1px, root.drag-y / 1px, event.modifiers.shift);
                    } else {
                        root.activate(root.clip-data.id, root.drag-additive);
                    }
                    root.active-drag = "";
                    root.drag-x = 0px;
                    root.drag-y = 0px;
                    root.threshold-crossed = false;
                    root.drag-additive = false;
                }
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    root.context-activate(
                        root.clip-data.id,
                        (root.absolute-position.x + self.mouse-x) / 1px,
                        (root.absolute-position.y + self.mouse-y) / 1px
                    );
                }
                if event.kind == PointerEventKind.cancel {
                    root.active-drag = "";
                    root.drag-x = 0px;
                    root.drag-y = 0px;
                    root.threshold-crossed = false;
                    root.drag-additive = false;
                }
            }
            changed has-hover => { if !self.has-hover { root.pointer-left(); } }
            double-clicked => { root.open-settings(root.clip-data.id); }
    }
    trim-start-touch := TouchArea {
        x: 0px;
        width: min(root.resize-handle-width, parent.width / 2);
        mouse-cursor: ew-resize;
        scroll-event(event) => {
            if root.scroll-requested(
                event.delta-x,
                event.delta-y,
                root.x + self.mouse-x,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.shift
            ) { accept } else { reject }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.pointer-hovered(
                    (root.x + self.mouse-x) / 1px,
                    (root.y + self.mouse-y) / 1px,
                    event.modifiers.shift
                );
            }
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.active-drag = "trim-start";
                root.drag-x = 0px;
                root.drag-y = 0px;
                root.threshold-crossed = true;
                root.prepare-drag(root.clip-data.id, event.modifiers.control || event.modifiers.meta);
            }
            if event.kind == PointerEventKind.move && root.active-drag == "trim-start" {
                root.drag-x = root.frame-delta(self.mouse-x - self.pressed-x);
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.active-drag == "trim-start" {
                root.drag-finished("trim-start", root.clip-data.id, root.drag-x / 1px, 0, event.modifiers.shift);
                root.active-drag = "";
                root.drag-x = 0px;
                root.threshold-crossed = false;
            }
            if event.kind == PointerEventKind.cancel {
                root.active-drag = "";
                root.drag-x = 0px;
                root.threshold-crossed = false;
            }
        }
        changed has-hover => { if !self.has-hover { root.pointer-left(); } }
    }
    trim-end-touch := TouchArea {
        x: parent.width - self.width;
        width: min(root.resize-handle-width, parent.width / 2);
        mouse-cursor: ew-resize;
        scroll-event(event) => {
            if root.scroll-requested(
                event.delta-x,
                event.delta-y,
                root.x + self.mouse-x,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.shift
            ) { accept } else { reject }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.pointer-hovered(
                    (root.x + self.mouse-x) / 1px,
                    (root.y + self.mouse-y) / 1px,
                    event.modifiers.shift
                );
            }
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.active-drag = "trim-end";
                root.drag-x = 0px;
                root.drag-y = 0px;
                root.threshold-crossed = true;
                root.prepare-drag(root.clip-data.id, event.modifiers.control || event.modifiers.meta);
            }
            if event.kind == PointerEventKind.move && root.active-drag == "trim-end" {
                root.drag-x = root.frame-delta(self.mouse-x - self.pressed-x);
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.active-drag == "trim-end" {
                root.drag-finished("trim-end", root.clip-data.id, root.drag-x / 1px, 0, event.modifiers.shift);
                root.active-drag = "";
                root.drag-x = 0px;
                root.threshold-crossed = false;
            }
            if event.kind == PointerEventKind.cancel {
                root.active-drag = "";
                root.drag-x = 0px;
                root.threshold-crossed = false;
            }
        }
        changed has-hover => { if !self.has-hover { root.pointer-left(); } }
    }
}

component ProjectTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <length> tab-height: 28px;
    callback activate();
    callback close();
    preferred-width: 120px;
    min-width: 120px;
    max-width: 240px;
    horizontal-stretch: 0;
    height: root.tab-height;
    background: root.selected ? AppTheme.panel-background : tab-touch.has-hover ? AppTheme.hover-background : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: AppTheme.subtle-border;
    border-radius: AppTheme.control-radius;
    animate background { duration: 150ms; }

    HorizontalLayout {
        padding-left: AppTheme.spacing-md;
        padding-right: AppTheme.spacing-xs;
        spacing: AppTheme.spacing-xs;
        Text {
            text: root.label;
            color: AppTheme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        close-button := TabCloseButton {
            accessible-name: @tr("Close project");
            clicked => { root.close(); }
        }
    }
    tab-touch := TouchArea {
        width: parent.width - close-button.width - 4px;
        mouse-cursor: pointer;
        accessible-role: tab;
        accessible-label: root.label;
        accessible-item-selectable: true;
        accessible-item-selected: root.selected;
        accessible-action-default => { root.activate(); }
        clicked => { root.activate(); }
    }
}

export component ProjectRecoveryWindow inherits Window {
    title: @tr("Recover unsaved projects");
    preferred-width: 660px;
    preferred-height: 440px;
    min-width: 520px;
    min-height: 320px;
    background: AppTheme.window-background;

    in property <[RecoveryEntryData]> recoveries;
    in-out property <string> error-message: "";
    in-out property <bool> discard-confirmation-visible: false;
    private property <string> pending-discard-id: "";
    private property <string> pending-discard-name: "";
    callback recover-project(string);
    callback discard-recovery(string);
    callback close-window();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: @tr("AviQtl found recovery snapshots left by an interrupted session. Recovering opens a new unsaved project and never overwrites the original file.");
            color: AppTheme.foreground;
            wrap: word-wrap;
        }
        if root.error-message != "" : Text {
            text: root.error-message;
            color: AppTheme.warning;
            font-weight: 700;
            wrap: word-wrap;
        }
        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            viewport-height: recovery-list.preferred-height;

            recovery-list := VerticalLayout {
                width: parent.width;
                spacing: 8px;

                for recovery in root.recoveries : Rectangle {
                    height: 92px;
                    background: AppTheme.raised-background;
                    border-width: 1px;
                    border-color: AppTheme.border;
                    border-radius: 4px;

                    HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;

                        VerticalLayout {
                            spacing: 3px;
                            horizontal-stretch: 1;
                            Text {
                                text: recovery.name;
                                color: AppTheme.foreground;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: recovery.valid
                                    ? @tr("Saved {}", recovery.saved-at)
                                    : @tr("Invalid recovery: {}", recovery.error);
                                color: recovery.valid ? AppTheme.muted-foreground : AppTheme.warning;
                                overflow: elide;
                            }
                            Text {
                                text: recovery.original-project-url;
                                visible: recovery.original-project-url != "";
                                color: AppTheme.muted-foreground;
                                font-size: 0.72rem;
                                overflow: elide;
                            }
                        }
                        Button {
                            text: @tr("Recover");
                            enabled: recovery.valid;
                            clicked => {
                                root.error-message = "";
                                root.recover-project(recovery.id);
                            }
                        }
                        Button {
                            text: @tr("Discard");
                            clicked => {
                                root.pending-discard-id = recovery.id;
                                root.pending-discard-name = recovery.name;
                                root.discard-confirmation-visible = true;
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: @tr("Close");
                clicked => { root.close-window(); }
            }
        }
    }

    if root.discard-confirmation-visible : Rectangle {
        z: 1000;
        width: 100%;
        height: 100%;
        background: AppTheme.scrim;

        TouchArea { }

        Rectangle {
            width: min(parent.width - 32px, 470px);
            height: 160px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: AppTheme.raised-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 6px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: @tr("Discard recovery snapshot");
                    color: AppTheme.foreground;
                    font-size: 1.15rem;
                    font-weight: 700;
                }
                Text {
                    text: @tr("Discard the recovery snapshot for “{}”? This cannot be undone.", root.pending-discard-name);
                    color: AppTheme.muted-foreground;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: @tr("Yes");
                        clicked => {
                            root.discard-recovery(root.pending-discard-id);
                            root.pending-discard-id = "";
                            root.pending-discard-name = "";
                            root.discard-confirmation-visible = false;
                        }
                    }
                    Button {
                        text: @tr("No");
                        clicked => {
                            root.pending-discard-id = "";
                            root.pending-discard-name = "";
                            root.discard-confirmation-visible = false;
                        }
                    }
                }
            }
        }
    }
}

export component ProjectLauncherWindow inherits Window {
    title: @tr("AviQtl Plus - Project Launcher");
    preferred-width: 700px;
    preferred-height: 500px;
    min-width: 620px;
    min-height: 420px;
    background: AppTheme.window-background;

    in-out property <string> default-width: "1920";
    in-out property <string> default-height: "1080";
    in-out property <string> default-fps: "60";
    in-out property <string> default-sample-rate: "48000";
    callback create-project(string, string, string, string);
    callback open-project();

    HorizontalLayout {
        padding: AppTheme.spacing-xl;
        spacing: AppTheme.spacing-xl;

        VerticalLayout {
            min-width: 280px;
            horizontal-stretch: 1;
            spacing: AppTheme.spacing-md;
            Text {
                text: @tr("New Project");
                color: AppTheme.foreground;
                font-size: 1.2rem;
                font-weight: 600;
            }
            GroupBox {
                title: @tr("Project Settings");
                height: 220px;
                vertical-stretch: 0;
                GridLayout {
                    padding: AppTheme.spacing-md;
                    spacing: AppTheme.spacing-sm;
                    Row { Text { text: @tr("launcher-width" => "Width:"); color: AppTheme.muted-foreground; vertical-alignment: center; } width-field := LineEdit { height: AppTheme.compact-control-height; text <=> root.default-width; accessible-label: @tr("launcher-width" => "Width:"); } }
                    Row { Text { text: @tr("launcher-height" => "Height:"); color: AppTheme.muted-foreground; vertical-alignment: center; } height-field := LineEdit { height: AppTheme.compact-control-height; text <=> root.default-height; accessible-label: @tr("launcher-height" => "Height:"); } }
                    Row { Text { text: @tr("Frame Rate (FPS):"); color: AppTheme.muted-foreground; vertical-alignment: center; } fps-field := LineEdit { height: AppTheme.compact-control-height; text <=> root.default-fps; accessible-label: @tr("Frame Rate (FPS):"); } }
                    Row { Text { text: @tr("Sample Rate:"); color: AppTheme.muted-foreground; vertical-alignment: center; } sample-rate-field := LineEdit { height: AppTheme.compact-control-height; text <=> root.default-sample-rate; accessible-label: @tr("Sample Rate:"); } }
                }
            }
            create-button := Button {
                text: @tr("Create New Project");
                primary: true;
                accessible-label: @tr("Create New Project");
                clicked => {
                    root.create-project(width-field.text, height-field.text, fps-field.text, sample-rate-field.text);
                }
            }
            Rectangle { vertical-stretch: 1; }
        }

        VerticalLayout {
            min-width: 240px;
            horizontal-stretch: 1;
            spacing: AppTheme.spacing-md;
            Text {
                text: @tr("Recent Projects");
                color: AppTheme.foreground;
                font-size: 1.2rem;
                font-weight: 600;
            }
            Rectangle {
                vertical-stretch: 1;
                background: AppTheme.panel-background;
                border-width: 1px;
                border-color: AppTheme.subtle-border;
                border-radius: AppTheme.surface-radius;
                Text {
                    text: @tr("No recent projects");
                    color: AppTheme.muted-foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Button {
                text: @tr("Open Existing Project...");
                clicked => { root.open-project(); }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: @tr("AviQtl Plus - Preview");
    preferred-width: 640px;
    preferred-height: 360px;
    min-width: 480px;
    min-height: 300px;
    background: AppTheme.window-background;
    forward-focus: main-shortcuts;

    in property <[ProjectTabData]> project-tabs;
    in property <[MissingMediaData]> missing-media;
    in property <int> current-project: -1;
    in property <image> preview-image;
    in-out property <float> playhead: 0;
    in property <float> duration: 3600;
    in property <bool> playing: false;
    in-out property <int> playback-speed-percent: 100;
    in property <string> status-text: "Ready";
    in property <bool> save-confirmation-visible: false;
    in property <string> save-confirmation-project: "";
    in-out property <bool> missing-media-dialog-visible: false;
    in property <int> project-tab-height: 28;

    callback new-project();
    callback open-project();
    callback save-project();
    callback save-project-as();
    callback export-media();
    callback quit-requested();
    callback undo();
    callback redo();
    callback show-project-settings();
    callback show-system-settings();
    callback show-timeline();
    callback show-object-settings();
    callback show-package-manager();
    callback show-about();
    callback relink-missing-media(int);
    callback select-project(int);
    callback close-project(int);
    callback confirm-save();
    callback confirm-discard();
    callback confirm-cancel();
    callback seek(float);
    callback previous-frame();
    callback toggle-playback();
    callback next-frame();
    callback playback-speed-changed(int);
    callback keyboard-shortcut(string, bool, bool, bool, bool) -> bool;

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("New Project"); enabled: !root.save-confirmation-visible; activated => { root.new-project(); } }
            MenuItem { title: @tr("Open Project"); enabled: !root.save-confirmation-visible; activated => { root.open-project(); } }
            MenuSeparator { }
            MenuItem { title: @tr("Save Project"); enabled: !root.save-confirmation-visible; activated => { root.save-project(); } }
            MenuItem { title: @tr("Save Project As..."); enabled: !root.save-confirmation-visible; activated => { root.save-project-as(); } }
            MenuItem {
                title: @tr("Manage Missing Media");
                enabled: !root.save-confirmation-visible && root.missing-media.length > 0;
                activated => { root.missing-media-dialog-visible = true; }
            }
            MenuSeparator { }
            MenuItem { title: @tr("Export Media..."); enabled: !root.save-confirmation-visible; activated => { root.export-media(); } }
            MenuSeparator { }
            MenuItem { title: @tr("Exit"); enabled: !root.save-confirmation-visible; activated => { root.quit-requested(); } }
        }
        Menu {
            title: @tr("Edit");
            MenuItem { title: @tr("Undo"); enabled: !root.save-confirmation-visible; activated => { root.undo(); } }
            MenuItem { title: @tr("Redo"); enabled: !root.save-confirmation-visible; activated => { root.redo(); } }
        }
        Menu {
            title: @tr("Settings");
            MenuItem { title: @tr("Project Settings"); enabled: !root.save-confirmation-visible; activated => { root.show-project-settings(); } }
            MenuSeparator { }
            MenuItem { title: @tr("Preferences"); enabled: !root.save-confirmation-visible; activated => { root.show-system-settings(); } }
        }
        Menu {
            title: @tr("View");
            MenuItem { title: @tr("Show Timeline"); enabled: !root.save-confirmation-visible; activated => { root.show-timeline(); } }
            MenuItem { title: @tr("Show Settings Dialog"); enabled: !root.save-confirmation-visible; activated => { root.show-object-settings(); } }
        }
        Menu {
            title: @tr("Tools");
            MenuItem { title: @tr("Package Manager"); enabled: !root.save-confirmation-visible; activated => { root.show-package-manager(); } }
            MenuSeparator { }
            MenuItem { title: @tr("About"); enabled: !root.save-confirmation-visible; activated => { root.show-about(); } }
        }
    }

    main-shortcuts := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if !root.save-confirmation-visible && root.keyboard-shortcut(
                event.text,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.meta
            ) {
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            spacing: 0px;
            Rectangle {
            height: root.project-tab-height * 1px;
            background: AppTheme.raised-background;
            HorizontalLayout {
                spacing: 0px;
                accessible-role: tab-list;
                accessible-label: @tr("Project");
                for tab[index] in root.project-tabs: ProjectTab {
                    label: tab.name + (tab.dirty ? " *" : "");
                    selected: root.current-project == index;
                    tab-height: root.project-tab-height * 1px;
                    activate => { root.select-project(index); }
                    close => { root.close-project(index); }
                }
                Rectangle { horizontal-stretch: 1; }
                TabAddButton { accessible-name: @tr("New Project"); clicked => { root.new-project(); } }
            }
        }
            Rectangle {
            vertical-stretch: 1;
            background: AppTheme.canvas-background;
            Image {
                source: root.preview-image;
                image-fit: contain;
                width: 100%;
                height: 100%;
            }
        }
            Rectangle {
            height: AppTheme.toolbar-height;
            background: AppTheme.panel-background;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 3px;
                padding-bottom: 3px;
                spacing: 10px;
                seek-slider := Slider {
                    value: root.playhead;
                    minimum: 0;
                    maximum: root.duration;
                    horizontal-stretch: 1;
                    accessible-label: @tr("Seek Bar");
                    accessible-description: @tr("Drag to change playback position on the timeline");
                    changed => { root.seek(self.value); }
                }
                Text {
                    text: round(root.playhead) + " / " + round(root.duration);
                    width: 40px;
                    font-family: "Monospace";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    min-width: 96px;
                    max-width: 96px;
                    horizontal-stretch: 0;
                    spacing: 0px;
                    TransportButton { icon: "previous"; accessible-name: @tr("Back 1 Frame"); help-text: @tr("Move playback position 1 frame back"); clicked => { root.previous-frame(); } }
                    TransportButton { icon: root.playing ? "pause" : "play"; active: root.playing; accessible-name: root.playing ? @tr("Pause") : @tr("Play"); help-text: @tr("Start or pause playback"); clicked => { root.toggle-playback(); } }
                    TransportButton { icon: "next"; accessible-name: @tr("Forward 1 Frame"); help-text: @tr("Move playback position 1 frame forward"); clicked => { root.next-frame(); } }
                }
                HorizontalLayout {
                    min-width: 130px;
                    max-width: 130px;
                    horizontal-stretch: 0;
                    spacing: 5px;
                    Text { text: @tr("Speed"); vertical-alignment: center; }
                    SpinBox {
                        width: 80px;
                        height: 28px;
                        value <=> root.playback-speed-percent;
                        minimum: 10;
                        maximum: 400;
                        step-size: 10;
                        enabled: !root.playing;
                        accessible-label: @tr("Playback speed (percent)");
                        edited(value) => { root.playback-speed-changed(value); }
                    }
                    Text { text: "%"; vertical-alignment: center; }
                }
            }
        }
        }
    }

    if root.missing-media.length > 0 : Rectangle {
        z: 100;
        width: min(430px, root.width - 24px);
        height: 42px;
        x: root.width - self.width - 12px;
        y: root.height - self.height - 12px;
        background: AppTheme.control-background;
        border-width: 1px;
        border-color: AppTheme.border;
        border-radius: 5px;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 6px;
            spacing: 8px;
            Text {
                text: @tr("{} missing media files", root.missing-media.length);
                color: AppTheme.foreground;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Manage");
                accessible-label: @tr("Manage Missing Media");
                clicked => { root.missing-media-dialog-visible = true; }
            }
        }
    }

    if root.missing-media-dialog-visible : missing-media-focus := FocusScope {
        z: 900;
        width: min(root.width - 32px, 560px);
        height: min(root.height - 32px, 360px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.missing-media-dialog-visible = false;
                accept
            } else {
                reject
            }
        }

        Rectangle {
            background: AppTheme.raised-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 6px;
            VerticalLayout {
                padding: 12px;
                spacing: 10px;
                Text {
                    text: @tr("Missing Media");
                    color: AppTheme.foreground;
                    font-size: 1.15rem;
                    font-weight: 700;
                }
                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.visible-width;
                    viewport-height: missing-media-list.preferred-height;
                    missing-media-list := VerticalLayout {
                        width: parent.width;
                        spacing: 6px;
                        for media in root.missing-media : Rectangle {
                            height: 64px;
                            background: AppTheme.panel-background;
                            border-width: 1px;
                            border-color: AppTheme.border;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: media.clip-type + ": " + media.name;
                                        color: AppTheme.foreground;
                                        font-weight: 700;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: media.path;
                                        color: AppTheme.muted-foreground;
                                        font-size: 0.78rem;
                                        overflow: elide;
                                    }
                                }
                                Button {
                                    text: @tr("Replace");
                                    accessible-label: @tr("Replace Missing Media");
                                    clicked => { root.relink-missing-media(media.clip-id); }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: @tr("Close");
                        clicked => { root.missing-media-dialog-visible = false; }
                    }
                }
            }
        }
    }

    if root.save-confirmation-visible : Rectangle {
        z: 1000;
        width: 100%;
        height: 100%;
        background: AppTheme.scrim;

        TouchArea { }

        Rectangle {
            width: min(parent.width - 32px, 460px);
            height: 174px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: AppTheme.raised-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 6px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: @tr("Confirm Save");
                    color: AppTheme.foreground;
                    font-size: 1.15rem;
                    font-weight: 700;
                }
                Text {
                    text: root.save-confirmation-project + @tr(" has unsaved changes.\nSave before continuing?");
                    color: AppTheme.muted-foreground;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: @tr("confirm-save" => "Save");
                        accessible-label: @tr("confirm-save" => "Save");
                        clicked => { root.confirm-save(); }
                    }
                    Button {
                        text: @tr("Discard");
                        accessible-label: @tr("Discard");
                        clicked => { root.confirm-discard(); }
                    }
                    Button {
                        text: @tr("Cancel");
                        accessible-label: @tr("Cancel");
                        clicked => { root.confirm-cancel(); }
                    }
                }
            }
        }
    }
}

export component TimelineWindow inherits Window {
    title: @tr("Timeline");
    preferred-width: 1280px;
    preferred-height: 300px;
    min-width: 720px;
    min-height: 220px;
    forward-focus: timeline-shortcuts;
    in-out property <string> action-status: "";
    in property <[SceneTabData]> scene-tabs;
    in property <[TimelineClipData]> clips;
    in property <[LayerData]> layers;
    in property <[EffectCatalogItemData]> object-catalog-items;
    in property <[string]> object-catalog-categories;
    in property <[EffectCatalogItemData]> context-catalog-items;
    in property <int> duration: 3600;
    in property <int> playhead: 0;
    in property <int> selected-layer: 0;
    in-out property <float> pixels-per-frame: 1;
    in property <int> zoom-min: 10;
    in property <int> zoom-max: 400;
    in property <bool> timeline-skimming-enabled: true;
    in property <int> timeline-track-height: 30;
    in property <int> timeline-header-height: 28;
    in property <int> timeline-ruler-height: 32;
    in property <int> maximum-layers: 128;
    in property <int> layer-header-width: 60;
    in property <int> clip-resize-handle-width: 10;
    in property <int> minimum-clip-duration-frames: 5;
    in property <string> grid-mode: "Auto";
    in property <float> grid-fps: 60;
    in property <float> grid-bpm: 120;
    in property <float> grid-offset: 0;
    in property <int> grid-interval: 10;
    in property <int> grid-subdivision: 4;
    in-out property <bool> skimmer-visible: false;
    in-out property <int> skimmer-frame: 0;
    in-out property <int> skimmer-layer: 0;
    in-out property <bool> file-drop-active: false;
    private property <length> shared-viewport-x: 0px;
    private property <length> shared-viewport-y: 0px;
    private property <bool> box-active: false;
    private property <bool> box-dragging: false;
    private property <int> box-start-frame: 0;
    private property <int> box-start-layer: 0;
    private property <int> box-current-frame: 0;
    private property <int> box-current-layer: 0;
    private property <length> box-press-x: 0px;
    private property <length> box-press-y: 0px;
    private property <bool> ruler-scrubbing: false;
    private property <string> zoom-percent-text: "100";
    in-out property <bool> object-picker-visible: false;
    private property <string> object-filter: "";
    private property <int> object-category-index: 0;
    private property <int> object-catalog-selected-index: -1;
    private property <string> object-catalog-selected-id: "";
    private property <int> context-frame: 0;
    private property <int> context-layer: 0;
    private property <int> context-target-kind: -1;
    private property <int> context-clip-id: -1;
    private property <bool> context-clip-by-upper-object: false;
    private property <string> context-search-query: "";
    private property <length> context-popup-x: 0px;
    private property <length> context-popup-y: 0px;
    private property <bool> insert-layers-visible: false;
    private property <int> insert-layers-target: 0;
    private property <int> insert-layers-count: 5;
    private property <bool> insert-layers-above: true;
    private property <bool> shift-layers-visible: false;
    private property <int> shift-layers-start: 1;
    private property <int> shift-layers-end: root.maximum-layers;
    private property <int> shift-layers-count: 1;
    private property <bool> shift-layers-down: true;
    private property <float> visible-grid-step: root.grid-step-frames();
    private property <float> visible-grid-offset: root.grid-mode == "BPM"
        ? root.grid-offset * root.grid-fps
        : 0;
    private property <int> first-visible-grid-index: floor(
        ((-root.shared-viewport-x / (max(root.pixels-per-frame, 0.05) * 1px))
            - root.visible-grid-offset) / max(root.visible-grid-step, 0.01)
    ) - 1;
    private property <int> visible-grid-line-count: ceil(
        timeline-scroll.visible-width
            / (max(root.visible-grid-step, 0.01) * max(root.pixels-per-frame, 0.05) * 1px)
    ) + 3;
    callback timeline-action(string, int, int);
    callback seek-audio-frame(int, int);
    callback filter-objects(string, int);
    callback filter-context-catalog(string, int);
    callback add-catalog-object(string, int, int) -> bool;
    callback show-object-settings();
    callback show-scene-settings();
    callback scene-selected(int);
    callback scene-settings(int);
    callback scene-closed(int);
    callback clip-selected(int, bool);
    callback clip-drag-started(int, bool);
    callback clip-context-selected(int);
    callback clip-command(string, int, int, int);
    callback clip-drag-finished(string, int, float, float, bool);
    callback layer-activated(int);
    callback layer-command(string, int);
    callback insert-layers(int, int, bool);
    callback shift-layers(int, int, int);
    callback empty-clicked(int, int);
    callback box-selection-started(int, int, bool);
    callback box-selection-updated(int, int);
    callback box-selection-finished();
    callback box-selection-cancelled();
    callback skimmer-hovered(float, int, bool);
    callback skimmer-left();
    callback file-dropped(string, float, int, bool) -> TimelineMediaDropResult;
    callback native-file-hovered(float, float, bool);
    callback native-file-left();
    callback native-file-dropped(string, float, float, bool) -> TimelineMediaDropResult;
    callback keyboard-shortcut(string, bool, bool, bool, bool) -> bool;
    callback timeline-scrolled(float, float, float, float, float, float, float, float, float, float, bool, bool, bool, bool) -> TimelineViewportData;
    callback begin-scrub();
    callback scrub-to(float);
    callback end-scrub();

    function zoom-percent-to-scale(percent: float) -> float {
        return percent <= 100 ? percent / 100 : 1 + (percent - 100) * 9 / 300;
    }

    function scale-to-zoom-percent(scale: float) -> float {
        return scale <= 1 ? scale * 100 : 100 + (scale - 1) * 300 / 9;
    }

    function bpm-divisions-for(pixels-per-frame: float) -> int {
        return pixels-per-frame > 3 ? 4 : pixels-per-frame > 1.5 ? 2 : 1;
    }

    function grid-step-frames() -> float {
        if root.grid-mode == "BPM" {
            let divisions = root.bpm-divisions-for(root.pixels-per-frame);
            return max(root.grid-fps / max(root.grid-bpm / 60, 0.01) / divisions, 0.01);
        }
        if root.grid-mode == "Frame" {
            return max(root.grid-interval, 1);
        }
        if root.pixels-per-frame < 0.5 {
            return max(ceil(root.grid-fps), 1);
        }
        if root.pixels-per-frame < 1.5 {
            return 10;
        }
        if root.pixels-per-frame < 3 {
            return 5;
        }
        return 1;
    }

    function apply-zoom-percent(percent: float) {
        let bounded = round(percent).clamp(root.zoom-min, root.zoom-max);
        let old-scale = max(root.pixels-per-frame, 0.0001);
        let anchor-x = timeline-scroll.visible-width / 2;
        let anchor-frame = (-root.shared-viewport-x + anchor-x) / (old-scale * 1px);
        let new-scale = root.zoom-percent-to-scale(bounded);
        let new-viewport-width = max(root.duration * new-scale * 1px, timeline-scroll.visible-width);
        root.pixels-per-frame = new-scale;
        root.shared-viewport-x = max(
            timeline-scroll.visible-width - new-viewport-width,
            min(0px, anchor-x - anchor-frame * new-scale * 1px)
        );
        root.zoom-percent-text = bounded;
    }

    changed pixels-per-frame => {
        root.zoom-percent-text = round(root.scale-to-zoom-percent(root.pixels-per-frame));
    }

    function update-skimmer(frame: float, layer: int, ignore-snap: bool) {
        skimmer-leave-timer.running = false;
        if root.timeline-skimming-enabled {
            root.skimmer-hovered(frame, layer, ignore-snap);
        } else {
            root.skimmer-visible = false;
        }
    }

    function schedule-skimmer-left() {
        skimmer-leave-timer.running = false;
        skimmer-leave-timer.running = true;
    }

    function open-object-picker() {
        root.object-filter = "";
        root.object-category-index = 0;
        root.object-catalog-selected-index = -1;
        root.object-catalog-selected-id = "";
        root.filter-objects("", 0);
        root.object-picker-visible = true;
    }

    function open-context-popup(kind: int, clip-id: int, x: length, y: length, clip-by-upper-object: bool) {
        context-category-popup.close();
        context-catalog-popup.close();
        root.context-target-kind = kind;
        root.context-clip-id = clip-id;
        root.context-clip-by-upper-object = clip-by-upper-object;
        root.context-search-query = "";
        root.context-popup-x = min(max(x, 4px), max(4px, root.width - 344px));
        root.context-popup-y = min(max(y, 4px), max(4px, root.height - 292px));
        root.filter-context-catalog("", kind);
        timeline-context-popup.show();
    }

    function open-context-catalog-menu() {
        if root.context-target-kind == 0 {
            root.filter-objects("", 0);
            context-category-popup.show();
        } else {
            root.filter-context-catalog("", root.context-target-kind);
            context-catalog-popup.show();
        }
    }

    function open-context-object-category(index: int) {
        root.filter-objects("", index);
        context-catalog-popup.show();
    }

    function close-context-popups() {
        context-catalog-popup.close();
        context-category-popup.close();
        timeline-context-popup.close();
    }

    function activate-context-catalog-item(id: string) {
        if root.context-target-kind == 0 {
            if root.add-catalog-object(id, root.context-frame, root.context-layer) {
                root.close-context-popups();
            }
        } else {
            root.clip-command("add-extension:" + id, root.context-clip-id, root.context-frame, root.context-layer);
            root.close-context-popups();
        }
    }

    function activate-context-command(action: string) {
        if root.context-target-kind == 0 {
            root.timeline-action(action, root.context-frame, root.context-layer);
        } else {
            root.clip-command(action, root.context-clip-id, root.context-frame, root.context-layer);
        }
        root.close-context-popups();
    }

    function browse-context-catalog() {
        if root.context-target-kind == 0 {
            root.open-object-picker();
        } else {
            root.clip-command("browse-effect", root.context-clip-id, root.context-frame, root.context-layer);
        }
        root.close-context-popups();
    }

    function accept-object-selection() {
        if root.object-catalog-selected-id != ""
            && root.add-catalog-object(
                root.object-catalog-selected-id,
                root.context-frame,
                root.context-layer
            ) {
            root.object-picker-visible = false;
        }
    }

    function file-drop-position-valid(window-x: float, window-y: float) -> bool {
        let x = window-x * 1px;
        let y = window-y * 1px;
        return x >= timeline-scroll.absolute-position.x
            && x < timeline-scroll.absolute-position.x + timeline-scroll.visible-width
            && y >= timeline-scroll.absolute-position.y
            && y < timeline-scroll.absolute-position.y + timeline-scroll.visible-height;
    }

    function file-drop-frame(window-x: float) -> float {
        let content-x = window-x * 1px - timeline-scroll.absolute-position.x - root.shared-viewport-x;
        return max(0, content-x / (root.pixels-per-frame * 1px));
    }

    function file-drop-layer(window-y: float) -> int {
        let content-y = window-y * 1px - timeline-scroll.absolute-position.y - root.shared-viewport-y;
        return min(root.maximum-layers - 1, max(0, floor(content-y / (root.timeline-track-height * 1px))));
    }

    native-file-hovered(window-x, window-y, ignore-snap) => {
        if root.file-drop-position-valid(window-x, window-y) {
            root.file-drop-active = true;
            root.update-skimmer(
                root.file-drop-frame(window-x),
                root.file-drop-layer(window-y),
                ignore-snap
            );
        } else {
            root.file-drop-active = false;
            root.skimmer-left();
        }
    }

    native-file-left() => {
        root.file-drop-active = false;
        root.skimmer-left();
    }

    native-file-dropped(path, window-x, window-y, ignore-snap) => {
        root.file-drop-active = false;
        if root.file-drop-position-valid(window-x, window-y) {
            return root.file-dropped(
                path,
                root.file-drop-frame(window-x),
                root.file-drop-layer(window-y),
                ignore-snap
            );
        }
        root.skimmer-left();
        return { imported: false, next-frame: 0, layer: 0 };
    }

    function apply-timeline-scroll(
        delta-x: length,
        delta-y: length,
        content-x: length,
        alt: bool,
        control: bool,
        shift: bool,
        ruler-zoom: bool
    ) -> bool {
        let result = root.timeline-scrolled(
            delta-x / 1px,
            delta-y / 1px,
            content-x / 1px,
            root.shared-viewport-x / 1px,
            root.shared-viewport-y / 1px,
            timeline-scroll.visible-width / 1px,
            timeline-scroll.viewport-width / 1px,
            timeline-scroll.visible-height / 1px,
            timeline-scroll.viewport-height / 1px,
            root.duration,
            alt,
            control,
            shift,
            ruler-zoom
        );
        root.pixels-per-frame = result.pixels-per-frame;
        root.shared-viewport-x = result.viewport-x * 1px;
        root.shared-viewport-y = result.viewport-y * 1px;
        return true;
    }

    function scroll-layers(delta-y: length) -> bool {
        let minimum = min(0px, layer-scroll.visible-height - layer-scroll.viewport-height);
        root.shared-viewport-y = max(minimum, min(0px, root.shared-viewport-y + delta-y));
        return true;
    }

    skimmer-leave-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.skimmer-left();
        }
    }

    timeline-shortcuts := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if root.keyboard-shortcut(
                event.text,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.meta
            ) {
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            spacing: 0px;
            Rectangle {
            height: root.timeline-header-height * 1px;
            background: AppTheme.raised-background;
            HorizontalLayout {
                spacing: 0px;
                accessible-role: tab-list;
                accessible-label: @tr("Scene");
                for scene in root.scene-tabs: SceneTab {
                    scene: scene;
                    height: root.timeline-header-height * 1px;
                    activate(scene-id) => { root.scene-selected(scene-id); }
                    settings(scene-id) => { root.scene-settings(scene-id); }
                    close(scene-id) => { root.scene-closed(scene-id); }
                }
                Rectangle { horizontal-stretch: 1; }
                TabAddButton { accessible-name: @tr("Create New Scene"); clicked => { root.show-scene-settings(); } }
            }
        }
            Rectangle {
            height: root.timeline-ruler-height * 1px;
            background: AppTheme.panel-background;
            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: AppTheme.subtle-border;
            }
            zoom-menu := ContextMenuArea {
                x: 0px;
                y: 0px;
                width: root.layer-header-width * 1px;
                height: 100%;
                Menu {
                    MenuItem { title: "10"; activated => { root.apply-zoom-percent(10); } }
                    MenuItem { title: "25"; activated => { root.apply-zoom-percent(25); } }
                    MenuItem { title: "50"; activated => { root.apply-zoom-percent(50); } }
                    MenuItem { title: "75"; activated => { root.apply-zoom-percent(75); } }
                    MenuItem { title: "100"; activated => { root.apply-zoom-percent(100); } }
                    MenuItem { title: "150"; activated => { root.apply-zoom-percent(150); } }
                    MenuItem { title: "200"; activated => { root.apply-zoom-percent(200); } }
                    MenuItem { title: "300"; activated => { root.apply-zoom-percent(300); } }
                    MenuItem { title: "400"; activated => { root.apply-zoom-percent(400); } }
                }
                Rectangle {
                    background: AppTheme.raised-background;
                    border-width: 1px;
                    border-color: AppTheme.subtle-border;
                    border-radius: AppTheme.control-radius;
                    zoom-field := LineEdit {
                        x: 0px;
                        width: 43px;
                        height: 100%;
                        text <=> root.zoom-percent-text;
                        accessible-label: @tr("Timeline zoom");
                        accepted(value) => {
                            if value.is-float() {
                                root.apply-zoom-percent(value.to-float());
                            } else {
                                root.zoom-percent-text = round(root.scale-to-zoom-percent(root.pixels-per-frame));
                            }
                        }
                    }
                    Rectangle {
                        x: 43px;
                        width: 17px;
                        height: 100%;
                        background: zoom-button.has-hover ? AppTheme.hover-background : transparent;
                        Text { text: "▾"; horizontal-alignment: center; vertical-alignment: center; }
                        zoom-button := TouchArea {
                            accessible-role: button;
                            accessible-label: @tr("Zoom presets");
                            clicked => { zoom-menu.show({ x: 0px, y: self.height }); }
                        }
                    }
                }
            }
            ruler-scroll := ScrollView {
                x: root.layer-header-width * 1px;
                width: parent.width - root.layer-header-width * 1px;
                height: parent.height;
                viewport-width: max(root.duration * root.pixels-per-frame * 1px, self.visible-width);
                viewport-height: self.visible-height;
                viewport-x <=> root.shared-viewport-x;
                mouse-drag-pan-enabled: false;
                for tick in 61: Rectangle {
                    visible: tick * 60 <= root.duration;
                    x: tick * 60 * root.pixels-per-frame * 1px;
                    width: 1px;
                    height: 100%;
                    background: AppTheme.subtle-border;
                    Text {
                        x: 4px;
                        text: tick * 60;
                        color: AppTheme.foreground;
                        font-family: "Monospace";
                        font-size: 0.78rem;
                    }
                }
                Rectangle {
                    x: root.playhead * root.pixels-per-frame * 1px;
                    width: 2px;
                    height: 100%;
                    background: AppTheme.accent;
                }
            }
            ruler-input := TouchArea {
                x: root.layer-header-width * 1px;
                width: parent.width - root.layer-header-width * 1px;
                height: parent.height;
                mouse-cursor: root.ruler-scrubbing ? move : pointer;
                accessible-role: slider;
                accessible-label: @tr("Seek Bar");
                accessible-description: @tr("Drag to change playback position on the timeline");
                accessible-value: "\{round(root.playhead)}";
                accessible-value-minimum: 0;
                accessible-value-maximum: root.duration;
                accessible-value-step: 1;
                accessible-action-increment => {
                    root.begin-scrub();
                    root.scrub-to(min(root.duration, root.playhead + 1));
                    root.end-scrub();
                }
                accessible-action-decrement => {
                    root.begin-scrub();
                    root.scrub-to(max(0, root.playhead - 1));
                    root.end-scrub();
                }
                accessible-action-set-value(value) => {
                    if value.is-float() {
                        root.begin-scrub();
                        root.scrub-to(value.to-float().clamp(0, root.duration));
                        root.end-scrub();
                    }
                }
                clicked => {
                    root.begin-scrub();
                    root.scrub-to((self.mouse-x - root.shared-viewport-x) / (root.pixels-per-frame * 1px));
                    root.end-scrub();
                }
                pointer-event(event) => {
                    let content-x = self.mouse-x - root.shared-viewport-x;
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.ruler-scrubbing = true;
                        root.begin-scrub();
                        root.scrub-to(content-x / (root.pixels-per-frame * 1px));
                    }
                    if event.kind == PointerEventKind.move && root.ruler-scrubbing {
                        root.scrub-to(content-x / (root.pixels-per-frame * 1px));
                    }
                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.ruler-scrubbing {
                        root.scrub-to(content-x / (root.pixels-per-frame * 1px));
                        root.ruler-scrubbing = false;
                        root.end-scrub();
                    }
                    if event.kind == PointerEventKind.cancel && root.ruler-scrubbing {
                        root.ruler-scrubbing = false;
                        root.end-scrub();
                    }
                }
                scroll-event(event) => {
                    root.apply-timeline-scroll(
                        event.delta-x,
                        event.delta-y,
                        self.mouse-x - root.shared-viewport-x,
                        false,
                        false,
                        false,
                        true
                    ) ? accept : reject
                }
            }
        }
            HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            layer-scroll := ScrollView {
                width: root.layer-header-width * 1px;
                vertical-stretch: 1;
                accessible-role: list;
                accessible-label: @tr("Layers");
                viewport-width: self.visible-width;
                viewport-height: root.layers.length * root.timeline-track-height * 1px;
                viewport-y <=> root.shared-viewport-y;
                for layer in root.layers: LayerHeaderItem {
                    y: layer.index * root.timeline-track-height * 1px;
                    width: root.layer-header-width * 1px;
                    height: root.timeline-track-height * 1px;
                    layer: layer;
                    activate(layer-index) => { root.layer-activated(layer-index); }
                    command(action, layer-index) => {
                        if action == "insert-many" {
                            root.insert-layers-target = layer-index;
                            root.insert-layers-count = 5;
                            root.insert-layers-above = true;
                            root.insert-layers-visible = true;
                        } else if action == "shift-range" {
                            root.shift-layers-start = layer-index + 1;
                            root.shift-layers-end = root.maximum-layers;
                            root.shift-layers-count = 1;
                            root.shift-layers-down = true;
                            root.shift-layers-visible = true;
                        } else {
                            root.layer-command(action, layer-index);
                        }
                    }
                    scroll-requested(delta-y) => { root.scroll-layers(delta-y) }
                }
            }

            timeline-scroll := ScrollView {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                viewport-width: max(root.duration * root.pixels-per-frame * 1px, self.visible-width);
                viewport-height: root.layers.length * root.timeline-track-height * 1px;
                viewport-x <=> root.shared-viewport-x;
                viewport-y <=> root.shared-viewport-y;
                mouse-drag-pan-enabled: false;

                background-touch := TouchArea {
                        x: -root.shared-viewport-x;
                        y: -root.shared-viewport-y;
                        width: timeline-scroll.visible-width;
                        height: timeline-scroll.visible-height;
                        accessible-role: main;
                        accessible-id: "timeline-viewport";
                        accessible-label: @tr("Timeline editing area");
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.move {
                                root.update-skimmer(
                                    (self.mouse-x - root.shared-viewport-x) / (root.pixels-per-frame * 1px),
                                    floor((self.mouse-y - root.shared-viewport-y) / (root.timeline-track-height * 1px)),
                                    event.modifiers.shift
                                );
                            }
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                root.empty-clicked(
                                    floor((self.mouse-x - root.shared-viewport-x) / (root.pixels-per-frame * 1px)),
                                    floor((self.mouse-y - root.shared-viewport-y) / (root.timeline-track-height * 1px))
                                );
                            }
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                                root.box-active = true;
                                root.box-dragging = false;
                                root.context-frame = max(0, floor((self.mouse-x - root.shared-viewport-x) / (root.pixels-per-frame * 1px)));
                                root.context-layer = min(root.maximum-layers - 1, max(0, floor((self.mouse-y - root.shared-viewport-y) / (root.timeline-track-height * 1px))));
                                root.box-start-frame = root.context-frame;
                                root.box-start-layer = root.context-layer;
                                root.box-current-frame = root.box-start-frame;
                                root.box-current-layer = root.box-start-layer;
                                root.box-press-x = self.mouse-x;
                                root.box-press-y = self.mouse-y;
                                root.box-selection-started(
                                    root.box-start-frame,
                                    root.box-start-layer,
                                    event.modifiers.control || event.modifiers.meta
                                );
                            }
                            if event.kind == PointerEventKind.move && root.box-active {
                                root.box-current-frame = max(0, floor((self.mouse-x - root.shared-viewport-x) / (root.pixels-per-frame * 1px)));
                                root.box-current-layer = min(root.maximum-layers - 1, max(0, floor((self.mouse-y - root.shared-viewport-y) / (root.timeline-track-height * 1px))));
                                if abs(self.mouse-x - root.box-press-x) >= 3px || abs(self.mouse-y - root.box-press-y) >= 3px {
                                    root.box-dragging = true;
                                    root.box-selection-updated(root.box-current-frame, root.box-current-layer);
                                }
                            }
                            if event.kind == PointerEventKind.up && event.button == PointerEventButton.right && root.box-active {
                                if root.box-dragging {
                                    root.box-selection-finished();
                                } else {
                                    root.box-selection-cancelled();
                                    root.open-context-popup(
                                        0,
                                        -1,
                                        timeline-scroll.absolute-position.x + self.mouse-x - root.shared-viewport-x,
                                        timeline-scroll.absolute-position.y + self.mouse-y - root.shared-viewport-y,
                                        false
                                    );
                                }
                                root.box-active = false;
                                root.box-dragging = false;
                            }
                            if event.kind == PointerEventKind.cancel && root.box-active {
                                root.box-selection-cancelled();
                                root.box-active = false;
                                root.box-dragging = false;
                            }
                        }
                        scroll-event(event) => {
                            root.apply-timeline-scroll(
                                event.delta-x,
                                event.delta-y,
                                self.mouse-x - root.shared-viewport-x,
                                event.modifiers.alt,
                                event.modifiers.control,
                                event.modifiers.shift,
                                false
                            ) ? accept : reject
                        }
                        changed has-hover => { if !self.has-hover { root.schedule-skimmer-left(); } }
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: AppTheme.window-background;
                }
                for row in root.layers.length: Rectangle {
                    y: row * root.timeline-track-height * 1px;
                    width: 100%;
                    height: 1px;
                    background: AppTheme.subtle-border;
                }
                for grid-line in root.visible-grid-line-count: Rectangle {
                    private property <int> grid-index: root.first-visible-grid-index + grid-line;
                    private property <int> bpm-divisions: root.bpm-divisions-for(root.pixels-per-frame);
                    private property <bool> measure-line: root.grid-mode == "BPM"
                        && Math.mod(self.grid-index, max(root.grid-subdivision * self.bpm-divisions, 1)) == 0;
                    private property <bool> beat-line: root.grid-mode == "BPM"
                        && Math.mod(self.grid-index, self.bpm-divisions) == 0;
                    x: (root.visible-grid-offset + self.grid-index * root.visible-grid-step)
                        * root.pixels-per-frame * 1px;
                    width: self.measure-line ? 2px : 1px;
                    height: 100%;
                    background: self.measure-line
                        ? AppTheme.accent.transparentize(0.48)
                        : self.beat-line
                            ? AppTheme.border.transparentize(0.38)
                            : AppTheme.subtle-border.transparentize(0.42);
                }
                for clip in root.clips: TimelineClipItem {
                    x: clip.start * root.pixels-per-frame * 1px;
                    y: clip.layer * root.timeline-track-height * 1px + 3px;
                    width: max(clip.duration * root.pixels-per-frame * 1px, 8px);
                    height: max(root.timeline-track-height * 1px - 6px, 1px);
                    clip-data: clip;
                    pixels-per-frame: root.pixels-per-frame;
                    track-height: root.timeline-track-height * 1px;
                    resize-handle-width: root.clip-resize-handle-width * 1px;
                    activate(clip-id, additive) => { root.clip-selected(clip-id, additive); }
                    prepare-drag(clip-id, additive) => { root.clip-drag-started(clip-id, additive); }
                    context-activate(clip-id, window-x, window-y) => {
                        root.clip-context-selected(clip-id);
                        root.context-frame = root.file-drop-frame(window-x);
                        root.context-layer = root.file-drop-layer(window-y);
                        root.open-context-popup(
                            clip.audio ? 2 : 1,
                            clip-id,
                            window-x * 1px,
                            window-y * 1px,
                            clip.clip-by-upper-object
                        );
                    }
                    open-settings(clip-id) => {
                        root.clip-context-selected(clip-id);
                        root.show-object-settings();
                    }
                    seek-audio-frame(clip-id, frame) => { root.seek-audio-frame(clip-id, frame); }
                    command(action, clip-id, frame, layer) => { root.clip-command(action, clip-id, frame, layer); }
                    pointer-hovered(content-x, content-y, ignore-snap) => {
                        root.update-skimmer(
                            content-x / root.pixels-per-frame,
                            floor(content-y / root.timeline-track-height),
                            ignore-snap
                        );
                    }
                    pointer-left => { root.schedule-skimmer-left(); }
                    scroll-requested(delta-x, delta-y, content-x, alt, control, shift) => {
                        root.apply-timeline-scroll(
                            delta-x,
                            delta-y,
                            content-x,
                            alt,
                            control,
                            shift,
                            false
                        )
                    }
                    drag-finished(kind, clip-id, delta-x, delta-y, ignore-snap) => {
                        root.clip-drag-finished(kind, clip-id, delta-x, delta-y, ignore-snap);
                    }
                }
                if root.box-active && root.box-dragging : Rectangle {
                    x: min(root.box-start-frame, root.box-current-frame) * root.pixels-per-frame * 1px;
                    y: min(root.box-start-layer, root.box-current-layer) * root.timeline-track-height * 1px;
                    width: max(abs(root.box-current-frame - root.box-start-frame) * root.pixels-per-frame * 1px, 1px);
                    height: max((abs(root.box-current-layer - root.box-start-layer) + 1) * root.timeline-track-height * 1px, 1px);
                    background: AppTheme.selection-background;
                    border-width: 1px;
                    border-color: AppTheme.accent;
                }
                if root.skimmer-visible : Rectangle {
                    x: root.skimmer-frame * root.pixels-per-frame * 1px;
                    width: 1px;
                    height: 100%;
                    background: AppTheme.danger;
                }
                if root.file-drop-active : Rectangle {
                    x: -root.shared-viewport-x;
                    y: -root.shared-viewport-y;
                    width: timeline-scroll.visible-width;
                    height: timeline-scroll.visible-height;
                    background: AppTheme.hover-background;
                    border-width: 1px;
                    border-color: AppTheme.accent;
                    Text {
                        text: @tr("Drop here");
                        color: AppTheme.foreground;
                        font-size: 1.1rem;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    x: root.playhead * root.pixels-per-frame * 1px;
                    width: 2px;
                    height: 100%;
                    background: AppTheme.accent;
                }
            }
        }
        }
    }

    if root.insert-layers-visible : insert-layers-focus := FocusScope {
        z: 300;
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.insert-layers-visible = false;
                accept
            } else {
                reject
            }
        }
        Rectangle { background: AppTheme.scrim; TouchArea { } }
        Rectangle {
            width: min(parent.width - 32px, 430px);
            height: 240px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: AppTheme.raised-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 6px;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: @tr("Insert multiple layers");
                    color: AppTheme.foreground;
                    font-size: 1.15rem;
                    font-weight: 700;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: @tr("Number of layers to insert:"); vertical-alignment: center; }
                    SpinBox {
                        value <=> root.insert-layers-count;
                        minimum: 1;
                        maximum: 100;
                        horizontal-stretch: 1;
                    }
                }
                Text { text: @tr("Insertion direction:"); }
                RadioGroup {
                    orientation: Orientation.horizontal;
                    RadioButton {
                        text: @tr("Above selected layer");
                        checked: root.insert-layers-above;
                        toggled => { if self.checked { root.insert-layers-above = true; } }
                    }
                    RadioButton {
                        text: @tr("Below selected layer");
                        checked: !root.insert-layers-above;
                        toggled => { if self.checked { root.insert-layers-above = false; } }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: @tr("Cancel"); clicked => { root.insert-layers-visible = false; } }
                    Button {
                        text: "OK";
                        primary: true;
                        clicked => {
                            root.insert-layers(root.insert-layers-target, root.insert-layers-count, root.insert-layers-above);
                            root.insert-layers-visible = false;
                        }
                    }
                }
            }
        }
    }

    if root.shift-layers-visible : shift-layers-focus := FocusScope {
        z: 300;
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.shift-layers-visible = false;
                accept
            } else {
                reject
            }
        }
        Rectangle { background: AppTheme.scrim; TouchArea { } }
        Rectangle {
            width: min(parent.width - 32px, 470px);
            height: 330px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: AppTheme.raised-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 6px;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: @tr("Move this layer and below together");
                    color: AppTheme.foreground;
                    font-size: 1.15rem;
                    font-weight: 700;
                }
                Text { text: @tr("Target layer range:"); }
                HorizontalLayout {
                    spacing: 8px;
                    SpinBox { value <=> root.shift-layers-start; minimum: 1; maximum: root.maximum-layers; horizontal-stretch: 1; }
                    Text { text: "～"; vertical-alignment: center; }
                    SpinBox { value <=> root.shift-layers-end; minimum: 1; maximum: root.maximum-layers; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: @tr("Move amount (rows):"); vertical-alignment: center; }
                    SpinBox { value <=> root.shift-layers-count; minimum: 1; maximum: 100; horizontal-stretch: 1; }
                }
                Text { text: @tr("Direction:"); }
                RadioGroup {
                    orientation: Orientation.horizontal;
                    RadioButton {
                        text: @tr("Up");
                        checked: !root.shift-layers-down;
                        toggled => { if self.checked { root.shift-layers-down = false; } }
                    }
                    RadioButton {
                        text: @tr("Down");
                        checked: root.shift-layers-down;
                        toggled => { if self.checked { root.shift-layers-down = true; } }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: @tr("Cancel"); clicked => { root.shift-layers-visible = false; } }
                    Button {
                        text: "OK";
                        primary: true;
                        clicked => {
                            root.shift-layers(
                                root.shift-layers-start - 1,
                                root.shift-layers-end - 1,
                                root.shift-layers-down ? root.shift-layers-count : -root.shift-layers-count
                            );
                            root.shift-layers-visible = false;
                        }
                    }
                }
            }
        }
    }

    timeline-context-popup := PopupWindow {
        x: root.context-popup-x;
        y: root.context-popup-y;
        width: min(340px, root.width - 8px);
        height: min(420px, max(212px, root.height - 8px));
        close-policy: PopupClosePolicy.close-on-click-outside;
        forward-focus: context-search;

        context-popup-focus := FocusScope {
            forward-focus: context-search;
            capture-key-pressed(event) => {
                if event.text == Key.Escape {
                    timeline-context-popup.close();
                    accept
                } else {
                    reject
                }
            }
            Rectangle {
                background: AppTheme.panel-background;
                border-width: 1px;
                border-color: AppTheme.border;
                border-radius: 5px;
                VerticalLayout {
                    padding: 5px;
                    spacing: 4px;
                    context-search := LineEdit {
                        text <=> root.context-search-query;
                        placeholder-text: @tr("Search effects/objects...");
                        edited(value) => {
                            context-catalog-popup.close();
                            context-category-popup.close();
                            root.filter-context-catalog(value, root.context-target-kind);
                        }
                        accepted(value) => {
                            if root.context-catalog-items.length == 1 {
                                root.activate-context-catalog-item(root.context-catalog-items[0].id);
                            }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;

                            if root.context-search-query != "" : VerticalLayout {
                                spacing: 2px;
                                for item in root.context-catalog-items : TimelineContextRow {
                                    title: item.categories == "" ? item.name : item.categories + " / " + item.name;
                                    activated => { root.activate-context-catalog-item(item.id); }
                                }
                            }
                            if root.context-search-query != "" && root.context-catalog-items.length == 0 : Text {
                                text: @tr("No matching items");
                                height: 32px;
                                color: AppTheme.muted-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            if root.context-search-query == "" && root.context-target-kind == 0 : TimelineContextRow {
                                title: @tr("Browse object catalog...");
                                activated => { root.browse-context-catalog(); }
                            }
                            if root.context-search-query == "" && root.context-target-kind == 0 : Rectangle {
                                height: 1px;
                                background: AppTheme.border;
                            }
                            if root.context-search-query == "" && root.context-target-kind == 0 : TimelineContextRow {
                                title: @tr("Add Object  ›");
                                activated => { root.open-context-catalog-menu(); }
                            }
                            if root.context-search-query == "" && root.context-target-kind == 0 : Rectangle {
                                height: 1px;
                                background: AppTheme.border;
                            }
                            if root.context-search-query == "" && root.context-target-kind == 0 : TimelineContextRow {
                                title: @tr("Undo");
                                activated => { root.activate-context-command("undo"); }
                            }
                            if root.context-search-query == "" && root.context-target-kind == 0 : TimelineContextRow {
                                title: @tr("Redo");
                                activated => { root.activate-context-command("redo"); }
                            }
                            if root.context-search-query == "" && root.context-target-kind == 0 : TimelineContextRow {
                                title: @tr("Paste");
                                activated => { root.activate-context-command("paste"); }
                            }
                            if root.context-search-query == "" && root.context-target-kind == 0 : Rectangle {
                                height: 1px;
                                background: AppTheme.border;
                            }
                            if root.context-search-query == "" && root.context-target-kind == 0 : TimelineContextRow {
                                title: @tr("Scene Settings...");
                                activated => { root.activate-context-command("scene-settings"); }
                            }
                            if root.context-search-query == "" && root.context-target-kind == 0 : TimelineContextRow {
                                title: @tr("Project Settings...");
                                activated => { root.activate-context-command("project-settings"); }
                            }
                            if root.context-search-query == "" && root.context-target-kind == 0 : TimelineContextRow {
                                title: @tr("Preferences...");
                                activated => { root.activate-context-command("system-settings"); }
                            }

                            if root.context-search-query == "" && root.context-target-kind > 0 : TimelineContextRow {
                                title: @tr("Delete");
                                activated => { root.activate-context-command("delete"); }
                            }
                            if root.context-search-query == "" && root.context-target-kind > 0 : TimelineContextRow {
                                title: @tr("Split");
                                activated => { root.activate-context-command("split"); }
                            }
                            if root.context-search-query == "" && root.context-target-kind > 0 : TimelineContextRow {
                                title: @tr("Duplicate");
                                activated => { root.activate-context-command("duplicate"); }
                            }
                            if root.context-search-query == "" && root.context-target-kind > 0 : Rectangle {
                                height: 1px;
                                background: AppTheme.border;
                            }
                            if root.context-search-query == "" && root.context-target-kind > 0 : TimelineContextRow {
                                title: @tr("timeline-cut" => "Cut");
                                activated => { root.activate-context-command("cut"); }
                            }
                            if root.context-search-query == "" && root.context-target-kind > 0 : TimelineContextRow {
                                title: @tr("Copy");
                                activated => { root.activate-context-command("copy"); }
                            }
                            if root.context-search-query == "" && root.context-target-kind == 1 : Rectangle {
                                height: 1px;
                                background: AppTheme.border;
                            }
                            if root.context-search-query == "" && root.context-target-kind == 1 : TimelineContextRow {
                                title: (root.context-clip-by-upper-object ? "✓  " : "    ") + @tr("Clip by Upper Object");
                                activated => { root.activate-context-command("clipping"); }
                            }
                            if root.context-search-query == "" && root.context-target-kind == 1 : TimelineContextRow {
                                title: @tr("Browse effect catalog...");
                                activated => { root.browse-context-catalog(); }
                            }
                            if root.context-search-query == "" && root.context-target-kind > 0 : Rectangle {
                                height: 1px;
                                background: AppTheme.border;
                            }
                            if root.context-search-query == "" && root.context-target-kind > 0 : TimelineContextRow {
                                title: @tr("Add Effect  ›");
                                activated => { root.open-context-catalog-menu(); }
                            }
                        }
                    }
                }
            }
        }
    }

    context-category-popup := PopupWindow {
        x: root.context-popup-x + 340px + 232px <= root.width
            ? root.context-popup-x + 340px
            : max(4px, root.context-popup-x - 232px);
        y: root.context-popup-y;
        width: 228px;
        height: min(420px, max(160px, root.height - root.context-popup-y - 8px));
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: AppTheme.panel-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 5px;
            VerticalLayout {
                padding: 5px;
                spacing: 3px;
                Text {
                    text: @tr("Add Object");
                    height: 28px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { height: 1px; background: AppTheme.border; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        for category[index] in root.object-catalog-categories : TimelineContextRow {
                            title: category + "  ›";
                            activated => { root.open-context-object-category(index); }
                        }
                    }
                }
            }
        }
    }

    context-catalog-popup := PopupWindow {
        private property <length> category-x: root.context-popup-x + 340px + 232px <= root.width
            ? root.context-popup-x + 340px
            : max(4px, root.context-popup-x - 232px);
        x: root.context-target-kind == 0
            ? (self.category-x + 228px + 304px <= root.width
                ? self.category-x + 228px
                : max(4px, self.category-x - 304px))
            : (root.context-popup-x + 340px + 304px <= root.width
                ? root.context-popup-x + 340px
                : max(4px, root.context-popup-x - 304px));
        y: root.context-popup-y;
        width: 300px;
        height: min(420px, max(160px, root.height - root.context-popup-y - 8px));
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: AppTheme.panel-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 5px;
            VerticalLayout {
                padding: 5px;
                spacing: 3px;
                Text {
                    text: root.context-target-kind == 0 ? @tr("Add Object") : @tr("Add Effect");
                    height: 28px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { height: 1px; background: AppTheme.border; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        if root.context-target-kind == 0 : VerticalLayout {
                            spacing: 2px;
                            for item in root.object-catalog-items : TimelineContextRow {
                                title: item.name;
                                activated => { root.activate-context-catalog-item(item.id); }
                            }
                        }
                        if root.context-target-kind > 0 : VerticalLayout {
                            spacing: 2px;
                            for item in root.context-catalog-items : TimelineContextRow {
                                title: item.categories == "" ? item.name : item.categories + " / " + item.name;
                                activated => { root.activate-context-catalog-item(item.id); }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.object-picker-visible : object-picker-focus := FocusScope {
        z: 200;
        width: 100%;
        height: 100%;
        forward-focus: object-search;
        init => { self.focus(); }
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.object-picker-visible = false;
                accept
            } else {
                reject
            }
        }
        TouchArea { clicked => { root.object-picker-visible = false; } }
        object-picker-panel := Rectangle {
            width: min(parent.width - 40px, 760px);
            height: min(parent.height - 40px, 560px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: AppTheme.raised-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 5px;
            TouchArea { }
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: @tr("Object List");
                    color: AppTheme.foreground;
                    font-size: 1.15rem;
                    font-weight: 700;
                }
                HorizontalLayout {
                    spacing: 8px;
                    object-search := LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.object-filter;
                        placeholder-text: @tr("Search name, category, ID, or package...");
                        edited(value) => {
                            root.object-catalog-selected-index = -1;
                            root.object-catalog-selected-id = "";
                            root.filter-objects(value, root.object-category-index);
                        }
                        accepted(value) => { root.accept-object-selection(); }
                    }
                    ComboBox {
                        width: 220px;
                        model: root.object-catalog-categories;
                        current-index <=> root.object-category-index;
                        selected(value) => {
                            root.object-catalog-selected-index = -1;
                            root.object-catalog-selected-id = "";
                            root.filter-objects(root.object-filter, self.current-index);
                        }
                    }
                }
                Text {
                    text: root.object-catalog-items.length + @tr(" items");
                    color: AppTheme.muted-foreground;
                }
                ScrollView {
                    vertical-stretch: 1;
                    accessible-role: list;
                    accessible-label: @tr("Object List");
                    VerticalLayout {
                        spacing: 4px;
                        for item[index] in root.object-catalog-items : Rectangle {
                            height: 64px;
                            background: index == root.object-catalog-selected-index
                                ? AppTheme.selection-background
                                : (item-touch.has-hover ? AppTheme.hover-background : AppTheme.panel-background);
                            border-width: 1px;
                            border-color: index == root.object-catalog-selected-index
                                ? AppTheme.accent
                                : AppTheme.subtle-border;
                            border-radius: AppTheme.control-radius;
                            animate background { duration: 120ms; }
                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                Text {
                                    text: item.name;
                                    color: AppTheme.foreground;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: item.categories == ""
                                        ? item.id
                                        : item.categories + "   ·   " + item.id;
                                    color: AppTheme.muted-foreground;
                                    overflow: elide;
                                }
                            }
                            item-touch := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: list-item;
                                accessible-id: "object-catalog-" + item.id;
                                accessible-label: item.name;
                                accessible-description: item.categories == ""
                                    ? item.id
                                    : item.categories + ", " + item.id;
                                accessible-item-selectable: true;
                                accessible-item-selected: index == root.object-catalog-selected-index;
                                accessible-item-index: index;
                                accessible-item-count: root.object-catalog-items.length;
                                accessible-action-default => {
                                    root.object-catalog-selected-index = index;
                                    root.object-catalog-selected-id = item.id;
                                }
                                clicked => {
                                    root.object-catalog-selected-index = index;
                                    root.object-catalog-selected-id = item.id;
                                }
                                double-clicked => {
                                    root.object-catalog-selected-index = index;
                                    root.object-catalog-selected-id = item.id;
                                    root.accept-object-selection();
                                }
                            }
                        }
                        if root.object-catalog-items.length == 0 : Text {
                            text: @tr("No matching objects");
                            color: AppTheme.muted-foreground;
                            horizontal-alignment: center;
                        }
                    }
                }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: @tr("Cancel");
                        clicked => { root.object-picker-visible = false; }
                    }
                    Button {
                        text: @tr("Add");
                        enabled: root.object-catalog-selected-id != "";
                        clicked => { root.accept-object-selection(); }
                    }
                }
            }
        }
    }
}

export component ExportWindow inherits Window {
    title: @tr("Export Media");
    preferred-width: 620px;
    preferred-height: 580px;
    min-width: 520px;
    min-height: 460px;

    in property <int> project-width: 1920;
    in property <int> project-height: 1080;
    in property <float> project-fps: 60;
    in property <int> timeline-duration: 300;
    in-out property <int> format-index: 0;
    in-out property <int> image-format-index: 0;
    in-out property <string> output-path: "";
    in property <[string]> video-codec-labels;
    in-out property <int> video-codec-index: 0;
    in-out property <bool> software-codec: true;
    in-out property <bool> crf-mode: true;
    in-out property <bool> bitrate-mode: false;
    in-out property <float> crf: 20;
    in-out property <int> bitrate-mbps: 15;
    in-out property <int> preset-index: 2;
    in-out property <int> profile-index: 0;
    in property <[string]> audio-codec-labels;
    in-out property <int> audio-codec-index: 0;
    in-out property <bool> audio-bitrate-enabled: true;
    in-out property <int> audio-bitrate-index: 2;
    in-out property <bool> full-range: true;
    in-out property <int> start-frame: 0;
    in-out property <int> end-frame: 300;
    in property <bool> exporting: false;
    in property <float> export-progress: 0;
    in property <string> progress-label: @tr("0 / 0 frames");
    in-out property <bool> cancel-confirmation-visible: false;
    in-out property <bool> result-visible: false;
    in property <bool> result-success: true;
    in property <string> result-message: "";

    pure callback validate-output-path(string) -> bool;
    callback browse-output(bool);
    callback video-codec-selected(int);
    callback audio-codec-selected(int);
    callback start-export();
    callback close-window();
    callback request-cancel();
    callback confirm-cancel();
    callback dismiss-cancel();
    callback dismiss-result();

    ScrollView {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 8px;
                Text { text: @tr("Format:"); vertical-alignment: center; }
                ComboBox {
                    model: [@tr("Video File"), @tr("Image Sequence")];
                    current-index <=> root.format-index;
                }
                if root.format-index == 1 : ComboBox {
                    model: ["PNG", "JPEG"];
                    current-index <=> root.image-format-index;
                }
                LineEdit {
                    text <=> root.output-path;
                    placeholder-text: root.format-index == 1 ? @tr("Destination folder...") : @tr("Destination file path...");
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("Browse...");
                    clicked => { root.browse-output(root.format-index == 1); }
                }
            }

            if root.format-index == 0 : GroupBox {
                title: @tr("Video");
                GridLayout {
                    padding: 10px;
                    spacing: 9px;
                    Row {
                        Text { text: @tr("Resolution:"); vertical-alignment: center; }
                        Text { text: root.project-width + " × " + root.project-height; font-weight: 700; vertical-alignment: center; }
                    }
                    Row {
                        Text { text: "FPS:"; vertical-alignment: center; }
                        Text { text: root.project-fps.to-fixed(3); font-weight: 700; vertical-alignment: center; }
                    }
                    Row {
                        Text { text: @tr("Codec:"); vertical-alignment: center; }
                        ComboBox {
                            model: root.video-codec-labels;
                            current-index <=> root.video-codec-index;
                            selected(value) => { root.video-codec-selected(self.current-index); }
                        }
                    }
                    Row {
                        Text { text: @tr("Quality mode:"); vertical-alignment: center; }
                        RadioGroup {
                            orientation: Orientation.horizontal;
                            RadioButton { text: "CRF"; checked <=> root.crf-mode; }
                            RadioButton { text: @tr("Bitrate"); checked <=> root.bitrate-mode; }
                        }
                    }
                    if root.crf-mode : Row {
                        Text { text: "CRF:"; vertical-alignment: center; }
                        HorizontalLayout {
                            spacing: 8px;
                            Slider { value <=> root.crf; minimum: 0; maximum: 51; horizontal-stretch: 1; }
                            Text { text: root.crf.round(); preferred-width: 28px; vertical-alignment: center; }
                            Text {
                                text: root.crf <= 17 ? @tr("High quality") : root.crf <= 28 ? @tr("Standard") : @tr("Low quality");
                                color: root.crf <= 17 ? AppTheme.success : root.crf <= 28 ? AppTheme.muted-foreground : AppTheme.danger;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if root.bitrate-mode : Row {
                        Text { text: @tr("Bitrate:"); vertical-alignment: center; }
                        HorizontalLayout {
                            SpinBox { value <=> root.bitrate-mbps; minimum: 1; maximum: 500; }
                            Text { text: "Mbps"; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                    if root.software-codec : Row {
                        Text { text: @tr("Preset:"); vertical-alignment: center; }
                        ComboBox {
                            model: [@tr("Fastest (ultrafast)"), @tr("Fast (fast)"), @tr("Standard (medium)"), @tr("High quality (slow)"), @tr("Highest quality (veryslow)")];
                            current-index <=> root.preset-index;
                        }
                    }
                    if root.software-codec : Row {
                        Text { text: @tr("Profile:"); vertical-alignment: center; }
                        ComboBox {
                            model: [@tr("Auto"), "Baseline", "Main", "High"];
                            current-index <=> root.profile-index;
                        }
                    }
                }
            }

            if root.format-index == 0 : GroupBox {
                title: @tr("Audio");
                GridLayout {
                    padding: 10px;
                    spacing: 9px;
                    Row {
                        Text { text: @tr("Codec:"); vertical-alignment: center; }
                        ComboBox {
                            model: root.audio-codec-labels;
                            current-index <=> root.audio-codec-index;
                            selected(value) => { root.audio-codec-selected(self.current-index); }
                        }
                    }
                    Row {
                        Text { text: @tr("Bitrate:"); vertical-alignment: center; }
                        ComboBox {
                            model: ["96 kbps", "128 kbps", "192 kbps", "256 kbps", "320 kbps"];
                            current-index <=> root.audio-bitrate-index;
                            enabled: root.audio-bitrate-enabled;
                        }
                    }
                }
            }

            GroupBox {
                title: @tr("Range");
                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;
                    CheckBox { text: @tr("Entire timeline"); checked <=> root.full-range; }
                    Text { text: @tr("Start:"); vertical-alignment: center; }
                    SpinBox {
                        value <=> root.start-frame;
                        minimum: 0;
                        maximum: max(root.end-frame - 1, 0);
                        enabled: !root.full-range;
                    }
                    Text { text: @tr("End:"); vertical-alignment: center; }
                    SpinBox {
                        value <=> root.end-frame;
                        minimum: root.start-frame + 1;
                        maximum: 999999;
                        enabled: !root.full-range;
                    }
                    Text {
                        text: "(" + (root.full-range ? root.timeline-duration : root.end-frame - root.start-frame)
                            + @tr(" frames / ")
                            + ((root.full-range ? root.timeline-duration : root.end-frame - root.start-frame) / max(root.project-fps, 1)).to-fixed(2)
                            + @tr(" sec)");
                        opacity: 0.65;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: @tr("Cancel"); clicked => { root.close-window(); } }
                Button {
                    text: @tr("Start Export");
                    enabled: root.validate-output-path(root.output-path);
                    clicked => { root.start-export(); }
                }
            }
        }
    }

    if root.exporting : Rectangle {
        z: 1000;
        width: 100%;
        height: 100%;
        background: AppTheme.scrim;
        TouchArea { }
        Rectangle {
            width: min(parent.width * 0.7, 430px);
            height: 180px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: transparent;
            VerticalLayout {
                spacing: 16px;
                Text { text: @tr("Exporting..."); color: white; font-size: 1.05rem; font-weight: 700; horizontal-alignment: center; }
                ProgressIndicator { progress: root.export-progress / 100; }
                Text { text: root.progress-label; color: #ffffffcc; horizontal-alignment: center; }
                HorizontalLayout {
                    alignment: center;
                    Button { text: @tr("Cancel"); clicked => { root.request-cancel(); } }
                }
            }
        }
    }

    if root.cancel-confirmation-visible : Rectangle {
        z: 1100;
        width: 100%;
        height: 100%;
        background: AppTheme.scrim;
        TouchArea { }
        Rectangle {
            width: 330px;
            height: 170px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: AppTheme.raised-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 6px;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text { text: @tr("Cancel Export"); color: AppTheme.foreground; font-size: 1.1rem; font-weight: 700; }
                Text { text: @tr("Cancel the export?\nProgress will be lost."); color: AppTheme.muted-foreground; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: @tr("Yes"); clicked => { root.confirm-cancel(); } }
                    Button { text: @tr("No"); clicked => { root.dismiss-cancel(); } }
                }
            }
        }
    }

    if root.result-visible : Rectangle {
        z: 1200;
        width: 100%;
        height: 100%;
        background: AppTheme.scrim;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 32px, 450px);
            height: 170px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: AppTheme.raised-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 6px;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text { text: root.result-success ? @tr("Complete") : @tr("Error"); color: AppTheme.foreground; font-size: 1.1rem; font-weight: 700; }
                Text { text: root.result-message; color: AppTheme.muted-foreground; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    Button { text: "OK"; clicked => { root.dismiss-result(); } }
                }
            }
        }
    }
}

export component ProjectSettingsWindow inherits Window {
    title: @tr("Project Settings");
    preferred-width: 450px;
    preferred-height: 240px;
    min-width: 390px;
    min-height: 220px;

    in-out property <int> project-width: 1920;
    in-out property <int> project-height: 1080;
    in-out property <string> project-fps: "60";
    in-out property <int> project-sample-rate: 48000;
    callback apply-settings() -> bool;
    callback close-window();

    VerticalLayout {
        padding: 16px;
        spacing: 14px;
        GridLayout {
            spacing: 10px;
            Row {
                Text { text: @tr("settings-width" => "Width:"); vertical-alignment: center; }
                SpinBox { value <=> root.project-width; minimum: 1; maximum: 8000; }
            }
            Row {
                Text { text: @tr("settings-height" => "Height:"); vertical-alignment: center; }
                SpinBox { value <=> root.project-height; minimum: 1; maximum: 8000; }
            }
            Row {
                Text { text: "FPS:"; vertical-alignment: center; }
                LineEdit { text <=> root.project-fps; }
            }
            Row {
                Text { text: @tr("Sample Rate:"); vertical-alignment: center; }
                SpinBox { value <=> root.project-sample-rate; minimum: 8000; maximum: 192000; step-size: 1000; }
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Button {
                text: @tr("Apply");
                clicked => {
                    if root.apply-settings() {
                        root.close-window();
                    }
                }
            }
            Button { text: @tr("Cancel"); clicked => { root.close-window(); } }
        }
    }
}

export component SceneSettingsWindow inherits Window {
    title: root.creation-mode ? @tr("Create New Scene") : @tr("Scene Settings");
    preferred-width: 450px;
    preferred-height: 550px;
    min-width: 410px;
    min-height: 460px;

    in-out property <bool> creation-mode: false;
    in-out property <int> target-scene-id: -1;
    in-out property <string> scene-name: "";
    in-out property <int> scene-width: 1920;
    in-out property <int> scene-height: 1080;
    in-out property <string> scene-fps: "60";
    in-out property <int> scene-duration: 3600;
    in-out property <int> grid-mode-index: 0;
    in-out property <string> grid-bpm: "120";
    in-out property <string> grid-offset: "0";
    in-out property <string> grid-interval: "10";
    in-out property <string> grid-subdivision: "4";
    in-out property <bool> enable-snap: true;
    in-out property <int> magnetic-snap-range: 10;
    callback apply-settings() -> bool;
    callback close-window();

    ScrollView {
        VerticalLayout {
            padding: 15px;
            spacing: 14px;
            GroupBox {
                title: @tr("Basic Settings");
                GridLayout {
                    padding: 10px;
                    spacing: 9px;
                    Row {
                        Text { text: @tr("Scene Name:"); vertical-alignment: center; }
                        LineEdit { text <=> root.scene-name; }
                    }
                    Row {
                        Text { text: @tr("settings-width" => "Width:"); vertical-alignment: center; }
                        SpinBox { value <=> root.scene-width; minimum: 1; maximum: 8000; }
                    }
                    Row {
                        Text { text: @tr("settings-height" => "Height:"); vertical-alignment: center; }
                        SpinBox { value <=> root.scene-height; minimum: 1; maximum: 8000; }
                    }
                    Row {
                        Text { text: "FPS:"; vertical-alignment: center; }
                        LineEdit { text <=> root.scene-fps; }
                    }
                }
            }
            GroupBox {
                title: @tr("Editing and Snap");
                GridLayout {
                    padding: 10px;
                    spacing: 9px;
                    Row {
                        Text { text: @tr("Enable Snap:"); vertical-alignment: center; }
                        CheckBox { checked <=> root.enable-snap; }
                    }
                    Row {
                        Text { text: @tr("Magnetic Snap Range:"); vertical-alignment: center; }
                        SpinBox { value <=> root.magnetic-snap-range; minimum: 1; maximum: 100; }
                    }
                    Row {
                        Text { text: @tr("Grid Mode:"); vertical-alignment: center; }
                        ComboBox {
                            model: [@tr("Auto (Seconds/Frames)"), @tr("BPM (Music)"), @tr("Fixed Frame Count")];
                            current-index <=> root.grid-mode-index;
                        }
                    }
                }
            }
            if root.grid-mode-index == 1 : GroupBox {
                title: @tr("BPM Settings");
                GridLayout {
                    padding: 10px;
                    spacing: 9px;
                    Row { Text { text: "BPM:"; vertical-alignment: center; } LineEdit { text <=> root.grid-bpm; } }
                    Row { Text { text: @tr("Time Signature (Subdivisions):"); vertical-alignment: center; } LineEdit { text <=> root.grid-subdivision; } }
                    Row { Text { text: @tr("Offset (Seconds):"); vertical-alignment: center; } LineEdit { text <=> root.grid-offset; } }
                }
            }
            if root.grid-mode-index == 2 : GroupBox {
                title: @tr("Frame Settings");
                GridLayout {
                    padding: 10px;
                    spacing: 9px;
                    Row { Text { text: @tr("Interval (Frames):"); vertical-alignment: center; } LineEdit { text <=> root.grid-interval; } }
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: @tr("Cancel"); clicked => { root.close-window(); } }
                Button {
                    text: "OK";
                    clicked => {
                        if root.apply-settings() {
                            root.close-window();
                        }
                    }
                }
            }
        }
    }
}

component SystemSettingSpinRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step-size: 1;
    in property <bool> interactive: true;
    spacing: AppTheme.spacing-md;
    opacity: root.interactive ? 1 : 0.5;
    Text {
        text: root.label;
        width: 240px;
        color: AppTheme.muted-foreground;
        vertical-alignment: center;
        overflow: elide;
    }
    SpinBox {
        value <=> root.value;
        minimum: root.minimum;
        maximum: root.maximum;
        step-size: root.step-size;
        enabled: root.interactive;
        accessible-label: root.label;
        horizontal-stretch: 1;
    }
}

component SystemSettingComboRow inherits HorizontalLayout {
    in property <string> label;
    in property <[string]> choices;
    in-out property <int> current-index;
    spacing: AppTheme.spacing-md;
    Text {
        text: root.label;
        width: 240px;
        color: AppTheme.muted-foreground;
        vertical-alignment: center;
        overflow: elide;
    }
    ComboBox {
        model: root.choices;
        current-index <=> root.current-index;
        accessible-label: root.label;
        horizontal-stretch: 1;
    }
}

component SystemSettingLineRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> placeholder;
    callback commit(string);
    spacing: AppTheme.spacing-md;
    Text {
        text: root.label;
        width: 240px;
        color: AppTheme.muted-foreground;
        vertical-alignment: center;
        overflow: elide;
    }
    CommitLineEdit {
        source-text: root.value;
        placeholder-text: root.placeholder;
        accessible-label: root.label;
        horizontal-stretch: 1;
        commit(value) => { root.commit(value); }
    }
}

component SystemSettingsNavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated();
    height: 38px;
    background: root.selected ? AppTheme.selection-background : nav-touch.has-hover ? AppTheme.hover-background : transparent;
    border-radius: AppTheme.control-radius;
    animate background { duration: 150ms; }

    if root.selected : Rectangle {
        x: 3px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 20px;
        background: AppTheme.accent;
        border-radius: 2px;
    }
    Text {
        x: AppTheme.spacing-lg;
        width: parent.width - self.x - AppTheme.spacing-sm;
        text: root.label;
        color: AppTheme.foreground;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    nav-touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: tab;
        accessible-label: root.label;
        accessible-item-selectable: true;
        accessible-item-selected: root.selected;
        accessible-action-default => { root.activated(); }
        clicked => { root.activated(); }
    }
}

export component SystemSettingsWindow inherits Window {
    title: @tr("Preferences");
    preferred-width: 960px;
    preferred-height: 680px;
    min-width: 760px;
    min-height: 520px;

    in-out property <int> tab-index: 0;
    in-out property <bool> confirm-unsaved: true;
    in-out property <bool> auto-backup: true;
    in-out property <int> backup-interval: 5;
    in-out property <int> recent-project-max-count: 10;
    in-out property <int> undo-count: 32;
    in-out property <int> splash-size: 512;
    in-out property <int> max-image-size: 8192;
    in-out property <int> cache-size: 512;
    in-out property <int> preview-render-scale-index: 0;
    in-out property <int> preview-msaa-index: 0;
    in-out property <int> bake-strategy-index: 0;
    in-out property <int> on-demand-prefetch-frames: 30;
    in-out property <bool> enable-timeline-skimming: true;
    in-out property <int> timeline-track-height: 30;
    in-out property <int> timeline-header-height: 28;
    in-out property <bool> setting-dialog-sidebar-right: false;
    in-out property <int> timeline-ruler-height: 32;
    in-out property <int> timeline-max-layers: 128;
    in-out property <int> timeline-layer-header-width: 60;
    in-out property <int> timeline-clip-resize-handle-width: 10;
    in-out property <int> min-clip-duration-frames: 5;
    in-out property <int> timeline-zoom-min: 10;
    in-out property <int> timeline-zoom-max: 400;
    in-out property <int> timeline-zoom-step: 10;
    in-out property <int> theme-index: 0;
    in-out property <int> language-index: 0;
    in-out property <int> default-project-width: 1920;
    in-out property <int> default-project-height: 1080;
    in-out property <string> default-project-fps: "60";
    in-out property <int> default-project-frames: 3600;
    in-out property <int> default-project-sample-rate: 48000;
    in-out property <int> default-clip-duration: 100;
    in-out property <int> export-video-codec-index: 2;
    in-out property <int> export-default-bitrate-mbps: 15;
    in-out property <int> export-default-crf: 20;
    in-out property <int> export-image-quality: 95;
    in-out property <int> export-sequence-padding: 6;
    in-out property <int> export-audio-codec-index: 0;
    in-out property <int> export-default-audio-bitrate-kbps: 192;
    in-out property <int> export-frame-grab-timeout-ms: 2000;
    in-out property <int> export-progress-interval: 5;
    in-out property <int> export-encoder-queue-mb: 128;
    in-out property <int> video-decoder-index-reserve: 108000;
    in-out property <int> video-decoder-min-cache-mb: 64;
    in-out property <int> hw-frame-pool-size: 32;
    in-out property <int> audio-plugin-block-size-index: 4;
    in-out property <int> lua-hook-interval-ms: 16;
    in-out property <bool> lua-hot-reload: false;
    in property <[SystemPluginSettingData]> plugin-settings;
    in property <[SystemShortcutSettingData]> shortcut-settings;
    callback plugin-enabled-changed(int, bool);
    callback plugin-paths-changed(int, string);
    callback shortcut-value-changed(int, string);
    callback reload-settings();
    callback apply-settings() -> bool;
    callback close-window();

    pure function shortcut-name(action-id: string) -> string {
        if action-id == "project.new" { return @tr("New Project"); }
        if action-id == "project.open" { return @tr("Open Project"); }
        if action-id == "project.save" { return @tr("save-project" => "Save"); }
        if action-id == "project.saveAs" { return @tr("Save As"); }
        if action-id == "project.export" { return @tr("Export Media"); }
        if action-id == "app.quit" { return @tr("Exit"); }
        if action-id == "app.settings" { return @tr("Preferences"); }
        if action-id == "edit.undo" { return @tr("Undo"); }
        if action-id == "edit.redo" { return @tr("Redo"); }
        if action-id == "edit.cut" { return @tr("edit-menu-cut" => "Cut"); }
        if action-id == "edit.copy" { return @tr("Copy"); }
        if action-id == "edit.paste" { return @tr("Paste"); }
        if action-id == "edit.delete" { return @tr("Delete"); }
        if action-id == "edit.duplicate" { return @tr("Duplicate"); }
        if action-id == "transport.playPause" { return @tr("Play / Pause"); }
        if action-id == "transport.nextFrame" { return @tr("Forward 1 Frame"); }
        if action-id == "transport.prevFrame" { return @tr("Back 1 Frame"); }
        if action-id == "transport.jumpStart" { return @tr("Go to Start"); }
        if action-id == "transport.jumpEnd" { return @tr("Go to End"); }
        if action-id == "view.zoomIn" { return @tr("Zoom In"); }
        if action-id == "view.zoomOut" { return @tr("Zoom Out"); }
        if action-id == "view.timeline" { return @tr("Show Timeline"); }
        if action-id == "view.objectSettings" { return @tr("Show Settings Dialog"); }
        if action-id == "project.settings" { return @tr("Project Settings"); }
        if action-id == "timeline.split" { return @tr("Split Clip"); }
        if action-id == "timeline.moveUp" { return @tr("Move Layer Up"); }
        if action-id == "timeline.moveDown" { return @tr("Move Layer Down"); }
        if action-id == "timeline.nudgeLeft" { return @tr("Move Left 1 Frame"); }
        if action-id == "timeline.nudgeRight" { return @tr("Move Right 1 Frame"); }
        if action-id == "timeline.addScene" { return @tr("Create New Scene"); }
        if action-id == "timeline.sceneSettings" { return @tr("Current Scene Settings"); }
        if action-id == "timeline.removeScene" { return @tr("Delete Current Scene"); }
        if action-id == "timeline.layerLock" { return @tr("Lock/Unlock Current Layer"); }
        if action-id == "timeline.layerHide" { return @tr("Show/Hide Current Layer"); }
        return action-id;
    }

    VerticalLayout {
        padding: AppTheme.spacing-md;
        spacing: AppTheme.spacing-md;
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: AppTheme.spacing-md;

            Rectangle {
                width: 180px;
                background: AppTheme.panel-background;
                border-width: 1px;
                border-color: AppTheme.subtle-border;
                border-radius: AppTheme.surface-radius;
                VerticalLayout {
                    padding: AppTheme.spacing-sm;
                    spacing: AppTheme.spacing-xs;
                    accessible-role: tab-list;
                    accessible-label: @tr("Preferences");
                    for tab-label[index] in [
                        @tr("General"), @tr("Performance"), @tr("Timeline"), @tr("Appearance"),
                        @tr("New Project"), @tr("Export"), @tr("Decode and Audio"),
                        @tr("Plugins"), @tr("Shortcuts")
                    ] : SystemSettingsNavItem {
                        label: tab-label;
                        selected: root.tab-index == index;
                        activated => { root.tab-index = index; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;

        if root.tab-index == 0 : ScrollView {
            vertical-stretch: 1;
            accessible-role: tab-panel;
            accessible-label: @tr("General");
            viewport-width: self.visible-width;
            viewport-height: general-page.preferred-height;
            general-page := VerticalLayout {
                spacing: 14px;
                GroupBox {
                    title: @tr("File");
                    VerticalLayout {
                        padding: 10px;
                        spacing: 9px;
                        CheckBox { text: @tr("Check for unsaved projects when exiting"); checked <=> root.confirm-unsaved; }
                        CheckBox { text: @tr("Enable automatic backups"); checked <=> root.auto-backup; }
                        SystemSettingSpinRow {
                            label: @tr("Backup interval");
                            value <=> root.backup-interval;
                            minimum: 1;
                            maximum: 60;
                            interactive: root.auto-backup;
                        }
                        SystemSettingSpinRow {
                            label: @tr("Number of recent projects to keep");
                            value <=> root.recent-project-max-count;
                            minimum: 1;
                            maximum: 50;
                        }
                    }
                }
                GroupBox {
                    title: @tr("Edit");
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        SystemSettingSpinRow { label: @tr("Undo count"); value <=> root.undo-count; minimum: 1; maximum: 1000; }
                        Text { text: @tr("Increasing this count increases memory usage"); color: AppTheme.muted-foreground; }
                    }
                }
                GroupBox {
                    title: @tr("Startup");
                    VerticalLayout {
                        padding: 10px;
                        SystemSettingSpinRow { label: @tr("Splash image size"); value <=> root.splash-size; minimum: 128; maximum: 2048; step-size: 64; }
                    }
                }
            }
        }

        if root.tab-index == 1 : ScrollView {
            vertical-stretch: 1;
            accessible-role: tab-panel;
            accessible-label: @tr("Performance");
            viewport-width: self.visible-width;
            viewport-height: performance-page.preferred-height;
            performance-page := VerticalLayout {
                spacing: 14px;
                GroupBox {
                    title: @tr("Memory and Cache");
                    VerticalLayout {
                        padding: 10px;
                        spacing: 9px;
                        SystemSettingSpinRow { label: @tr("Maximum image size"); value <=> root.max-image-size; minimum: 1024; maximum: 16384; step-size: 512; }
                        SystemSettingSpinRow { label: @tr("Cache capacity"); value <=> root.cache-size; minimum: 64; maximum: 8192; step-size: 64; }
                    }
                }
                GroupBox {
                    title: @tr("Preview rendering");
                    VerticalLayout {
                        padding: 10px;
                        spacing: 9px;
                        SystemSettingComboRow { label: @tr("Render scale"); choices: ["100%", "75%", "50%", "25%"]; current-index <=> root.preview-render-scale-index; }
                        SystemSettingComboRow { label: @tr("Preview antialiasing"); choices: [@tr("Disabled"), "2x MSAA", "4x MSAA", "8x MSAA"]; current-index <=> root.preview-msaa-index; }
                    }
                }
                GroupBox {
                    title: @tr("Timeline baking");
                    VerticalLayout {
                        padding: 10px;
                        spacing: 9px;
                        SystemSettingComboRow { label: @tr("Strategy"); choices: [@tr("On demand"), @tr("Bake all clips")]; current-index <=> root.bake-strategy-index; }
                        SystemSettingSpinRow {
                            label: @tr("Prefetch frames");
                            value <=> root.on-demand-prefetch-frames;
                            minimum: 0;
                            maximum: 600;
                            step-size: 10;
                            interactive: root.bake-strategy-index == 0;
                        }
                    }
                }
            }
        }

        if root.tab-index == 2 : ScrollView {
            vertical-stretch: 1;
            accessible-role: tab-panel;
            accessible-label: @tr("Timeline");
            viewport-width: self.visible-width;
            viewport-height: timeline-settings-page.preferred-height;
            timeline-settings-page := VerticalLayout {
                spacing: 14px;
                GroupBox {
                    title: @tr("Controls");
                    VerticalLayout {
                        padding: 10px;
                        CheckBox { text: @tr("Enable timeline skimming"); checked <=> root.enable-timeline-skimming; }
                    }
                }
                GroupBox {
                    title: @tr("Appearance and Dimensions");
                    VerticalLayout {
                        padding: 10px;
                        spacing: 9px;
                        SystemSettingSpinRow { label: @tr("Track height"); value <=> root.timeline-track-height; minimum: 16; maximum: 100; }
                        SystemSettingSpinRow { label: @tr("Header height"); value <=> root.timeline-header-height; minimum: 16; maximum: 100; }
                        CheckBox { text: @tr("Place settings sidebar on the right"); checked <=> root.setting-dialog-sidebar-right; }
                        SystemSettingSpinRow { label: @tr("Ruler height"); value <=> root.timeline-ruler-height; minimum: 16; maximum: 100; }
                        SystemSettingSpinRow { label: @tr("Maximum layer count"); value <=> root.timeline-max-layers; minimum: 1; maximum: 512; }
                        SystemSettingSpinRow { label: @tr("Layer header width"); value <=> root.timeline-layer-header-width; minimum: 40; maximum: 300; }
                        SystemSettingSpinRow { label: @tr("Clip edge handle width"); value <=> root.timeline-clip-resize-handle-width; minimum: 4; maximum: 40; }
                    }
                }
                GroupBox {
                    title: @tr("Editing Constraints and Zoom");
                    VerticalLayout {
                        padding: 10px;
                        spacing: 9px;
                        SystemSettingSpinRow { label: @tr("Minimum clip length"); value <=> root.min-clip-duration-frames; minimum: 1; maximum: 100; }
                        SystemSettingSpinRow { label: @tr("Minimum zoom value"); value <=> root.timeline-zoom-min; minimum: 1; maximum: 1000; }
                        SystemSettingSpinRow { label: @tr("Maximum zoom value"); value <=> root.timeline-zoom-max; minimum: 1; maximum: 4000; }
                        SystemSettingSpinRow { label: @tr("Zoom step"); value <=> root.timeline-zoom-step; minimum: 1; maximum: 100; }
                    }
                }
            }
        }

        if root.tab-index == 3 : ScrollView {
            vertical-stretch: 1;
            accessible-role: tab-panel;
            accessible-label: @tr("Appearance");
            viewport-width: self.visible-width;
            viewport-height: appearance-page.preferred-height;
            appearance-page := VerticalLayout {
                spacing: 14px;
                GroupBox {
                    title: @tr("Theme");
                    VerticalLayout {
                        padding: 10px;
                        SystemSettingComboRow { label: @tr("Color theme"); choices: [@tr("Dark"), @tr("Light"), @tr("Follow system")]; current-index <=> root.theme-index; }
                    }
                }
                GroupBox {
                    title: @tr("Language");
                    VerticalLayout {
                        padding: 10px;
                        spacing: 9px;
                        SystemSettingComboRow {
                            label: @tr("Interface language");
                            choices: [@tr("Follow system"), "English", "简体中文", "日本語"];
                            current-index <=> root.language-index;
                        }
                        Text {
                            text: @tr("Language changes are applied immediately after pressing Apply or OK.");
                            color: AppTheme.muted-foreground;
                            wrap: word-wrap;
                        }
                    }
                }
                Text { text: @tr("Theme changes take effect immediately after you click Apply or OK."); color: AppTheme.muted-foreground; wrap: word-wrap; }
            }
        }

        if root.tab-index == 4 : ScrollView {
            vertical-stretch: 1;
            accessible-role: tab-panel;
            accessible-label: @tr("New Project");
            viewport-width: self.visible-width;
            viewport-height: project-defaults-page.preferred-height;
            project-defaults-page := VerticalLayout {
                spacing: 14px;
                GroupBox {
                    title: @tr("Defaults");
                    VerticalLayout {
                        padding: 10px;
                        spacing: 9px;
                        SystemSettingSpinRow { label: @tr("Width"); value <=> root.default-project-width; minimum: 1; maximum: 16000; }
                        SystemSettingSpinRow { label: @tr("Height"); value <=> root.default-project-height; minimum: 1; maximum: 16000; }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: @tr("Frame rate"); width: 260px; vertical-alignment: center; }
                            LineEdit { text <=> root.default-project-fps; accessible-label: @tr("Frame rate"); horizontal-stretch: 1; }
                        }
                        SystemSettingSpinRow { label: @tr("Total frames"); value <=> root.default-project-frames; minimum: 1; maximum: 1000000; }
                        SystemSettingSpinRow { label: @tr("Sample rate"); value <=> root.default-project-sample-rate; minimum: 8000; maximum: 192000; step-size: 1000; }
                        SystemSettingSpinRow { label: @tr("Default clip length"); value <=> root.default-clip-duration; minimum: 1; maximum: 100000; }
                    }
                }
            }
        }

        if root.tab-index == 5 : ScrollView {
            vertical-stretch: 1;
            accessible-role: tab-panel;
            accessible-label: @tr("Export");
            viewport-width: self.visible-width;
            viewport-height: export-settings-page.preferred-height;
            export-settings-page := VerticalLayout {
                spacing: 14px;
                GroupBox {
                    title: @tr("Video");
                    VerticalLayout {
                        padding: 10px;
                        spacing: 9px;
                        SystemSettingComboRow { label: @tr("Default video codec"); choices: [@tr("H.264 (VAAPI)"), @tr("HEVC (VAAPI)"), @tr("H.264 (CPU)")]; current-index <=> root.export-video-codec-index; }
                        SystemSettingSpinRow { label: @tr("Default bitrate"); value <=> root.export-default-bitrate-mbps; minimum: 1; maximum: 500; }
                        SystemSettingSpinRow { label: @tr("Default CRF"); value <=> root.export-default-crf; minimum: 0; maximum: 51; }
                        SystemSettingSpinRow { label: @tr("Still image quality"); value <=> root.export-image-quality; minimum: 0; maximum: 100; }
                        SystemSettingSpinRow { label: @tr("Sequence number digits"); value <=> root.export-sequence-padding; minimum: 2; maximum: 10; }
                    }
                }
                GroupBox {
                    title: @tr("Audio and Progress Display");
                    VerticalLayout {
                        padding: 10px;
                        spacing: 9px;
                        SystemSettingComboRow { label: @tr("Default audio codec"); choices: ["AAC", "Opus", "FLAC", "PCM 16bit"]; current-index <=> root.export-audio-codec-index; }
                        SystemSettingSpinRow { label: @tr("Audio bitrate"); value <=> root.export-default-audio-bitrate-kbps; minimum: 32; maximum: 1536; step-size: 32; }
                        SystemSettingSpinRow { label: @tr("Frame fetch wait time"); value <=> root.export-frame-grab-timeout-ms; minimum: 100; maximum: 10000; step-size: 100; }
                        SystemSettingSpinRow { label: @tr("Progress update interval"); value <=> root.export-progress-interval; minimum: 1; maximum: 60; }
                        SystemSettingSpinRow { label: @tr("Encoder queue memory (MB)"); value <=> root.export-encoder-queue-mb; minimum: 16; maximum: 1024; step-size: 16; }
                    }
                }
            }
        }

        if root.tab-index == 6 : ScrollView {
            vertical-stretch: 1;
            accessible-role: tab-panel;
            accessible-label: @tr("Decode and Audio");
            viewport-width: self.visible-width;
            viewport-height: decode-audio-page.preferred-height;
            decode-audio-page := VerticalLayout {
                spacing: 14px;
                GroupBox {
                    title: @tr("Video Decoding");
                    VerticalLayout {
                        padding: 10px;
                        spacing: 9px;
                        SystemSettingSpinRow { label: @tr("Reserved index count"); value <=> root.video-decoder-index-reserve; minimum: 1000; maximum: 1000000; step-size: 1000; }
                        SystemSettingSpinRow { label: @tr("Minimum cache amount"); value <=> root.video-decoder-min-cache-mb; minimum: 16; maximum: 4096; step-size: 16; }
                        SystemSettingSpinRow { label: @tr("Hardware frame pool count"); value <=> root.hw-frame-pool-size; minimum: 1; maximum: 256; }
                    }
                }
                GroupBox {
                    title: @tr("Audio");
                    VerticalLayout {
                        padding: 10px;
                        spacing: 9px;
                        SystemSettingComboRow { label: @tr("Maximum plugin block size"); choices: ["256", "512", "1024", "2048", "4096", "8192"]; current-index <=> root.audio-plugin-block-size-index; }
                        SystemSettingSpinRow { label: @tr("Lua hook interval"); value <=> root.lua-hook-interval-ms; minimum: 1; maximum: 1000; }
                    }
                }
                Text { text: @tr("Decode and audio settings take effect after restart"); color: AppTheme.muted-foreground; wrap: word-wrap; }
            }
        }

        if root.tab-index == 7 : ScrollView {
            vertical-stretch: 1;
            accessible-role: tab-panel;
            accessible-label: @tr("Plugins");
            viewport-width: self.visible-width;
            viewport-height: plugin-page.preferred-height;
            plugin-page := VerticalLayout {
                spacing: 14px;
                Text { text: @tr("You can configure enablement and search paths for each format"); color: AppTheme.muted-foreground; wrap: word-wrap; }
                GroupBox {
                    title: @tr("Lua Plugins");
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        CheckBox { text: @tr("Enable Hot Reload"); checked <=> root.lua-hot-reload; }
                        Text { text: @tr("When enabled, automatically reloads plugins when changes to the plugins folder are detected"); color: AppTheme.muted-foreground; wrap: word-wrap; }
                    }
                }
                for plugin[index] in root.plugin-settings : GroupBox {
                    title: plugin.format-name;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 7px;
                        CheckBox {
                            text: @tr("Load {}", plugin.format-name);
                            checked: plugin.enabled;
                            toggled => { root.plugin-enabled-changed(index, self.checked); }
                        }
                        Text { text: @tr("Search Paths"); color: AppTheme.muted-foreground; }
                        CommitTextEdit {
                            source-text: plugin.paths;
                            preferred-height: 90px;
                            accessible-label: plugin.format-name + ": " + @tr("Search Paths");
                            commit(value) => { root.plugin-paths-changed(index, value); }
                        }
                        Text { text: @tr("Enter one path per line"); color: AppTheme.muted-foreground; }
                    }
                }
            }
        }

        if root.tab-index == 8 : ScrollView {
            vertical-stretch: 1;
            accessible-role: tab-panel;
            accessible-label: @tr("Shortcuts");
            viewport-width: self.visible-width;
            viewport-height: shortcut-page.preferred-height;
            shortcut-page := VerticalLayout {
                spacing: 10px;
                Text { text: @tr("Keyboard Shortcuts"); font-size: 1.2rem; font-weight: 700; }
                Text { text: @tr("Enter shortcuts in a format such as “Ctrl+S” or “Alt+Shift+N”"); color: AppTheme.muted-foreground; wrap: word-wrap; }
                for shortcut[index] in root.shortcut-settings : SystemSettingLineRow {
                    label: root.shortcut-name(shortcut.action-id);
                    value: shortcut.value;
                    placeholder: @tr("Not set");
                    commit(value) => { root.shortcut-value-changed(index, value); }
                }
            }
        }
            }
        }

        Rectangle {
            height: 54px;
            background: AppTheme.panel-background;
            Rectangle { x: 0px; y: 0px; width: 100%; height: 1px; background: AppTheme.subtle-border; }
            HorizontalLayout {
                padding: AppTheme.spacing-sm;
                spacing: AppTheme.spacing-sm;
                Text {
                    text: @tr("Settings are saved with “Apply” or “OK”");
                    color: AppTheme.muted-foreground;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Button { text: @tr("Reload"); clicked => { root.reload-settings(); } }
                Button { text: @tr("Apply"); clicked => { root.apply-settings(); } }
                Button {
                    text: "OK";
                    primary: true;
                    clicked => {
                        if root.apply-settings() {
                            root.close-window();
                        }
                    }
                }
                Button { text: @tr("Close"); clicked => { root.close-window(); } }
            }
        }
    }
}

export component ObjectSettingsWindow inherits Window {
    title: root.has-selection ? @tr("Settings Dialog - ") + root.clip-title : @tr("Settings Dialog");
    forward-focus: object-settings-shortcuts;
    preferred-width: 900px;
    preferred-height: 650px;
    min-width: 680px;
    min-height: 480px;
    in property <bool> has-selection: false;
    in property <string> clip-title: "";
    in property <bool> audio-plugin-mode: false;
    in property <bool> sidebar-on-right: false;
    in property <string> plugin-scan-status: "Audio plugins · scanning…";
    in property <[ObjectEffectData]> effects;
    in property <[ObjectSettingRowData]> setting-rows;
    in property <[EffectCatalogItemData]> effect-catalog-items;
    in property <[string]> font-families;
    in property <int> selected-effect-count: 0;
    in property <bool> selected-effects-removable: false;
    in-out property <bool> effect-picker-visible: false;
    in-out property <string> effect-filter: "";
    in-out property <bool> preset-save-visible: false;
    in-out property <int> preset-effect-index: -1;
    in-out property <string> preset-effect-name: "";
    in-out property <string> preset-name: "";
    in-out property <bool> color-picker-visible: false;
    in-out property <bool> font-picker-visible: false;
    in-out property <int> picker-effect-index: -1;
    in-out property <string> picker-param-name: "";
    in-out property <int> picker-frame: 0;
    in-out property <int> picker-red: 255;
    in-out property <int> picker-green: 255;
    in-out property <int> picker-blue: 255;
    in-out property <int> picker-alpha: 255;
    in-out property <string> font-filter: "";
    in-out property <string> current-font-family: "";
    callback select-effect(int, bool, bool);
    callback context-select-effect(int);
    callback reorder-effect(int, float);
    callback set-effect-enabled(int, bool);
    callback remove-effect(int);
    callback remove-effect-selection(int);
    callback delete-selected-effects();
    callback filter-effects(string);
    callback add-effect(string);
    callback save-effect-preset(int, string);
    callback load-effect-preset(int, string);
    callback delete-effect-preset(int, string);
    callback preset-names(int) -> [string];
    callback set-parameter-text(bool, int, string, int, string);
    callback set-parameter-number(bool, int, string, int, float);
    callback set-parameter-start-number(int, string, int, int, float);
    callback set-parameter-bool(bool, int, string, int, bool);
    callback set-parameter-option(bool, int, string, int, int);
    callback choose-parameter-path(bool, int, string, int, string, string, string);
    callback show-color-picker(bool, int, string, int, string);
    callback apply-picked-color(int, string, int, int, int, int, int);
    callback show-font-picker(bool, int, string, int, string);
    callback filter-fonts(string);
    callback apply-picked-font(int, string, int, string);
    callback seek-effect-frame(int);
    callback snap-effect-frame(float) -> int;
    callback seed-audio-plugin-keyframes(int, string);
    callback add-effect-keyframe(bool, int, string, int);
    callback remove-effect-keyframe(bool, int, string, int);
    callback move-effect-keyframe(bool, int, string, int, int);
    callback open-effect-easing(int, string, int, int);

    object-settings-shortcuts := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if root.has-selection
                && !root.effect-picker-visible
                && !root.preset-save-visible
                && !root.color-picker-visible
                && !root.font-picker-visible
                && event.text == Key.Delete
                && !event.modifiers.alt
                && !event.modifiers.control
                && !event.modifiers.shift
                && !event.modifiers.meta {
                root.delete-selected-effects();
                accept
            } else {
                reject
            }
        }

    if !root.has-selection : VerticalLayout {
        alignment: center;
        Text {
            text: @tr("Select an object on the timeline");
            color: AppTheme.muted-foreground;
            horizontal-alignment: center;
        }
    }

    if root.has-selection : Rectangle {
        sidebar := Rectangle {
            x: root.sidebar-on-right ? parent.width - 250px : 0px;
            width: 250px;
            height: 100%;
            background: AppTheme.panel-background;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                Text { text: root.clip-title; font-weight: 700; color: AppTheme.foreground; overflow: elide; }
                Text {
                    text: root.audio-plugin-mode ? @tr("Audio Plugins") : @tr("Object / Effect");
                    color: AppTheme.muted-foreground;
                }
                ScrollView {
                    vertical-stretch: 1;
                    accessible-role: list;
                    accessible-label: root.audio-plugin-mode ? @tr("Audio Plugins") : @tr("Object / Effect");
                    VerticalLayout {
                        spacing: 2px;
                        for effect in root.effects : EffectSidebarEntry {
                            effect: effect;
                            selected-count: root.selected-effect-count;
                            selected-removable: root.selected-effects-removable;
                            activate(index, control, shift) => { root.select-effect(index, control, shift); }
                            context-activate(index) => { root.context-select-effect(index); }
                            set-enabled(index, enabled) => { root.set-effect-enabled(index, enabled); }
                            remove-selection(index) => { root.remove-effect-selection(index); }
                            reorder(index, delta-y) => { root.reorder-effect(index, delta-y); }
                            save-preset(index, effect-name) => {
                                root.preset-effect-index = index;
                                root.preset-effect-name = effect-name;
                                root.preset-name = "";
                                root.preset-save-visible = true;
                            }
                            load-preset(index, name) => { root.load-effect-preset(index, name); }
                            delete-preset(index, name) => { root.delete-effect-preset(index, name); }
                            query-presets(index) => { root.preset-names(index) }
                        }
                        if root.effects.length == 0 : Text {
                            text: root.audio-plugin-mode
                                ? @tr("No audio plugins")
                                : @tr("No settings available");
                            color: AppTheme.muted-foreground;
                            wrap: word-wrap;
                        }
                    }
                }
                Button {
                    text: root.audio-plugin-mode
                        ? @tr("+ Add Audio Plugin")
                        : @tr("+ Add Effect");
                    clicked => {
                        root.effect-filter = "";
                        root.filter-effects("");
                        root.effect-picker-visible = true;
                    }
                }
            }
        }
        settings-content := ScrollView {
            x: root.sidebar-on-right ? 0px : 250px;
            width: parent.width - 250px;
            height: 100%;
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                Text {
                    text: root.audio-plugin-mode
                        ? @tr("Audio Object / Plugin Settings")
                        : @tr("Selected Object Settings");
                    font-size: 1.15rem;
                    font-weight: 700;
                }
                for row in root.setting-rows : ObjectSettingRow {
                    row-data: row;
                    activate-effect(audio-plugin, index) => {
                        if audio-plugin {
                            root.select-effect(index, false, false);
                        }
                    }
                    set-effect-enabled(audio-plugin, index, enabled) => {
                        if audio-plugin || !root.audio-plugin-mode {
                            root.set-effect-enabled(index, enabled);
                        }
                    }
                    remove-effect(audio-plugin, index) => {
                        if audio-plugin || !root.audio-plugin-mode {
                            root.remove-effect(index);
                        }
                    }
                    set-text(audio-plugin, index, param, frame, value) => {
                        root.set-parameter-text(audio-plugin, index, param, frame, value);
                    }
                    set-number(audio-plugin, index, param, frame, value) => {
                        root.set-parameter-number(audio-plugin, index, param, frame, value);
                    }
                    set-start-number(index, param, start-frame, end-frame, value) => {
                        root.set-parameter-start-number(index, param, start-frame, end-frame, value);
                    }
                    set-bool(audio-plugin, index, param, frame, value) => {
                        root.set-parameter-bool(audio-plugin, index, param, frame, value);
                    }
                    set-option(audio-plugin, index, param, frame, option) => {
                        root.set-parameter-option(audio-plugin, index, param, frame, option);
                    }
                    pick-path(audio-plugin, index, param, frame, value, filter, label) => {
                        root.choose-parameter-path(audio-plugin, index, param, frame, value, filter, label);
                    }
                    pick-color(audio-plugin, index, param, frame, value) => {
                        root.show-color-picker(audio-plugin, index, param, frame, value);
                    }
                    pick-font(audio-plugin, index, param, frame, value) => {
                        root.show-font-picker(audio-plugin, index, param, frame, value);
                    }
                    seek-keyframe(frame) => { root.seek-effect-frame(frame); }
                    snap-keyframe(frame) => { root.snap-effect-frame(frame) }
                    seed-keyframes(audio-plugin, index, param) => {
                        if audio-plugin {
                            root.seed-audio-plugin-keyframes(index, param);
                        }
                    }
                    add-keyframe(audio-plugin, index, param, frame) => {
                        root.add-effect-keyframe(audio-plugin, index, param, frame);
                    }
                    remove-keyframe(audio-plugin, index, param, frame) => {
                        root.remove-effect-keyframe(audio-plugin, index, param, frame);
                    }
                    move-keyframe(audio-plugin, index, param, old-frame, new-frame) => {
                        root.move-effect-keyframe(audio-plugin, index, param, old-frame, new-frame);
                    }
                    open-easing(index, param, start-frame, end-frame) => {
                        root.open-effect-easing(index, param, start-frame, end-frame);
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    if root.effect-picker-visible : Rectangle {
        z: 100;
        background: AppTheme.scrim;
        TouchArea { clicked => { root.effect-picker-visible = false; } }
        picker-panel := Rectangle {
            width: min(parent.width - 48px, 560px);
            height: min(parent.height - 48px, 520px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: AppTheme.raised-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 4px;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: root.audio-plugin-mode
                        ? @tr("Add Audio Plugin")
                        : @tr("Add Filter Effect");
                    font-size: 1.15rem;
                    font-weight: 700;
                }
                LineEdit {
                    text <=> root.effect-filter;
                    placeholder-text: root.audio-plugin-mode
                        ? @tr("Search name, ID, category, or format...")
                        : @tr("Search name, ID, or category...");
                    edited(value) => { root.filter-effects(value); }
                }
                ScrollView {
                    vertical-stretch: 1;
                    accessible-role: list;
                    accessible-label: root.audio-plugin-mode ? @tr("Audio Plugins") : @tr("Effects");
                    VerticalLayout {
                        spacing: 4px;
                        for item in root.effect-catalog-items : Rectangle {
                            height: item.header ? 28px : 34px;
                            if item.header : Text {
                                text: item.name;
                                color: AppTheme.muted-foreground;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            if !item.header : Button {
                                text: item.categories == ""
                                    ? item.name
                                    : item.name + "  [" + item.categories + "]";
                                accessible-description: item.id;
                                clicked => {
                                    root.add-effect(item.id);
                                    root.effect-picker-visible = false;
                                }
                            }
                        }
                        if root.effect-catalog-items.length == 0 : Text {
                            text: root.audio-plugin-mode
                                ? root.plugin-scan-status
                                : @tr("No matching effects");
                            color: AppTheme.muted-foreground;
                        }
                    }
                }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Close"); clicked => { root.effect-picker-visible = false; } }
                }
            }
        }
    }

    if root.preset-save-visible : Rectangle {
        z: 110;
        background: AppTheme.scrim;
        TouchArea { clicked => { root.preset-save-visible = false; } }
        Rectangle {
            width: min(parent.width - 48px, 420px);
            height: 190px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: AppTheme.raised-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 4px;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Text { text: @tr("Save Preset"); font-size: 1.15rem; font-weight: 700; }
                Text { text: root.preset-effect-name; color: AppTheme.muted-foreground; overflow: elide; }
                LineEdit {
                    text <=> root.preset-name;
                    placeholder-text: @tr("Enter preset name...");
                    accepted(value) => {
                        if value != "" {
                            root.save-effect-preset(root.preset-effect-index, value);
                            root.preset-save-visible = false;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Cancel"); clicked => { root.preset-save-visible = false; } }
                    Button {
                        text: @tr("confirm-save" => "Save");
                        enabled: root.preset-name != "";
                        clicked => {
                            root.save-effect-preset(root.preset-effect-index, root.preset-name);
                            root.preset-save-visible = false;
                        }
                    }
                }
            }
        }
    }
    if root.color-picker-visible : Rectangle {
        z: 120;
        background: AppTheme.scrim;
        TouchArea { clicked => { root.color-picker-visible = false; } }
        Rectangle {
            width: min(parent.width - 48px, 460px);
            height: min(parent.height - 48px, 430px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: AppTheme.raised-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 4px;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Text { text: @tr("Select Color"); font-size: 1.15rem; font-weight: 700; }
                Rectangle {
                    height: 72px;
                    background: rgba(
                        root.picker-red,
                        root.picker-green,
                        root.picker-blue,
                        root.picker-alpha / 255
                    );
                    border-width: 1px;
                    border-color: AppTheme.border;
                    border-radius: 4px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "R"; width: 20px; vertical-alignment: center; }
                    Slider {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: 255;
                        value: root.picker-red;
                        changed(value) => { root.picker-red = round(value); }
                    }
                    SpinBox { width: 84px; minimum: 0; maximum: 255; value <=> root.picker-red; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "G"; width: 20px; vertical-alignment: center; }
                    Slider {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: 255;
                        value: root.picker-green;
                        changed(value) => { root.picker-green = round(value); }
                    }
                    SpinBox { width: 84px; minimum: 0; maximum: 255; value <=> root.picker-green; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "B"; width: 20px; vertical-alignment: center; }
                    Slider {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: 255;
                        value: root.picker-blue;
                        changed(value) => { root.picker-blue = round(value); }
                    }
                    SpinBox { width: 84px; minimum: 0; maximum: 255; value <=> root.picker-blue; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "A"; width: 20px; vertical-alignment: center; }
                    Slider {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: 255;
                        value: root.picker-alpha;
                        changed(value) => { root.picker-alpha = round(value); }
                    }
                    SpinBox { width: 84px; minimum: 0; maximum: 255; value <=> root.picker-alpha; }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Cancel"); clicked => { root.color-picker-visible = false; } }
                    Button {
                        text: "OK";
                        primary: true;
                        clicked => {
                            root.apply-picked-color(
                                root.picker-effect-index,
                                root.picker-param-name,
                                root.picker-frame,
                                root.picker-red,
                                root.picker-green,
                                root.picker-blue,
                                root.picker-alpha
                            );
                            root.color-picker-visible = false;
                        }
                    }
                }
            }
        }
    }
    if root.font-picker-visible : Rectangle {
        z: 130;
        background: AppTheme.scrim;
        TouchArea { clicked => { root.font-picker-visible = false; } }
        Rectangle {
            width: min(parent.width - 48px, 540px);
            height: min(parent.height - 48px, 540px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: AppTheme.raised-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 4px;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                Text { text: @tr("Select Font"); font-size: 1.15rem; font-weight: 700; }
                Text {
                    text: root.current-font-family == ""
                        ? @tr("Current: Default")
                        : @tr("Current: ") + root.current-font-family;
                    font-family: root.current-font-family;
                    color: AppTheme.muted-foreground;
                    overflow: elide;
                }
                LineEdit {
                    text <=> root.font-filter;
                    placeholder-text: @tr("Search font names...");
                    edited(value) => { root.filter-fonts(value); }
                }
                Button {
                    text: @tr("Default");
                    checkable: true;
                    checked: root.current-font-family == "";
                    clicked => {
                        root.apply-picked-font(
                            root.picker-effect-index,
                            root.picker-param-name,
                            root.picker-frame,
                            ""
                        );
                        root.font-picker-visible = false;
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    accessible-role: list;
                    accessible-label: @tr("Select Font");
                    VerticalLayout {
                        spacing: 4px;
                        for family in root.font-families : HorizontalLayout {
                            spacing: 6px;
                            Button {
                                width: 190px;
                                text: family;
                                checkable: true;
                                checked: family == root.current-font-family;
                                accessible-label: family;
                                clicked => {
                                    root.apply-picked-font(
                                        root.picker-effect-index,
                                        root.picker-param-name,
                                        root.picker-frame,
                                        family
                                    );
                                    root.font-picker-visible = false;
                                }
                            }
                            Text {
                                text: @tr("Sample 123");
                                font-family: family;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                        }
                        if root.font-families.length == 0 : Text {
                            text: @tr("No matching fonts");
                            color: AppTheme.muted-foreground;
                        }
                    }
                }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Close"); clicked => { root.font-picker-visible = false; } }
                }
            }
        }
    }
    }
}

export component EasingConfigWindow inherits Window {
    title: @tr("Interpolation Settings: ") + root.param-name;
    preferred-width: 880px;
    preferred-height: 560px;
    min-width: 760px;
    min-height: 460px;
    in-out property <bool> initializing: false;
    in-out property <int> effect-index: -1;
    in-out property <string> param-name: "";
    in-out property <int> keyframe-frame: 0;
    in property <[string]> easing-names;
    in property <[string]> easing-labels;
    in property <[EasingCatalogRowData]> easing-catalog-rows;
    in-out property <string> easing-filter: "";
    in-out property <int> selected-easing-index: 0;
    in-out property <int> step-frames: 1;
    in-out property <float> elastic-amplitude: 1;
    in-out property <float> elastic-period: 0.3;
    in-out property <float> custom-x1: 0.33;
    in-out property <float> custom-y1: 0;
    in-out property <float> custom-x2: 0.66;
    in-out property <float> custom-y2: 1;
    in property <string> preview-path: "M 0 1 L 1 0";
    in property <string> tangent-path: "M 0 1 L 0.33 1 M 1 0 L 0.66 0";
    in property <[CurveHandleData]> curve-handles;
    in-out property <float> preview-scale: 1;
    in-out property <float> preview-offset-x: 0;
    in-out property <float> preview-offset-y: 0;
    private property <int> drag-point-index: -1;
    private property <bool> pan-active: false;
    private property <bool> pan-moved: false;
    private property <length> pan-start-x: 0px;
    private property <length> pan-start-y: 0px;
    private property <length> pan-last-x: 0px;
    private property <length> pan-last-y: 0px;
    private property <string> selected-easing: root.selected-easing-index >= 0
        && root.selected-easing-index < root.easing-names.length
        ? root.easing-names[root.selected-easing-index]
        : "none";
    private property <bool> step-mode: root.selected-easing == "random"
        || root.selected-easing == "alternate";
    private property <bool> elastic-mode: root.selected-easing == "ease_in_elastic"
        || root.selected-easing == "ease_out_elastic"
        || root.selected-easing == "ease_in_out_elastic"
        || root.selected-easing == "ease_out_in_elastic";
    private property <bool> custom-mode: root.selected-easing == "custom";
    callback apply-easing(string, int, float, float, float, float, float, float);
    callback custom-point-edited(int, string);
    callback hit-custom-point(float, float, float, float) -> int;
    callback insert-custom-anchor(float, float);
    callback move-custom-point(int, float, float);
    callback remove-custom-anchor(int);
    callback filter-easings(string);
    callback close-window();

    function preview-viewbox-x() -> float {
        return 0.5 - 0.5 / root.preview-scale + root.preview-offset-x;
    }

    function preview-viewbox-y() -> float {
        return 0.5 - 0.5 / root.preview-scale + root.preview-offset-y;
    }

    function preview-logical-x(pixel-x: length) -> float {
        return root.preview-viewbox-x() + pixel-x / preview-area.width / root.preview-scale;
    }

    function preview-logical-y(pixel-y: length) -> float {
        return 1 - (root.preview-viewbox-y() + pixel-y / preview-area.height / root.preview-scale);
    }

    function preview-pixel-x(logical-x: float) -> length {
        return (logical-x - root.preview-viewbox-x()) * root.preview-scale * preview-area.width;
    }

    function preview-pixel-y(logical-y: float) -> length {
        return (1 - logical-y - root.preview-viewbox-y()) * root.preview-scale * preview-area.height;
    }

    function apply-current() {
        if !root.initializing && root.effect-index >= 0 && root.param-name != "" {
            root.apply-easing(
                root.selected-easing,
                max(root.step-frames, 1),
                root.elastic-amplitude,
                root.elastic-period,
                root.custom-x1,
                root.custom-y1,
                root.custom-x2,
                root.custom-y2
            );
        }
    }

    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        VerticalLayout {
        spacing: 10px;
        Text {
            text: @tr("Frame {}  ·  {}", root.keyframe-frame, root.param-name);
            font-size: 1.15rem;
            font-weight: 700;
        }
        HorizontalLayout {
            spacing: 6px;
            Text { text: @tr("Preview"); font-weight: 700; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: @tr("Zoom:"); vertical-alignment: center; }
            Button {
                text: "−";
                width: 30px;
                clicked => { root.preview-scale = max(0.25, root.preview-scale / 1.4); }
            }
            Text {
                text: "\{round(root.preview-scale * 100)}%";
                width: 48px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Button {
                text: "+";
                width: 30px;
                clicked => { root.preview-scale = min(4, root.preview-scale * 1.4); }
            }
            Button {
                text: "1:1";
                clicked => {
                    root.preview-scale = 1;
                    root.preview-offset-x = 0;
                    root.preview-offset-y = 0;
                }
            }
        }
        preview-area := Rectangle {
            height: 230px;
            horizontal-stretch: 1;
            background: AppTheme.window-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 4px;
            clip: true;

            Path {
                width: 100%;
                height: 100%;
                viewbox-x: root.preview-viewbox-x();
                viewbox-y: root.preview-viewbox-y();
                viewbox-width: 1 / root.preview-scale;
                viewbox-height: 1 / root.preview-scale;
                fit: fill;
                commands: "M 0 0 L 0 1 M 0.25 0 L 0.25 1 M 0.5 0 L 0.5 1 M 0.75 0 L 0.75 1 M 1 0 L 1 1 M 0 0 L 1 0 M 0 0.25 L 1 0.25 M 0 0.5 L 1 0.5 M 0 0.75 L 1 0.75 M 0 1 L 1 1";
                stroke: AppTheme.border;
                stroke-width: 1px;
                clip: true;
            }
            Path {
                width: 100%;
                height: 100%;
                viewbox-x: root.preview-viewbox-x();
                viewbox-y: root.preview-viewbox-y();
                viewbox-width: 1 / root.preview-scale;
                viewbox-height: 1 / root.preview-scale;
                fit: fill;
                commands: "M 0 1 L 1 0";
                stroke: AppTheme.border;
                stroke-width: 1px;
                clip: true;
            }
            if root.custom-mode : Path {
                width: 100%;
                height: 100%;
                viewbox-x: root.preview-viewbox-x();
                viewbox-y: root.preview-viewbox-y();
                viewbox-width: 1 / root.preview-scale;
                viewbox-height: 1 / root.preview-scale;
                fit: fill;
                commands: root.tangent-path;
                stroke: AppTheme.muted-foreground;
                stroke-width: 1px;
                clip: true;
            }
            Path {
                width: 100%;
                height: 100%;
                viewbox-x: root.preview-viewbox-x();
                viewbox-y: root.preview-viewbox-y();
                viewbox-width: 1 / root.preview-scale;
                viewbox-height: 1 / root.preview-scale;
                fit: fill;
                commands: root.preview-path;
                stroke: AppTheme.accent;
                stroke-width: 2px;
                clip: true;
            }
            for handle in root.curve-handles : Rectangle {
                width: handle.anchor ? 12px : 10px;
                height: self.width;
                x: root.preview-pixel-x(handle.x) - self.width / 2;
                y: root.preview-pixel-y(handle.y) - self.height / 2;
                visible: root.custom-mode && (!handle.anchor || handle.removable);
                background: handle.anchor ? AppTheme.accent : AppTheme.foreground;
                border-radius: self.width / 2;
                border-width: handle.removable ? 2px : 1px;
                border-color: handle.removable ? AppTheme.warning : AppTheme.border;
            }
            preview-input := TouchArea {
                mouse-cursor: root.pan-active || root.drag-point-index >= 0 ? move : pointer;
                double-clicked => {
                    if root.custom-mode {
                        root.insert-custom-anchor(
                            root.preview-logical-x(self.mouse-x),
                            root.preview-logical-y(self.mouse-y)
                        );
                    }
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        root.drag-point-index = -1;
                        root.pan-active = true;
                        root.pan-moved = false;
                        root.pan-start-x = self.mouse-x;
                        root.pan-start-y = self.mouse-y;
                        root.pan-last-x = self.mouse-x;
                        root.pan-last-y = self.mouse-y;
                    }
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left && root.custom-mode {
                        root.pan-active = false;
                        root.drag-point-index = root.hit-custom-point(
                            root.preview-logical-x(self.mouse-x),
                            root.preview-logical-y(self.mouse-y),
                            12px / preview-area.width / root.preview-scale,
                            12px / preview-area.height / root.preview-scale
                        );
                    }
                    if event.kind == PointerEventKind.move && root.pan-active {
                        let delta-x = self.mouse-x - root.pan-last-x;
                        let delta-y = self.mouse-y - root.pan-last-y;
                        if abs(self.mouse-x - root.pan-start-x) >= 3px
                            || abs(self.mouse-y - root.pan-start-y) >= 3px {
                            root.pan-moved = true;
                        }
                        root.preview-offset-x -= delta-x / preview-area.width / root.preview-scale;
                        root.preview-offset-y -= delta-y / preview-area.height / root.preview-scale;
                        root.pan-last-x = self.mouse-x;
                        root.pan-last-y = self.mouse-y;
                    }
                    if event.kind == PointerEventKind.move && root.drag-point-index >= 0 {
                        root.move-custom-point(
                            root.drag-point-index,
                            root.preview-logical-x(self.mouse-x),
                            root.preview-logical-y(self.mouse-y)
                        );
                    }
                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                        root.drag-point-index = -1;
                    }
                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.right && root.pan-active {
                        if !root.pan-moved && root.custom-mode {
                            let hit = root.hit-custom-point(
                                root.preview-logical-x(self.mouse-x),
                                root.preview-logical-y(self.mouse-y),
                                12px / preview-area.width / root.preview-scale,
                                12px / preview-area.height / root.preview-scale
                            );
                            if hit >= 0 {
                                root.remove-custom-anchor(hit);
                            }
                        }
                        root.pan-active = false;
                    }
                    if event.kind == PointerEventKind.cancel {
                        root.drag-point-index = -1;
                        root.pan-active = false;
                        root.pan-moved = false;
                    }
                }
                scroll-event(event) => {
                    if event.delta-y > 0px {
                        root.preview-scale = min(4, root.preview-scale * 1.2);
                        accept
                    } else if event.delta-y < 0px {
                        root.preview-scale = max(0.25, root.preview-scale / 1.2);
                        accept
                    } else {
                        reject
                    }
                }
            }
            Text {
                x: 6px;
                y: parent.height - self.height - 4px;
                text: root.custom-mode
                    ? @tr("Right drag: pan  Wheel: zoom  Left drag: handle  Double-click: add  Right-click: delete")
                    : @tr("Right drag: Pan  Wheel: Zoom");
                font-size: 9px;
                color: AppTheme.muted-foreground;
            }
        }
        if root.step-mode : GroupBox {
            title: @tr("Update interval");
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                SpinBox {
                    value <=> root.step-frames;
                    minimum: 1;
                    maximum: 9999;
                    changed value => { root.apply-current(); }
                }
                Text { text: @tr("Frame"); vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        if root.elastic-mode : GroupBox {
            title: @tr("Advanced Settings");
            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                HorizontalLayout {
                    Text { text: @tr("Amplitude"); width: 60px; vertical-alignment: center; }
                    Slider {
                        horizontal-stretch: 1;
                        minimum: 0.1;
                        maximum: 5;
                        value <=> root.elastic-amplitude;
                        changed(value) => { root.apply-current(); }
                    }
                    Text { text: "\{round(root.elastic-amplitude * 100) / 100}"; width: 52px; }
                }
                HorizontalLayout {
                    Text { text: @tr("Period"); width: 60px; vertical-alignment: center; }
                    Slider {
                        horizontal-stretch: 1;
                        minimum: 0.05;
                        maximum: 1;
                        value <=> root.elastic-period;
                        changed(value) => { root.apply-current(); }
                    }
                    Text { text: "\{round(root.elastic-period * 100) / 100}"; width: 52px; }
                }
            }
        }
        if root.custom-mode : GroupBox {
            title: @tr("Control Point");
            GridLayout {
                padding: 8px;
                spacing: 8px;
                Row {
                    Text { text: "CP1 X"; vertical-alignment: center; }
                    CommitLineEdit {
                        width: 100px;
                        source-text: "\{root.custom-x1}";
                        commit(value) => { root.custom-point-edited(0, value); }
                    }
                    Text { text: "CP1 Y"; vertical-alignment: center; }
                    CommitLineEdit {
                        width: 100px;
                        source-text: "\{root.custom-y1}";
                        commit(value) => { root.custom-point-edited(1, value); }
                    }
                }
                Row {
                    Text { text: "CP2 X"; vertical-alignment: center; }
                    CommitLineEdit {
                        width: 100px;
                        source-text: "\{root.custom-x2}";
                        commit(value) => { root.custom-point-edited(2, value); }
                    }
                    Text { text: "CP2 Y"; vertical-alignment: center; }
                    CommitLineEdit {
                        width: 100px;
                        source-text: "\{root.custom-y2}";
                        commit(value) => { root.custom-point-edited(3, value); }
                    }
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
        Text {
            text: @tr("The selection is applied to the target keyframe immediately");
            color: AppTheme.muted-foreground;
        }
        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Close"); clicked => { root.close-window(); } }
        }
        }
        Rectangle {
            width: 280px;
            background: AppTheme.panel-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 4px;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                HorizontalLayout {
                    Text {
                        text: @tr("Type");
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.selected-easing-index >= 0
                            && root.selected-easing-index < root.easing-labels.length
                            ? root.easing-labels[root.selected-easing-index]
                            : "";
                        color: AppTheme.muted-foreground;
                        overflow: elide;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                LineEdit {
                    text <=> root.easing-filter;
                    placeholder-text: @tr("Search...");
                    edited(value) => { root.filter-easings(value); }
                }
                ScrollView {
                    vertical-stretch: 1;
                    accessible-role: list;
                    accessible-label: @tr("Interpolation");
                    VerticalLayout {
                        spacing: 3px;
                        for item in root.easing-catalog-rows : Rectangle {
                            height: item.header ? 28px : 52px;
                            background: item.header
                                ? transparent
                                : item.easing-index == root.selected-easing-index
                                    ? AppTheme.selection-background
                                    : catalog-touch.has-hover ? AppTheme.hover-background : AppTheme.raised-background;
                            border-width: item.header ? 0px : 1px;
                            border-color: item.easing-index == root.selected-easing-index ? AppTheme.accent : AppTheme.subtle-border;
                            border-radius: item.header ? 0px : AppTheme.control-radius;
                            animate background { duration: 120ms; }
                            if item.header : Text {
                                text: item.label;
                                color: AppTheme.muted-foreground;
                                font-size: 0.9rem;
                                font-weight: 700;
                                vertical-alignment: bottom;
                            }
                            if !item.header : HorizontalLayout {
                                padding: 5px;
                                spacing: 8px;
                                Rectangle {
                                    width: 72px;
                                    background: item.easing-index == root.selected-easing-index ? AppTheme.selection-background : AppTheme.window-background;
                                    border-width: 1px;
                                    border-color: AppTheme.border;
                                    Path {
                                        x: 4px;
                                        y: 4px;
                                        width: parent.width - 8px;
                                        height: parent.height - 8px;
                                        viewbox-x: 0;
                                        viewbox-y: -0.3;
                                        viewbox-width: 1;
                                        viewbox-height: 1.6;
                                        fit: fill;
                                        commands: item.preview-path;
                                        stroke: item.easing-index == root.selected-easing-index ? AppTheme.foreground : AppTheme.accent;
                                        stroke-width: 1.5px;
                                        clip: true;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: item.label;
                                        color: AppTheme.foreground;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: item.name;
                                        color: AppTheme.muted-foreground;
                                        font-size: 0.8rem;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            catalog-touch := TouchArea {
                                enabled: !item.header;
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: item.label;
                                accessible-description: item.name;
                                accessible-action-default => {
                                    root.selected-easing-index = item.easing-index;
                                    root.apply-current();
                                }
                                clicked => {
                                    root.selected-easing-index = item.easing-index;
                                    root.apply-current();
                                }
                            }
                        }
                        if root.easing-catalog-rows.length == 0 : Text {
                            text: @tr("No matching interpolation methods");
                            color: AppTheme.muted-foreground;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

component PackageListRow inherits Rectangle {
    in property <PackageData> package-data;
    in property <bool> busy;
    in property <bool> show-install-button;
    callback install(string, string);
    callback remove(string);
    callback permissions(string, string);

    height: max(content.preferred-height + 20px, 86px);
    background: AppTheme.panel-background;
    border-width: 1px;
    border-color: AppTheme.subtle-border;
    border-radius: AppTheme.surface-radius;
    content := VerticalLayout {
        padding: AppTheme.spacing-md;
        spacing: AppTheme.spacing-xs;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.package-data.display-name == ""
                    ? root.package-data.id
                    : root.package-data.display-name;
                color: AppTheme.foreground;
                font-size: 1rem;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.package-data.version == ""
                    ? root.package-data.latest-version
                    : root.package-data.version;
                color: AppTheme.muted-foreground;
                font-size: 0.75rem;
                vertical-alignment: center;
            }
        }
        if root.package-data.description != "" : Text {
            text: root.package-data.description;
            color: AppTheme.muted-foreground;
            font-size: 0.85rem;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.package-data.author == "" ? "" : "Author: " + root.package-data.author;
                color: AppTheme.muted-foreground;
                font-size: 0.78rem;
                visible: root.package-data.author != "";
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Text {
                text: root.package-data.has-update
                    ? @tr("Update available: ") + root.package-data.latest-version
                    : @tr("Installed: ") + root.package-data.installed-version;
                color: root.package-data.has-update ? AppTheme.accent : AppTheme.muted-foreground;
                font-size: 0.78rem;
                visible: root.package-data.installed-version != "";
                vertical-alignment: center;
            }
            Button {
                text: @tr("Permissions");
                visible: root.package-data.can-manage-permissions;
                enabled: !root.busy;
                clicked => { root.permissions(root.package-data.id, root.package-data.display-name); }
            }
            Button {
                text: @tr("Delete");
                visible: root.package-data.can-remove;
                enabled: !root.busy;
                clicked => { root.remove(root.package-data.id); }
            }
            Button {
                text: root.package-data.has-update ? @tr("Update") : @tr("Install");
                primary: true;
                visible: root.show-install-button
                    && (!root.package-data.can-remove || root.package-data.has-update)
                    && root.package-data.latest-version != "";
                enabled: !root.busy;
                clicked => {
                    root.install(root.package-data.id, root.package-data.source-repository);
                }
            }
        }
    }
}

export component PackageManagerWindow inherits Window {
    title: @tr("Package Manager");
    preferred-width: 760px;
    preferred-height: 520px;
    min-width: 660px;
    min-height: 450px;
    background: AppTheme.window-background;

    in-out property <int> tab-index: 0;
    in-out property <string> search-query;
    in-out property <string> repository-url;
    in property <[PackageData]> packages;
    in property <[PackageRepositoryData]> repositories;
    in property <bool> busy;
    in property <bool> has-updates;
    in property <float> progress;
    in property <string> status-text: "Idle";
    in property <string> error-message;
    in property <string> update-message;

    callback select-tab(int);
    callback filter-packages(string);
    callback sync-repositories();
    callback add-repository(string);
    callback set-repository-enabled(string, bool);
    callback remove-repository(string);
    callback upgrade-all();
    callback install-package(string, string);
    callback remove-package(string);
    callback show-permissions(string, string);
    callback dismiss-error();
    callback dismiss-update();

    VerticalLayout {
        padding: AppTheme.spacing-lg;
        spacing: AppTheme.spacing-md;
        HorizontalLayout {
            spacing: AppTheme.spacing-xs;
            for tab[index] in [@tr("Effects"), @tr("Objects"), "MOD", @tr("Installed"), @tr("Application"), @tr("Repositories")] : Button {
                text: tab;
                min-width: 0px;
                horizontal-stretch: 1;
                primary: root.tab-index == index;
                clicked => {
                    root.tab-index = index;
                    root.search-query = "";
                    root.select-tab(index);
                }
            }
        }
        if root.tab-index < 5 : HorizontalLayout {
            spacing: AppTheme.spacing-sm;
            LineEdit {
                text <=> root.search-query;
                placeholder-text: @tr("Search...");
                horizontal-stretch: 1;
                edited(value) => { root.filter-packages(value); }
            }
            Button {
                text: @tr("Sync Repository");
                visible: root.tab-index < 3;
                enabled: !root.busy;
                clicked => { root.sync-repositories(); }
            }
        }
        if root.tab-index < 5 : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: AppTheme.spacing-sm;
                for package in root.packages : PackageListRow {
                    package-data: package;
                    busy: root.busy;
                    show-install-button: root.tab-index < 3;
                    install(id, repository) => { root.install-package(id, repository); }
                    remove(id) => { root.remove-package(id); }
                    permissions(id, name) => { root.show-permissions(id, name); }
                }
                if root.packages.length == 0 && !root.busy : Text {
                    text: @tr("No packages in this category.");
                    color: AppTheme.muted-foreground;
                    horizontal-alignment: center;
                }
            }
        }
        if root.tab-index == 5 : VerticalLayout {
            spacing: 12px;
            GroupBox {
                title: @tr("Add Repository");
                height: 72px;
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> root.repository-url;
                        placeholder-text: "https://example.com/repo.json";
                        horizontal-stretch: 1;
                        accepted(value) => {
                            if value != "" { root.add-repository(value); }
                        }
                    }
                    Button {
                        text: @tr("Add");
                        enabled: root.repository-url != "" && !root.busy;
                        clicked => { root.add-repository(root.repository-url); }
                    }
                }
            }
            GroupBox {
                title: @tr("Configured Repositories");
                vertical-stretch: 1;
                ScrollView {
                    VerticalLayout {
                        spacing: 5px;
                        for repository in root.repositories : Rectangle {
                            height: 48px;
                            background: AppTheme.panel-background;
                            border-width: 1px;
                            border-color: AppTheme.subtle-border;
                            border-radius: AppTheme.control-radius;
                            HorizontalLayout {
                                padding: 6px;
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: repository.name == "" ? repository.url : repository.name;
                                        color: AppTheme.foreground;
                                        font-size: 13px;
                                        font-weight: 700;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: repository.url;
                                        color: AppTheme.muted-foreground;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                                CheckBox {
                                    text: @tr("Enabled");
                                    checked: repository.enabled;
                                    enabled: !root.busy;
                                    toggled => {
                                        root.set-repository-enabled(repository.url, self.checked);
                                    }
                                }
                                Button {
                                    text: @tr("Delete");
                                    enabled: !root.busy;
                                    clicked => { root.remove-repository(repository.url); }
                                }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: @tr("Sync Repository");
                    enabled: !root.busy;
                    clicked => { root.sync-repositories(); }
                }
                Button {
                    text: @tr("Upgrade All");
                    primary: true;
                    enabled: !root.busy && root.has-updates;
                    clicked => { root.upgrade-all(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        if root.busy : ProgressIndicator {
            progress: root.progress;
            indeterminate: root.progress <= 0;
        }
        Text {
            text: root.status-text;
            color: AppTheme.muted-foreground;
            font-size: 11px;
            overflow: elide;
        }
    }

    if root.error-message != "" : Rectangle {
        background: AppTheme.scrim;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: min(460px, root.width - 40px);
                    height: error-content.preferred-height + 28px;
                    background: AppTheme.panel-background;
                    border-width: 1px;
                    border-color: AppTheme.danger;
                    border-radius: 6px;
                    error-content := VerticalLayout {
                        padding: 14px;
                        spacing: 12px;
                        Text { text: @tr("Package Manager Error"); color: AppTheme.foreground; font-weight: 700; }
                        Text { text: root.error-message; color: AppTheme.muted-foreground; wrap: word-wrap; }
                        HorizontalLayout {
                            alignment: end;
                            Button { text: "OK"; primary: true; clicked => { root.dismiss-error(); } }
                        }
                    }
                }
            }
        }
    }

    if root.update-message != "" : Rectangle {
        background: AppTheme.scrim;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: min(480px, root.width - 40px);
                    height: update-content.preferred-height + 28px;
                    background: AppTheme.panel-background;
                    border-width: 1px;
                    border-color: AppTheme.accent;
                    border-radius: 6px;
                    update-content := VerticalLayout {
                        padding: 14px;
                        spacing: 12px;
                        Text { text: @tr("AviQtl Plus Update"); color: AppTheme.foreground; font-weight: 700; }
                        Text { text: root.update-message; color: AppTheme.muted-foreground; wrap: word-wrap; }
                        HorizontalLayout {
                            alignment: end;
                            Button { text: "OK"; primary: true; clicked => { root.dismiss-update(); } }
                        }
                    }
                }
            }
        }
    }
}

export component PluginPermissionWindow inherits Window {
    title: @tr("Permissions: ") + root.plugin-name;
    preferred-width: 500px;
    preferred-height: 600px;
    min-width: 420px;
    min-height: 420px;
    background: AppTheme.window-background;

    in property <string> plugin-id;
    in property <string> plugin-name;
    in property <[PluginPermissionData]> permissions;

    callback toggle-permission(int, bool);
    callback set-all(bool);
    callback accept();
    callback close-window();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text {
            text: @tr("Select the permissions to grant to this plugin:");
            color: AppTheme.foreground;
            wrap: word-wrap;
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 4px;
                for permission[index] in root.permissions : Rectangle {
                    height: 60px;
                    background: permission-touch.has-hover ? AppTheme.hover-background : AppTheme.panel-background;
                    border-width: 1px;
                    border-color: AppTheme.subtle-border;
                    border-radius: AppTheme.control-radius;
                    animate background { duration: 120ms; }
                    permission-touch := TouchArea {
                        enabled: true;
                        mouse-cursor: pointer;
                        accessible-role: checkbox;
                        accessible-label: permission.title;
                        accessible-description: permission.description;
                        accessible-checked: permission.granted;
                        accessible-action-default => {
                            root.toggle-permission(index, !permission.granted);
                        }
                        clicked => {
                            root.toggle-permission(index, !permission.granted);
                        }
                    }
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 12px;
                        CheckBox {
                            checked: permission.granted;
                            toggled => {
                                root.toggle-permission(index, self.checked);
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: permission.title == "" ? permission.name : permission.title;
                                color: AppTheme.foreground;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: permission.description == "" ? permission.name : permission.description;
                                color: AppTheme.muted-foreground;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Button { text: @tr("Allow All"); clicked => { root.set-all(true); } }
            Button { text: @tr("Deny All"); clicked => { root.set-all(false); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Cancel"); clicked => { root.close-window(); } }
            Button { text: "OK"; primary: true; clicked => { root.accept(); } }
        }
    }
}

export component AboutWindow inherits Window {
    title: @tr("About AviQtl Plus");
    preferred-width: 420px;
    preferred-height: 260px;
    min-width: 420px;
    max-width: 420px;
    min-height: 260px;
    max-height: 260px;
    background: AppTheme.window-background;

    in property <string> version;
    in property <string> codename: "Rolling Release";
    callback open-project-page();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 20px;
            Image {
                source: @image-url("../../../assets/icon.svg");
                width: 64px;
                height: 64px;
                image-fit: contain;
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: "AviQtl Plus " + root.version;
                    color: AppTheme.foreground;
                    font-size: 28px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.codename;
                    color: AppTheme.accent;
                    font-size: 14px;
                    font-weight: 700;
                }
            }
        }
        Rectangle { height: 1px; background: AppTheme.border; }
        Text {
            text: @tr("AviQtl Plus is not AviUtl.\n\nThis software is released under the GNU Affero General Public License Version 3.");
            color: AppTheme.muted-foreground;
            font-size: 13px;
            wrap: word-wrap;
        }
        Rectangle {
            height: 24px;
            link-text := Text {
                text: "https://codeberg.org/taisho-guy/AviQtl";
                color: AppTheme.accent;
                font-size: 13px;
                vertical-alignment: center;
            }
            link-touch := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: @tr("AviQtl Plus project page");
                accessible-description: link-text.text;
                accessible-action-default => { root.open-project-page(); }
                clicked => { root.open-project-page(); }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}
